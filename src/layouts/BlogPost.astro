---
import BaseLayout from './BaseLayout.astro';
import Divider from '../components/Divider.astro';
import CTASection from '../components/CTASection.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PageHero from '../components/PageHero.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  tags?: string[];
  slug?: string;
}

const { title, description, pubDate, updatedDate, author = 'Byte Digital', category, tags = [], slug } = Astro.props;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-NZ', { year: 'numeric', month: 'long', day: 'numeric' });
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "author": { "@type": "Organization", "name": author },
  "publisher": { "@type": "Organization", "name": "Byte Digital", "url": "https://bytedigital.co.nz" },
  "datePublished": pubDate.toISOString(),
  "dateModified": (updatedDate || pubDate).toISOString(),
  "mainEntityOfPage": { "@type": "WebPage", "@id": Astro.url.href },
};

import { getCollection } from 'astro:content';
import { getRelatedPosts, allServices } from '../utils/content-relations';

const allBlogPosts = (await getCollection('blog')).map(p => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  pubDate: p.data.pubDate,
})).sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const relatedPosts = slug
  ? allBlogPosts
      .filter(p => p.slug !== slug && p.category === category)
      .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
      .slice(0, 3)
  : allBlogPosts.slice(0, 3);
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={jsonLd}>
  <PageHero
    title={title}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Blog', href: '/blog' },
      { label: title },
    ]}
  >
    {category && (
      <span style="display:inline-block;padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--secondary);background:rgba(94,234,212,0.08);border:1px solid rgba(94,234,212,0.2);margin-bottom:16px;position:relative;z-index:1">{category}</span>
    )}
    <div style="display:flex;align-items:center;gap:16px;font-size:14px;color:var(--text-dimmed);position:relative;z-index:1;margin-top:8px">
      <span>By {author}</span>
      <span style="color:var(--border-medium)">·</span>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <><span style="color:var(--border-medium)">·</span><span>Updated {formatDate(updatedDate)}</span></>}
    </div>
  </PageHero>
  <Divider />
  <article class="section">
    <div class="container">
      <div class="dm-header" style="margin-bottom:48px">
        <slot />
      </div>
    </div>
  </article>
  {relatedPosts.length > 0 && (
    <RelatedPosts posts={relatedPosts} />
  )}
  <Divider />
  <CTASection />
</BaseLayout>
