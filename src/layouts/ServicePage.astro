---
import BaseLayout from './BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTASection from '../components/CTASection.astro';
import Divider from '../components/Divider.astro';

export interface Props {
  title: string;
  description: string;
  serviceTitle: string;
  serviceSubtitle: string;
  ogType?: string;
  jsonLd?: object;
}

const { title, description, serviceTitle, serviceSubtitle, ogType = 'website', jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} ogType={ogType} jsonLd={jsonLd}>
  <section style="padding-top:120px;padding-bottom:60px;position:relative">
    <div class="container">
      <nav style="margin-bottom:24px;font-size:13px;color:var(--text-muted)">
        <a href="/" style="color:var(--text-muted);transition:color 0.2s">Home</a>
        <span style="margin:0 8px">/</span>
        <a href="/services/web-design" style="color:var(--text-muted);transition:color 0.2s">Services</a>
        <span style="margin:0 8px">/</span>
        <span style="color:var(--secondary)">{serviceTitle}</span>
      </nav>
      <div class="section-label">Our Services</div>
      <h1 class="section-title" style="max-width:800px">{serviceTitle}</h1>
      <p class="section-subtitle" style="margin-top:12px">{serviceSubtitle}</p>
    </div>
  </section>
  <slot />
  <slot name="related-case-studies" />
  <slot name="related-posts" />
  <slot name="related-guides" />
  <slot name="related-services" />
  <Divider />
  <slot name="faq" />
  <CTASection />
</BaseLayout>
