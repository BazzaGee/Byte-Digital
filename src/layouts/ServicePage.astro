---
import BaseLayout from './BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTASection from '../components/CTASection.astro';
import Divider from '../components/Divider.astro';
import DMDivider from '../components/DMDivider.astro';
import PageHero from '../components/PageHero.astro';

export interface Props {
  title: string;
  description: string;
  serviceTitle: string;
  serviceSubtitle: string;
  ogType?: string;
  jsonLd?: object;
}

const { title, description, serviceTitle, serviceSubtitle, ogType = 'website', jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} ogType={ogType} jsonLd={jsonLd}>
  <PageHero
    label="Our Services"
    title={serviceTitle}
    subtitle={serviceSubtitle}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services/web-design' },
      { label: serviceTitle },
    ]}
  />
  <slot />
  <slot name="related-case-studies" />
  <slot name="related-posts" />
  <slot name="related-guides" />
  <slot name="related-services" />
  <DMDivider id="dm-service-faq" />
  <slot name="faq" />
  <CTASection />
</BaseLayout>
