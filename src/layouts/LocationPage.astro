---
import BaseLayout from './BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTASection from '../components/CTASection.astro';
import Divider from '../components/Divider.astro';
import PageHero from '../components/PageHero.astro';
import SectionAccent from '../components/SectionAccent.astro';

export interface Props {
  title: string;
  description: string;
  suburb: string;
  jsonLd?: object;
}

const { title, description, suburb, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <PageHero
    label="Christchurch Locations"
    title={`Web Design & Digital Marketing in ${suburb}`}
    subtitle={`Byte Digital provides premium web design, SEO, and digital marketing services to businesses in ${suburb}, Christchurch. We help local businesses dominate online search and convert more visitors into customers.`}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: `Web Design ${suburb}` },
    ]}
  />
  <slot />
  <SectionAccent wide />
  <section class="section reveal section-glow" style="background:var(--bg-dark);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)">
    <div class="glow-orb purple bottom-left"></div>
    <div class="glow-orb mint top-right"></div>
    <div class="container" style="padding:64px 0;position:relative;z-index:1">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin-bottom:32px">
        <div>
          <h2 style="font-size:24px;font-weight:600;margin:0;font-family:'Space Grotesk',sans-serif">Also Serving Nearby Areas</h2>
          <p style="color:var(--text-muted);margin:6px 0 0;font-size:15px">We provide web design and SEO services across Christchurch and Canterbury.</p>
        </div>
        <a href="/locations" class="btn-cta" style="text-decoration:none;padding:10px 24px;font-size:14px">All Service Areas</a>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        <a href="/locations/addington" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Addington</a>
        <a href="/locations/cashmere" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Cashmere</a>
        <a href="/locations/fendalton" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Fendalton</a>
        <a href="/locations/ferrymead" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Ferrymead</a>
        <a href="/locations/halswell" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Halswell</a>
        <a href="/locations/linwood" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Linwood</a>
        <a href="/locations/merivale" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Merivale</a>
        <a href="/locations/mount-pleasant" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Mount Pleasant</a>
        <a href="/locations/new-brighton" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">New Brighton</a>
        <a href="/locations/papanui" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Papanui</a>
        <a href="/locations/redcliffs" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Redcliffs</a>
        <a href="/locations/riccarton" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Riccarton</a>
        <a href="/locations/richmond" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Richmond</a>
        <a href="/locations/somerfield" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Somerfield</a>
        <a href="/locations/spreydon" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Spreydon</a>
        <a href="/locations/st-albans" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">St Albans</a>
        <a href="/locations/sumner" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Sumner</a>
        <a href="/locations/sydenham" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Sydenham</a>
        <a href="/locations/wigram" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Wigram</a>
        <a href="/locations/woolston" style="padding:8px 16px;border-radius:8px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:13px;transition:border-color 0.2s">Woolston</a>
      </div>
    </div>
  </section>
  <Divider />
  <CTASection />
</BaseLayout>
