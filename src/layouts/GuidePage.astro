---
import BaseLayout from './BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import Divider from '../components/Divider.astro';

export interface Props {
  title: string;
  description: string;
  jsonLd?: object;
}

const { title, description, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section style="padding-top:120px;padding-bottom:60px">
    <div class="container">
      <nav style="margin-bottom:24px;font-size:13px;color:var(--text-muted)">
        <a href="/" style="color:var(--text-muted)">Home</a>
        <span style="margin:0 8px">/</span>
        <a href="/blog" style="color:var(--text-muted)">Resources</a>
        <span style="margin:0 8px">/</span>
        <span style="color:var(--secondary)">Guides</span>
      </nav>
      <div class="section-label">Comprehensive Guide</div>
      <h1 class="section-title" style="max-width:900px">{title}</h1>
      <p class="section-subtitle" style="margin-top:12px;max-width:700px">{description}</p>
    </div>
  </section>
  <slot />
  <Divider />
  <CTASection />
</BaseLayout>
