---
import SEOHead from '../components/SEOHead.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import OrbBackground from '../components/OrbBackground.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object;
  pageClass?: string;
  webhookUrl?: string;
}

const { title, description, canonicalURL, ogImage, ogType, noindex, jsonLd, pageClass = '', webhookUrl = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <SEOHead
    title={title}
    description={description}
    canonicalURL={canonicalURL}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
    jsonLd={jsonLd}
  />
</head>
<body class={pageClass}>
  <OrbBackground />
  <Navigation />
  <main>
    <slot />
  </main>
  <Footer />
  <ChatWidget
    webhookUrl={Astro.props.webhookUrl || ''}
    title="Byte Digital"
    subtitle="Ask me anything about our services"
    placeholder="Type your question..."
  />
</body>
</html>

<script>
  import { initScrollReveal } from '../components/scripts/scroll-reveal';
  import { initScrollBackground } from '../components/scripts/scroll-background';

  function init() {
    // Gates the hidden-then-revealed state in global.css. Panels are visible
    // by default, so this only adds the animation -- it never gates content.
    document.documentElement.classList.add('js');

    initScrollReveal();
    const canvas = document.getElementById('orb-bg-canvas');
    if (canvas instanceof HTMLCanvasElement) initScrollBackground(canvas);
  }

  // Astro bundles this into a deferred module. In dev that module is fetched
  // as a separate request and can execute *after* DOMContentLoaded has already
  // fired, in which case a bare listener would never run. Checking readyState
  // covers both orderings. Same guard as Preloader.astro.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>

