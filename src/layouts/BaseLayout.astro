---
import SEOHead from '../components/SEOHead.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object;
  pageClass?: string;
}

const { title, description, canonicalURL, ogImage, ogType, noindex, jsonLd, pageClass = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <SEOHead
    title={title}
    description={description}
    canonicalURL={canonicalURL}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
    jsonLd={jsonLd}
  />
</head>
<body class={pageClass}>
  <Preloader />
  <Navigation />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
