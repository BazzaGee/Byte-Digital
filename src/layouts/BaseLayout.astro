---
import SEOHead from '../components/SEOHead.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object;
  pageClass?: string;
  webhookUrl?: string;
}

const { title, description, canonicalURL, ogImage, ogType, noindex, jsonLd, pageClass = '', webhookUrl = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <SEOHead
    title={title}
    description={description}
    canonicalURL={canonicalURL}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
    jsonLd={jsonLd}
  />
</head>
<body class={pageClass}>
  <Navigation />
  <main>
    <slot />
  </main>
  <Footer />
  <ChatWidget
    webhookUrl={Astro.props.webhookUrl || ''}
    title="Byte Digital"
    subtitle="Ask me anything about our services"
    placeholder="Type your question..."
  />
</body>
</html>

<script>
import { initScrollReveal } from '../components/scripts/scroll-reveal';
document.addEventListener('DOMContentLoaded', () => {
  initScrollReveal();
});
</script>
