---
const servicesDesign = [
  { href: '/services/web-design', label: 'Web Design', desc: 'Custom, conversion-focused websites' },
  { href: '/services/logo-design', label: 'Logo Design', desc: 'Memorable brand marks' },
  { href: '/services/branding', label: 'Branding', desc: 'Strategy and identity' },
];

const servicesDev = [
  { href: '/services/web-development', label: 'Web Development', desc: 'Fast, scalable applications' },
  { href: '/services/wordpress-development', label: 'WordPress', desc: 'Custom WordPress builds' },
  { href: '/services/ecommerce', label: 'eCommerce', desc: 'Online stores that convert' },
  { href: '/services/custom-applications', label: 'Custom Apps', desc: 'Tailor-made solutions' },
];

const servicesMarketing = [
  { href: '/services/seo', label: 'SEO', desc: 'Rank higher on Google' },
  { href: '/services/local-seo', label: 'Local SEO', desc: 'Dominate Christchurch search' },
  { href: '/services/website-maintenance', label: 'Maintenance', desc: 'Secure and up to date' },
];

const resources = [
  { href: '/blog', label: 'Blog', desc: 'Insights, guides, and trends' },
  { href: '/guides/website-cost-guide-nz', label: 'Free Guides', desc: 'In-depth resource library' },
  { href: '/tools/website-cost-calculator', label: 'Free Tools', desc: 'Calculators and audits' },
];
---

<nav class="nav" id="main-nav">
  <div class="nav-inner">
    <a href="/" style="display:flex;align-items:center;gap:12px;text-decoration:none">
      <div class="nav-logo-grid">
        <div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.1s"></div><div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.15s"></div><div class="nav-dot-blank"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.1s"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.15s"></div><div class="nav-dot-blank"></div>
        <div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.2s"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.3s"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.2s"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.3s"></div>
        <div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.4s"></div><div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.45s"></div><div class="nav-dot-blank"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.4s"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.45s"></div>
        <div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.5s"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.6s"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.5s"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.6s"></div>
        <div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.7s"></div><div class="nav-dot-active" style="--active-color:#8B78E6;animation-delay:0.8s"></div><div class="nav-dot-blank"></div><div class="nav-dot-blank"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.7s"></div><div class="nav-dot-active" style="--active-color:#5EEAD4;animation-delay:1.8s"></div><div class="nav-dot-blank"></div>
      </div>
      <span class="nav-logo"><span style="color:#8B78E6">BYTE</span><span style="color:#5EEAD4">DIGITAL</span></span>
    </a>
    <div class="nav-links" id="nav-links">
      <div class="nav-item mega-trigger" data-mega="services">
        <span>Services <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></span>
      </div>
      <a href="/case-studies">Work</a>
      <div class="nav-item mega-trigger" data-mega="resources">
        <span>Resources <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></span>
      </div>
      <a href="/locations">Locations</a>
      <a href="/about">About</a>
    </div>
    <a href="/contact" class="btn-cta nav-btn" style="padding:10px 24px;font-size:13px;">Get Free Quote</a>
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mega-panel" id="mega-services">
    <div class="container">
      <div class="mega-grid">
        <div class="mega-group">
          <div class="mega-group-label">Design</div>
          {servicesDesign.map(s => (
            <a href={s.href} class="mega-link">
              <div>
                <div class="mega-link-title">{s.label}</div>
                <div class="mega-link-desc">{s.desc}</div>
              </div>
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          ))}
        </div>
        <div class="mega-group">
          <div class="mega-group-label">Development</div>
          {servicesDev.map(s => (
            <a href={s.href} class="mega-link">
              <div>
                <div class="mega-link-title">{s.label}</div>
                <div class="mega-link-desc">{s.desc}</div>
              </div>
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          ))}
        </div>
        <div class="mega-group">
          <div class="mega-group-label">Marketing</div>
          {servicesMarketing.map(s => (
            <a href={s.href} class="mega-link">
              <div>
                <div class="mega-link-title">{s.label}</div>
                <div class="mega-link-desc">{s.desc}</div>
              </div>
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="mega-panel" id="mega-resources">
    <div class="container">
      <div class="mega-grid mega-grid-sm">
        {resources.map(r => (
          <a href={r.href} class="mega-link mega-link-lg">
            <div class="mega-link-icon">
              {r.href.includes('/blog') && (
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              )}
              {r.href.includes('/guides') && (
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              )}
              {r.href.includes('/tools') && (
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              )}
            </div>
            <div>
              <div class="mega-link-title">{r.label}</div>
              <div class="mega-link-desc">{r.desc}</div>
            </div>
            <svg class="mega-link-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="nav-mobile-menu" id="nav-mobile-menu">
    <div class="mobile-nav-section">
      <button class="mobile-nav-toggle" data-section="mobile-services">
        <span>Services</span>
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="mobile-nav-sub" id="mobile-services">
        {servicesDesign.map(s => <a href={s.href}>{s.label}</a>)}
        {servicesDev.map(s => <a href={s.href}>{s.label}</a>)}
        {servicesMarketing.map(s => <a href={s.href}>{s.label}</a>)}
      </div>
    </div>
    <div class="mobile-nav-divider"></div>
    <div class="mobile-nav-section">
      <button class="mobile-nav-toggle" data-section="mobile-resources">
        <span>Resources</span>
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="mobile-nav-sub" id="mobile-resources">
        {resources.map(r => <a href={r.href}>{r.label}</a>)}
      </div>
    </div>
    <a href="/case-studies" class="mobile-nav-link">Work</a>
    <a href="/locations" class="mobile-nav-link">Locations</a>
    <a href="/about" class="mobile-nav-link">About</a>
    <a href="/contact" class="mobile-cta">Get Free Quote</a>
  </div>
</nav>

<script>
const hamburger = document.getElementById('nav-hamburger');
const mobileMenu = document.getElementById('nav-mobile-menu');

hamburger?.addEventListener('click', () => {
  const isOpen = hamburger.classList.toggle('open');
  mobileMenu?.classList.toggle('open');
  document.body.style.overflow = isOpen ? 'hidden' : '';
});

mobileMenu?.querySelectorAll('a').forEach(link => {
  link.addEventListener('click', () => {
    hamburger?.classList.remove('open');
    mobileMenu?.classList.remove('open');
    document.body.style.overflow = '';
  });
});

document.querySelectorAll('.mobile-nav-toggle').forEach(btn => {
  btn.addEventListener('click', () => {
    const sectionId = btn.getAttribute('data-section');
    const sub = document.getElementById(sectionId!);
    const isOpen = btn.classList.toggle('open');
    if (sub) sub.classList.toggle('open');
  });
});

let megaTimeout: ReturnType<typeof setTimeout>;
let activeMega: string | null = null;

const megaTriggers = document.querySelectorAll('.mega-trigger');
const megaPanels = document.querySelectorAll('.mega-panel');

function showMega(name: string) {
  megaPanels.forEach(p => p.classList.remove('open'));
  const panel = document.getElementById(`mega-${name}`);
  if (panel) panel.classList.add('open');
  activeMega = name;
}

function hideMega() {
  megaPanels.forEach(p => p.classList.remove('open'));
  activeMega = null;
}

megaTriggers.forEach(trigger => {
  const name = trigger.getAttribute('data-mega')!;

  trigger.addEventListener('mouseenter', () => {
    clearTimeout(megaTimeout);
    showMega(name);
  });

  trigger.addEventListener('mouseleave', () => {
    megaTimeout = setTimeout(() => {
      if (activeMega === name) hideMega();
    }, 150);
  });
});

megaPanels.forEach(panel => {
  panel.addEventListener('mouseenter', () => {
    clearTimeout(megaTimeout);
  });

  panel.addEventListener('mouseleave', () => {
    megaTimeout = setTimeout(hideMega, 150);
  });
});

document.addEventListener('click', (e) => {
  const target = e.target as HTMLElement;
  if (!target.closest('.mega-trigger') && !target.closest('.mega-panel')) {
    hideMega();
  }
});
</script>
