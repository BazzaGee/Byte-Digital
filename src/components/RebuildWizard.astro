    padding: 11px 14px;
    border-radius: 10px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    font-size: 14px;
    color: #fca5a5;
  }

  .rb-nav {
    flex: none;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: clamp(14px, 2vh, 26px);
    padding-top: clamp(12px, 1.8vh, 20px);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .rb-back {
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px 6px;
  }

  .rb-back:hover {
    color: #fff;
  }

  .rb-next {
    margin-left: auto;
    padding: 14px 34px;
    font-size: 15px;
    border: none;
    cursor: pointer;
  }

  .rb-next:disabled {
    opacity: 0.6;
    cursor: default;
  }

  /* --- Build step ---------------------------------------------------------
     Shown after the brief is submitted. The graphic, the copy, the ticker and
     the bar are one grid that always fits the card, so the step never scrolls
     — especially on a phone. */
  .rb-build {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    gap: clamp(10px, 1.8vh, 18px);
