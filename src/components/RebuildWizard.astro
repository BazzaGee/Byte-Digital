    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .rb-build-toggle {
    color: var(--secondary);
    background: rgba(94, 234, 212, 0.08);
    border: 1px solid rgba(94, 234, 212, 0.28);
  }

  .rb-build-leave {
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .rb-build-new {
    color: var(--text-dimmed);
    background: none;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .rb-build-new:hover {
    color: var(--text-muted);
  }

  /* Compact: the full animation yields to a small inline badge. */
  .rb-build--compact {
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-content: center;
    justify-items: start;
    column-gap: 14px;
    row-gap: 10px;
    min-height: 0;
    text-align: left;
  }

  .rb-build--compact .rb-build-copy {
    grid-column: 2;
    grid-row: 1;
  }

  .rb-build--compact .rb-build-title {
    font-size: 18px;
  }

  .rb-build--compact .rb-build-detail,
  .rb-build--compact .rb-build-aside,
  .rb-build--compact .rb-ticker,
  .rb-build--compact .rb-build-fine {
    display: none;
  }

  .rb-build--compact .rb-build-foot {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .rb-build--compact .rb-build-bar {
    margin-top: 0;
  }

  .rb-build--compact .rb-build-email {
    margin-top: 8px;
  }

  /* The free promise. Only on the opening and closing steps — saying "free" six
     times would read as a sales pressure tactic rather than a fact. */
.rb-note {
    margin: -10px 0 18px;
    padding: 10px 13px;
    border-radius: 11px;
    background: rgba(94, 234, 212, 0.07);
    border: 1px solid rgba(94, 234, 212, 0.22);
    font-size: 13.5px;
    line-height: 1.5;
    color: #a7f3d0;
  }

  /* Short viewports: tighten every vertical rhythm so all six steps still fit
     without the step body scrolling. The chrome gives up its spacing before the
     steps do — head, nav and card padding are all padding the visitor never
     reads. */
  @media (max-height: 700px) {
    .rb-card {
      padding: 12px 18px 10px;
    }

    .rb-head {
      margin-bottom: 6px;
    }

    .rb-nav {
      margin-top: 8px;
      padding-top: 8px;
    }

    .rb-eyebrow {
      margin-bottom: 6px;
    }

    .rb-title {
      font-size: clamp(19px, 4.6vh, 22px);
      margin: 2px 0 6px;
    }

    .rb-lede {
      font-size: 14px;
      margin: 0 0 14px;
    }

    .rb-label {
      margin: 12px 0 5px;
    }

    .rb-hint {
      margin-bottom: 6px;
      font-size: 12px;
    }

    .rb-input {
      padding: 11px 13px;
    }

    .rb-textarea {
      min-height: 60px;
    }

    .rb-chips {
      gap: 6px;
    }

    .rb-chip {
      font-size: 13px;
      padding: 6px 11px;
    }

    .rb-tier {
      margin-bottom: 12px;
      padding: 10px 13px 9px;
    }

    .rb-tier-body {
      font-size: 12.5px;
      margin-bottom: 10px;
    }

    .rb-textarea {
      height: 58px;
      min-height: 58px;
    }

    .rb-drop {
      padding: 18px 16px;
    }

    .rb-consent {
      margin-top: 14px;
    }

    .rb-note {
      margin: -8px 0 14px;
      padding: 8px 11px;
      font-size: 12.5px;
    }

    .rb-error {
      margin: 10px 0 0;
    }

    .rb-next {
      padding: 12px 28px;
    }
  }

  @media (max-width: 640px) {
    .rb-card {
      padding: 18px 16px 16px;
      border-radius: 18px;
    }

    .rb-two {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .rb-next {
      padding: 13px 24px;
    }

    /* The two chip steps are the tallest thing in the funnel — ten chips wrap to
       six rows on a phone. Tightening the chip and the type above them keeps
       those steps inside the card without any scrolling. */
    .rb-title {
      font-size: 20px;
      margin: 2px 0 6px;
    }

    .rb-lede {
      font-size: 13.5px;
      line-height: 1.5;
      margin: 0 0 12px;
    }

    .rb-label {
      font-size: 12.5px;
      margin: 10px 0 4px;
    }

    .rb-chips {
      gap: 5px;
    }

    .rb-chip {
      font-size: 12.5px;
      padding: 5px 9px;
    }

    .rb-tier {
      margin-bottom: 10px;
      padding: 9px 12px 8px;
      border-radius: 12px;
    }

    .rb-tier-legend {
      font-size: 12.5px;
      margin-bottom: 5px;
    }

    .rb-tier-body {
      font-size: 12px;
      margin-bottom: 9px;
    }

    .rb-textarea {
      height: 56px;
      min-height: 56px;
    }

    .rb-consent {
      margin-top: 12px;
      font-size: 13px;
    }

    .rb-note {
      margin: -8px 0 12px;
      padding: 8px 11px;
      font-size: 12.5px;
    }

    .rb-two .rb-label {
      margin-top: 6px;
    }
  }

  /* The shortest phones (an iPhone SE is 667px tall) are the tightest case in
     the funnel: the free-note copy took vertical space out of steps 2, 4 and 6,
     so these are the last few pixels. Nothing scrolls — the page never does. */
  @media (max-width: 640px) and (max-height: 700px) {
    .rb-title {
      font-size: 18px;
    }

    .rb-lede {
      margin: 0 0 10px;
    }

    .rb-chip {
      font-size: 12px;
      padding: 4px 8px;
    }

    .rb-chips {
      gap: 4px;
    }

    .rb-textarea {
      height: 52px;
    }

    .rb-note {
      margin: -8px 0 10px;
      padding: 7px 10px;
      font-size: 12px;
    }

    .rb-consent {
      margin-top: 8px;
      font-size: 12px;
    }

    .rb-two .rb-label {
      margin-top: 2px;
    }

    /* The capability step carries the two tier panels — they are the first
       thing to go when vertical space runs out, because the chips underneath
       are what the brief actually needs. Tier B's prose is the last to go: it
       is the honesty about what a free build will not do. */
    .rb-tier-body {
      display: none;
    }

    .rb-tier {
      margin-bottom: 8px;
      padding: 8px 11px 7px;
    }

    /* The hint only reworded what "(optional)" already said, and the label
       system repeats 4× on the opening step — both are the cheapest pixels. */
    .rb-hint {
      display: none;
    }

    .rb-label {
      margin-top: 9px;
    }

    /* min-height beats the shorter `height` set further down, so the note box
       ate 74px on every phone. */
    .rb-textarea {
      min-height: 56px;
    }
  }

  /* Narrow, but tall enough to hold both panels: keep Tier B's honesty and
     drop only the Tier A explanation the legend already states. */
  @media (max-width: 640px) and (min-height: 701px) {
    .rb-tier--in .rb-tier-body {
      display: none;
    }
  }

  /* Below this there is not enough width for two inputs side by side. */
  @media (max-width: 359px) {
    .rb-two {
      grid-template-columns: 1fr;
    }
  }

  /* The build step on a short viewport: drop the texture first, then tighten.
      The tagline, the bar and the email promise always survive. */
  @media (max-height: 700px) {
    .rb-build {
      gap: 8px;
      min-height: 40vh;
    }

    .rb-build-aside {
      display: none;
    }

    .rb-build-sub {
      font-size: 12px;
    }

    .rb-build-email {
      margin-top: 8px;
    }

    .rb-build-fine {
      display: none;
    }
  }

  /* iPhone SE height and below: the ticker is the next thing to go. */
  @media (max-height: 600px) {
    .rb-ticker {
      display: none;
    }
  }

  /* Landscape phones. The graphic is the first thing to go. */
  @media (max-height: 520px) {
    .rb-build {
      min-height: 0;
    }

    .rb-build-detail {
      display: none;
    }

    .rb-build-bar {
      margin-top: 8px;
    }
  }
</style>

<script>
  import {
    BUILD_STAGES,
    BUILD_TOTAL_MS,
    BUILD_COMPACT_AFTER_MS,
    progressAt,
    remainingMs,
    formatDuration,
  } from './scripts/build-timeline';

  type LeadSource = 'live' | 'showcase' | 'site';

  interface UploadedAsset {
    key: string;
    name: string;
    size: number;
    type: string;
    url: string;
  }

  const MAX_FILES = 6;
  const MAX_FILE_BYTES = 8 * 1024 * 1024;
  const ALLOWED_EXTENSIONS = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'svg', 'pdf', 'zip'];

  const root = document.getElementById('rb-wizard') as HTMLElement;
  // Server-rendered, never from a query param: the tag has to describe what is
  // actually on screen, so a hand-edited URL cannot disagree with the copy.
  const variant: 'rebuild' | 'new-build' = root.dataset.variant === 'new-build' ? 'new-build' : 'rebuild';

  const params = new URLSearchParams(window.location.search);
  const srcParam = params.get('src') || 'site';
  const source: LeadSource = (['live', 'showcase', 'site'] as const).includes(srcParam as LeadSource)
    ? (srcParam as LeadSource)
    : 'site';
  const slug = params.get('slug') || '';
  const prefillBusiness = params.get('business') || '';
  const prefillCurrent = params.get('live') || '';

  const card = document.getElementById('rb-card') as HTMLElement;
  const head = document.getElementById('rb-head') as HTMLElement;
  const nav = document.getElementById('rb-nav') as HTMLElement;
  const nextButton = document.getElementById('rb-next') as HTMLButtonElement;
  const backButton = document.getElementById('rb-back') as HTMLButtonElement;
  const progressFill = document.getElementById('rb-progress-fill') as HTMLElement;
  const progressLabel = document.getElementById('rb-progress-label') as HTMLElement;

  const buildStep = document.getElementById('rb-build') as HTMLElement;
  const buildFill = document.getElementById('rb-build-fill') as HTMLElement;
  const buildBar = document.getElementById('rb-build-bar') as HTMLElement;
  const buildTime = document.getElementById('rb-build-time') as HTMLElement;
  const buildKicker = document.getElementById('rb-build-kicker') as HTMLElement;
  const buildTitle = document.getElementById('rb-build-title') as HTMLElement;
  const buildDetail = document.getElementById('rb-build-detail') as HTMLElement;
  const buildAside = document.getElementById('rb-build-aside') as HTMLElement;
  const buildEmail = document.getElementById('rb-build-email') as HTMLElement;
  const buildToggle = document.getElementById('rb-build-toggle') as HTMLButtonElement;
  const buildLeave = document.getElementById('rb-build-leave') as HTMLButtonElement;
  const buildNew = document.getElementById('rb-build-new') as HTMLButtonElement;
  const ticker = document.getElementById('rb-ticker') as HTMLElement;
  const vizStages = Array.from(document.querySelectorAll<HTMLElement>('.rb-viz-stage'));

  const businessInput = document.getElementById('rb-business') as HTMLInputElement;
  const currentInput = document.getElementById('rb-current') as HTMLInputElement;
  const contactInput = document.getElementById('rb-contact') as HTMLInputElement | null;
  const servicesOther = document.getElementById('rb-services-other') as HTMLTextAreaElement | null;
  const categoryOther = document.getElementById('rb-category-other') as HTMLInputElement | null;
  const featureNote = document.getElementById('rb-feature-note') as HTMLTextAreaElement | null;
  const uspInput = document.getElementById('rb-usp') as HTMLTextAreaElement;
  // Two ids for the same slot: `rebuild` still runs its own design step,
  // `new-build` folds it into the shape step as one shared box.
  const designWishes = (document.getElementById('rb-shape-other') ??
    document.getElementById('rb-design-wishes')) as HTMLTextAreaElement;
  const integrationsReveal = document.getElementById('rb-integrations-reveal');
  const assetLink = document.getElementById('rb-asset-link') as HTMLInputElement;
  const firstNameInput = document.getElementById('rb-first') as HTMLInputElement;
  const emailInput = document.getElementById('rb-email') as HTMLInputElement;
  const consentInput = document.getElementById('rb-consent') as HTMLInputElement;
  const honeypot = document.getElementById('rb-hp') as HTMLInputElement;
  const fileInput = document.getElementById('rb-files') as HTMLInputElement;
  const dropZone = document.getElementById('rb-drop') as HTMLElement;
  const fileList = document.getElementById('rb-filelist') as HTMLUListElement;
  const uploadNote = document.getElementById('rb-upload') as HTMLElement;
  const revealWrap = document.getElementById('rb-reveal') as HTMLElement | null;
  const serviceChips = Array.from(
    document.querySelectorAll<HTMLButtonElement>('#rb-reveal .rb-chip[data-for-category]')
  );

  // Every section is one of these; the build step is tracked separately because
  // it is not part of the numbered flow.
  const allSteps = Array.from(document.querySelectorAll<HTMLElement>('.rb-step'));
  const ordered = allSteps.filter((el) => el.hasAttribute('data-rb-kind'));
  const TOTAL_STEPS = ordered.length;

  let pos = 0;
  let assets: UploadedAsset[] = [];
  const picks: Record<string, Set<string>> = {};
  document.querySelectorAll<HTMLElement>('[data-rb-chips]').forEach((group) => {
    const name = group.dataset.rbChips as string;
    if (!picks[name]) picks[name] = new Set();
  });

  businessInput.value = prefillBusiness;
  currentInput.value = prefillCurrent;

  function chosen(name: string): string[] {
    return Array.from(picks[name] ?? []);
  }

  function single(name: string): string {
    return chosen(name)[0] ?? '';
  }

  function track(name: string, data: Record<string, unknown> = {}) {
    const gtag = (window as any).gtag;
    if (typeof gtag === 'function') gtag('event', name, data);
  }

  function activeError(): HTMLElement | null {
    return ordered[pos]?.querySelector<HTMLElement>('[data-rb-error]') ?? null;
  }

  function clearErrors() {
    document.querySelectorAll<HTMLElement>('[data-rb-error]').forEach((el) => {
      el.hidden = true;
      el.textContent = '';
    });
  }

  function showError(message: string) {
    const el = activeError();
    if (!el) return;
    el.textContent = message;
    el.hidden = false;
  }

  // Read off the DOM so the client bundle never has to import the copy file —
  // the button already carries the variant's wording.
  const SUBMIT_LABEL = nextButton.dataset.submitLabel || 'Send my brief';

  const ARROW =
    '<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>';
  const continueLabel = `Continue ${ARROW}`;

  function go(index: number) {
    clearErrors();
    pos = index;
    const current = ordered[pos];
    allSteps.forEach((node) => {
      node.hidden = node !== current;
    });
    head.hidden = false;
    nav.hidden = false;
    progressFill.style.width = `${((pos + 1) / TOTAL_STEPS) * 100}%`;
    progressLabel.textContent = `Step ${pos + 1} of ${TOTAL_STEPS}`;
    backButton.hidden = pos === 0;
    nextButton.innerHTML = pos === TOTAL_STEPS - 1 ? `${SUBMIT_LABEL} ${ARROW}` : continueLabel;
    track('rebuild_step', { step: pos + 1, kind: current.dataset.rbKind, source, variant });
    const focusTarget = current.querySelector<HTMLElement>(
      'input:not([tabindex="-1"]):not([type="checkbox"]), textarea'
    );
    if (focusTarget && window.matchMedia('(min-width: 641px)').matches) focusTarget.focus({ preventScroll: true });
  }

  function validateStep(kind: string): string {
    if (kind === 'business') {
      if (!businessInput.value.trim()) return 'Please enter your business name.';
      if (picks.existingSite && picks.existingSite.size === 0) return 'Please pick one of these.';
      return '';
    }
    if (kind === 'category') {
      // Ten chips cannot cover every business — a typed answer is as good as a
      // tap, and it is the only way through for the visitor none of them fit.
      if (!picks.category?.size && !categoryOther?.value.trim()) {
        return 'Pick one, or describe it in your own words below.';
      }
      if (!picks.services?.size && !servicesOther?.value.trim()) {
        return 'Pick at least one, or describe what you do in your own words.';
      }
      return '';
    }
    if (kind === 'services') {
      if (!picks.services?.size && !servicesOther?.value.trim()) {
        return 'Pick at least one, or describe what you do in your own words.';
      }
      return '';
    }
    // `siteType` and `capabilities` are deliberately unvalidated: forcing a
    // pick on either produces answers people did not mean, and the free-text
    // note underneath always covers what the chips missed.
    if (kind === 'contact') {
      if (!firstNameInput.value.trim()) return 'Please enter your first name.';
      const email = emailInput.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return 'Please enter a valid email address.';
    }
    return '';
  }

  function advance() {
    const problem = validateStep(ordered[pos].dataset.rbKind as string);
    if (problem) {
      showError(problem);
      return;
    }
    if (pos < TOTAL_STEPS - 1) {
      go(pos + 1);
      return;
    }
    void submit();
  }

  nextButton.addEventListener('click', advance);
  backButton.addEventListener('click', () => {
    if (pos > 0) go(pos - 1);
  });

  card.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    const target = event.target as HTMLElement;
    if (target.tagName === 'TEXTAREA' || target.tagName === 'BUTTON') return;
    event.preventDefault();
    advance();
  });

  document.querySelectorAll<HTMLElement>('[data-rb-chips]').forEach((group) => {
    const name = group.dataset.rbChips as string;
    const singleSelect = group.hasAttribute('data-rb-single');
    group.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLElement>('.rb-chip');
      if (!chip || chip.hidden) return;
      const value = chip.getAttribute('data-rb-value') || '';

      if (singleSelect) {
        group.querySelectorAll<HTMLElement>('.rb-chip').forEach((other) => {
          if (other !== chip) other.setAttribute('aria-pressed', 'false');
        });
        picks[name].clear();
        picks[name].add(value);
        chip.setAttribute('aria-pressed', 'true');
        if (name === 'category') revealCategory(value);
        return;
      }

      if (picks[name].has(value)) {
        picks[name].delete(value);
        chip.setAttribute('aria-pressed', 'false');
      } else {
        picks[name].add(value);
        chip.setAttribute('aria-pressed', 'true');
      }

      // Connections only become a question once the visitor has said they want
      // something bigger than the free build. Leaving it hidden otherwise keeps
      // this step to two panels for everyone who just wants the basics.
      if (name === 'capabilitiesOut' && (picks.capabilitiesOut?.size ?? 0) > 0) {
        if (integrationsReveal) integrationsReveal.hidden = false;
      }
    });
  });

  /**
   * The service list belongs to a business type rather than to one fixed set,
   * so chips for every type ship in the DOM and are filtered to the picked one.
   * Changing the type clears the old picks — a value picked under one type can
   * never survive into another.
   */
  function revealCategory(type: string) {
    if (!revealWrap) return;
    revealWrap.hidden = false;
    picks.services?.clear();
    serviceChips.forEach((chip) => {
      const match = chip.getAttribute('data-for-category') === type;
      chip.hidden = !match;
      chip.setAttribute('aria-pressed', 'false');
    });
  }

  function formatSize(bytes: number): string {
    if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    return `${Math.max(1, Math.round(bytes / 1024))} KB`;
  }

  function renderFiles() {
    fileList.innerHTML = '';
    assets.forEach((asset, index) => {
      const item = document.createElement('li');
      const name = document.createElement('span');
      name.className = 'rb-file-name';
      name.textContent = asset.name;
      const size = document.createElement('span');
      size.className = 'rb-file-size';
      size.textContent = formatSize(asset.size);
      const tick = document.createElement('span');
      tick.className = 'rb-file-tick';
      tick.textContent = '\u2713';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'rb-file-remove';
      remove.setAttribute('aria-label', `Remove ${asset.name}`);
      remove.textContent = '\u00d7';
      remove.addEventListener('click', () => {
        assets.splice(index, 1);
        renderFiles();
      });
      item.append(name, size, tick, remove);
      fileList.appendChild(item);
    });
  }

  function fileProblem(file: File): string {
    const extension = (file.name.split('.').pop() || '').toLowerCase();
    if (!ALLOWED_EXTENSIONS.includes(extension)) {
      return `"${file.name}" is not a supported type. Photos, PDFs and ZIPs only.`;
    }
    if (file.size > MAX_FILE_BYTES) {
      return `"${file.name}" is bigger than 8 MB. Please compress it or paste a link instead.`;
    }
    return '';
  }

  async function uploadFiles(list: FileList | File[]) {
    const files = Array.from(list);
    if (assets.length + files.length > MAX_FILES) {
      showError(`That would be more than ${MAX_FILES} files. Please remove some first.`);
      return;
    }
    for (const file of files) {
      const problem = fileProblem(file);
      if (problem) {
        showError(problem);
        return;
      }
    }

    clearErrors();
    const form = new FormData();
    files.forEach((file) => form.append('files', file));

    uploadNote.hidden = false;
    uploadNote.textContent = `Uploading ${files.length} file${files.length === 1 ? '' : 's'}\u2026`;
    fileInput.disabled = true;

    try {
      const res = await fetch('/api/rebuild-assets', { method: 'POST', body: form });
      const payload = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(payload.error || 'The upload failed. Please try again, or paste a link instead.');
        return;
      }
      assets = assets.concat(payload.files as UploadedAsset[]);
      renderFiles();
    } catch {
      showError('Could not reach the server. Please try again, or paste a link instead.');
    } finally {
      uploadNote.hidden = true;
      fileInput.disabled = false;
      fileInput.value = '';
    }
  }

  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length) void uploadFiles(fileInput.files);
  });

  dropZone.addEventListener('click', () => fileInput.click());
  ['dragenter', 'dragover'].forEach((name) =>
    dropZone.addEventListener(name, (event) => {
      event.preventDefault();
      dropZone.classList.add('rb-dragover');
    })
  );
  ['dragleave', 'drop'].forEach((name) =>
    dropZone.addEventListener(name, (event) => {
      event.preventDefault();
      dropZone.classList.remove('rb-dragover');
    })
  );
  dropZone.addEventListener('drop', (event) => {
    const files = (event as DragEvent).dataTransfer?.files;
    if (files && files.length) void uploadFiles(files);
  });

  // --- Build step -----------------------------------------------------------
  // The timeline is illustrative: the pipeline exposes no public status, so the
  // wall clock drives the stages. It is seeded at submit time (server-assisted)
  // and kept in localStorage so a reload resumes rather than restarting. The
  // key is per variant so one flow's timer can never resume inside the other.

  const BUILD_KEY = `rb-build-started:${variant}`;
  const ARC_LENGTH = 2 * Math.PI * 52;
  const WELCOME_BACK_MS = 15 * 60_000;

  let buildStartedAt = 0;
  let buildTimer: number | null = null;
  let tickerTimer: number | null = null;
  let compactTimer: number | null = null;
  let activeStageIndex = -1;
  let tickerIndex = 0;
  let tickerLines: string[] = [];
  let userExpanded = false;

  function readBuildSeed(): number {
    try {
      const raw = localStorage.getItem(BUILD_KEY);
      const value = raw ? Number(raw) : NaN;
      return Number.isFinite(value) && value > 0 ? value : 0;
    } catch {
      return 0;
    }
  }

  function writeBuildSeed(value: number) {
    try {
      localStorage.setItem(BUILD_KEY, String(value));
    } catch {
      /* private mode — the step still works, it just will not resume */
    }
  }

  function clearBuildSeed() {
    try {
      localStorage.removeItem(BUILD_KEY);
    } catch {
      /* ignore */
    }
  }

  function makeTickerLine(text: string): HTMLLIElement {
    const item = document.createElement('li');
    item.textContent = text;
    return item;
  }

  function pushTickerLine() {
    if (document.hidden || !tickerLines.length) return;
    if (buildStep.classList.contains('rb-build--compact')) return;
    const item = makeTickerLine(tickerLines[tickerIndex % tickerLines.length]);
    tickerIndex += 1;
    ticker.appendChild(item);
    while (ticker.children.length > 3) ticker.firstElementChild?.remove();
  }

  function startTicker(lines: string[]) {
    tickerLines = lines;
    tickerIndex = 0;
    ticker.innerHTML = '';
    if (tickerTimer !== null) window.clearInterval(tickerTimer);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      lines.slice(0, 3).forEach((line) => ticker.appendChild(makeTickerLine(line)));
      return;
    }
    pushTickerLine();
    pushTickerLine();
    pushTickerLine();
    tickerTimer = window.setInterval(pushTickerLine, 1800);
  }

  function setCompact(on: boolean) {
    buildStep.classList.toggle('rb-build--compact', on);
    buildToggle.textContent = on ? 'Show me more' : 'Collapse';
  }

  function renderBuild(initial: boolean) {
    const elapsed = Math.max(0, Date.now() - buildStartedAt);
    const { pct, stageIndex, stageProgress } = progressAt(elapsed);
    const stage = BUILD_STAGES[stageIndex];

    buildFill.style.width = `${pct}%`;
    buildBar.setAttribute('aria-valuenow', String(Math.round(pct)));
    buildBar.setAttribute('aria-valuetext', `${stage.title} — ${formatDuration(remainingMs(elapsed))} to go`);

    if (stageIndex !== activeStageIndex) {
      activeStageIndex = stageIndex;
      buildTitle.textContent = stage.title;
      buildDetail.textContent = stage.detail;
      buildAside.textContent = stage.aside;
      vizStages.forEach((node, index) => {
        if (index === stageIndex) node.setAttribute('data-active', '');
        else node.removeAttribute('data-active');
        const arc = node.querySelector<SVGCircleElement>('[data-build-arc]');
        if (arc) arc.style.strokeDasharray = `0 ${ARC_LENGTH}`;
      });
      startTicker(stage.logs);
    }

    const activeArc = vizStages[stageIndex]?.querySelector<SVGCircleElement>('[data-build-arc]');
    if (activeArc) activeArc.style.strokeDasharray = `${stageProgress * ARC_LENGTH} ${ARC_LENGTH}`;

    const remaining = remainingMs(elapsed);
    if (elapsed < 45_000) {
      buildTime.textContent = `Just started · about ${formatDuration(remaining)} to go`;
    } else if (remaining <= 0) {
      buildTime.textContent = 'Any minute now — check your inbox';
    } else {
      buildTime.textContent = `${formatDuration(elapsed)} in · about ${formatDuration(remaining)} to go`;
    }

    if (initial) {
      buildKicker.textContent = elapsed > WELCOME_BACK_MS ? 'Still going — welcome back' : 'Building your website';
    }
  }

  function showBuild(startedAt: number, email: string, fresh: boolean) {
    buildStartedAt = startedAt;
    nextButton.disabled = false;
    allSteps.forEach((node) => {
      node.hidden = node !== buildStep;
    });
    buildStep.hidden = false;
    head.hidden = true;
    nav.hidden = true;
    document.body.classList.add('rb-building');
    if (email) buildEmail.textContent = `I will email ${email} the moment it is ready.`;

    activeStageIndex = -1;
    renderBuild(true);

    if (buildTimer !== null) window.clearInterval(buildTimer);
    buildTimer = window.setInterval(() => renderBuild(false), 1000);

    if (fresh) track('rebuild_build_started', { source, variant });

    const elapsed = Date.now() - buildStartedAt;
    if (compactTimer !== null) window.clearTimeout(compactTimer);
    if (elapsed > BUILD_COMPACT_AFTER_MS || window.matchMedia('(max-height: 520px)').matches) {
      setCompact(true);
    } else {
      setCompact(false);
      compactTimer = window.setTimeout(() => {
        if (!userExpanded) setCompact(true);
      }, BUILD_COMPACT_AFTER_MS - elapsed);
    }
  }

  function stopBuildClock() {
    if (buildTimer !== null) window.clearInterval(buildTimer);
    if (tickerTimer !== null) window.clearInterval(tickerTimer);
    if (compactTimer !== null) window.clearTimeout(compactTimer);
    buildTimer = null;
    tickerTimer = null;
    compactTimer = null;
    document.body.classList.remove('rb-building');
  }

  buildToggle.addEventListener('click', () => {
    const isCompact = buildStep.classList.toggle('rb-build--compact');
    userExpanded = !isCompact;
    buildToggle.textContent = isCompact ? 'Show me more' : 'Collapse';
  });

  buildLeave.addEventListener('click', () => {
    // Script-opened tabs can be closed; anything else falls back to where the
    // visitor came from, then to the site home.
    try {
      window.close();
    } catch {
      /* not script-opened */
    }
    window.setTimeout(() => {
      if (document.hidden) return;
      if (window.history.length > 1) window.history.back();
      else window.location.href = '/';
    }, 250);
  });

  buildNew.addEventListener('click', () => {
    stopBuildClock();
    clearBuildSeed();
    buildStep.hidden = true;
    userExpanded = false;
    nextButton.disabled = false;
    go(0);
  });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && buildStartedAt) renderBuild(false);
  });

  async function submit() {
    nextButton.disabled = true;
    const original = nextButton.innerHTML;
    nextButton.textContent = 'Sending\u2026';

    // The USP chips are folded into the one prose field so the brief still
    // reads as a sentence — and no extra column was needed to store them.
    const usp = [chosen('usp').join('. '), uspInput.value.trim()].filter(Boolean).join('. ');

    const payload = {
      variant,
      source,
      slug,
      businessName: businessInput.value.trim(),
      currentWebsite: currentInput.value.trim(),
      businessContact: contactInput?.value.trim() || '',
      hasExistingSite: single('existingSite') || 'not-asked',
      category: single('category'),
      categoryOther: categoryOther?.value.trim() || '',
      services: chosen('services'),
      servicesOther: servicesOther?.value.trim() || '',
      usp,
      siteTypes: chosen('siteType'),
      features: [...chosen('capabilitiesIn'), ...chosen('capabilitiesOut')],
      featureNote: featureNote?.value.trim() || '',
      integrationRequests: chosen('integrations'),
      designPicks: chosen('design'),
      designWishes: designWishes.value.trim(),
      assets: assets.map(({ key, name, size, type }) => ({ key, name, size, type })),
      assetLink: assetLink.value.trim(),
      firstName: firstNameInput.value.trim(),
      email: emailInput.value.trim(),
      consent: consentInput.checked,
      companyWebsite: honeypot.value,
      pageUrl: window.location.href,
      referrer: document.referrer || '',
      // Where the visit actually began — the page only ever sees the params it
      // was opened with, so this is the true arrival, not a later navigation.
      utmSource: params.get('utm_source') || '',
      utmMedium: params.get('utm_medium') || '',
      utmCampaign: params.get('utm_campaign') || '',
    };

    try {
      const res = await fetch('/api/rebuild-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(data.error || 'Something went wrong. Please try again.');
        nextButton.disabled = false;
        nextButton.innerHTML = original;
        return;
      }

      track('rebuild_submit', {
        source,
        variant,
        category: payload.category,
        scope: data.scope || '',
        has_assets: assets.length > 0,
      });

      const startedAt =
        typeof data.startedAt === 'number' && data.startedAt > 0 ? data.startedAt : Date.now();
      writeBuildSeed(startedAt);
      showBuild(startedAt, payload.email, true);
    } catch {
      showError('Could not reach the server. Please check your connection and try again.');
      nextButton.disabled = false;
      nextButton.innerHTML = original;
    }
  }

  // A recent build resumes straight to the progress step, so a reload or a
  // re-opened tab does not dump the visitor back at question one.
  const seed = readBuildSeed();
  if (seed && Date.now() - seed < BUILD_TOTAL_MS) {
    showBuild(seed, '', false);
  } else {
    if (seed) clearBuildSeed();
    go(0);
  }
</script>
