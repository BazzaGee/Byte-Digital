---
import BuildStageMachine from './BuildStageMachine.astro';
import {
  copyFor,
  SERVICES_BY_CATEGORY,
  type FunnelVariant,
} from '../data/funnel-copy';

interface Props {
  /** Which world the visitor arrived from. Drives copy, steps and the tag. */
  variant?: FunnelVariant;
}

const { variant = 'rebuild' } = Astro.props;
const copy = copyFor(variant);

// Optional steps are gated on whether the copy supplies them, so the markup,
// the words and the step order can never disagree with each other.
const services = copy.services;
const category = copy.category;
const shape = copy.shape;
const capabilities = copy.capabilities;
const existingSite = copy.business.existingGroup;
const uspChips = copy.usp.group;
const design = copy.design;

// Matches the markup below: five sections always render, the rest only when
// their variant supplies them. The script recomputes the same number from the
// DOM on load, so this only covers the moment before it runs.
// business + usp + assets + contact always render; the rest depend on variant.
const stepCount =
  4 +
  (category ? 1 : 0) +
  (services ? 1 : 0) +
  (shape ? 1 : 0) +
  (capabilities ? 1 : 0) +
  (design ? 1 : 0);
---

<div class="rb-shell" id="rb-wizard" data-variant={variant}>
  <div class="rb-card glass" id="rb-card">
    <div class="rb-head" id="rb-head">
      <div class="rb-eyebrow">{copy.eyebrow}</div>
      <div class="rb-progress">
        <div class="rb-progress-track">
          <div class="rb-progress-fill" id="rb-progress-fill"></div>
        </div>
        <div class="rb-progress-label" id="rb-progress-label">Step 1 of {stepCount}</div>
      </div>
    </div>

    <div class="rb-body">
      <section class="rb-step" data-rb-kind="business">
        <h2 class="rb-title">{copy.business.title}</h2>
        <p class="rb-lede">{copy.business.lede}</p>
        <p class="rb-note">{copy.business.note}</p>

        <label class="rb-label" for="rb-business">{copy.business.businessLabel} <span class="rb-req">*</span></label>
        <input class="rb-input" id="rb-business" type="text" autocomplete="organization" placeholder={copy.business.businessPlaceholder} />

        {existingSite && (
          <div class="rb-fieldset">
            <span class="rb-label" id="legend-existingSite">
              {existingSite.legend} <span class="rb-req">*</span>
            </span>
            {existingSite.hint && <p class="rb-hint">{existingSite.hint}</p>}
            <div
              class="rb-chips"
              role="group"
              aria-labelledby="legend-existingSite"
              data-rb-chips={existingSite.id}
              data-rb-single="true"
            >
              {existingSite.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>
        )}

        <label class="rb-label" for="rb-current">
          {copy.business.websiteLabel} <span class="rb-opt">(optional)</span>
        </label>
        <input class="rb-input" id="rb-current" type="text" autocomplete="url" placeholder={copy.business.websitePlaceholder} />

        {copy.business.contactLabel && (
          <>
            <label class="rb-label" for="rb-contact">
              {copy.business.contactLabel} <span class="rb-opt">(optional)</span>
            </label>
            <input class="rb-input" id="rb-contact" type="text" autocomplete="tel" placeholder={copy.business.contactPlaceholder} />
            <p class="rb-hint">{copy.business.contactHint}</p>
          </>
        )}

        <p class="rb-error" data-rb-error hidden></p>
      </section>

      {category && (
        <section class="rb-step" data-rb-kind="category" hidden>
          <h2 class="rb-title">{category.title}</h2>
          <p class="rb-lede">{category.lede}</p>

          <div class="rb-fieldset">
            <span class="rb-label" id="legend-category">{category.group.legend} <span class="rb-req">*</span></span>
            <div
              class="rb-chips"
              role="group"
              aria-labelledby="legend-category"
              data-rb-chips={category.group.id}
              data-rb-single="true"
            >
              {category.group.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>

          {category.typeLabel && (
            <>
              <label class="rb-label" for="rb-category-other">
                {category.typeLabel} <span class="rb-opt">(optional)</span>
              </label>
              <input class="rb-input" id="rb-category-other" type="text" placeholder={category.typePlaceholder} />
            </>
          )}

          {category.revealGroup && (
            <div id="rb-reveal" hidden>
              <div class="rb-fieldset">
                <span class="rb-label" id="legend-services">
                  {category.revealGroup.legend} <span class="rb-req">*</span>
                </span>
                <div
                  class="rb-chips"
                  role="group"
                  aria-labelledby="legend-services"
                  data-rb-chips={category.revealGroup.id}
                >
                  {Object.entries(SERVICES_BY_CATEGORY).flatMap(([type, options]) =>
                    options.map((option) => (
                      <button
                        type="button"
                        class="rb-chip"
                        data-rb-value={option.value}
                        data-for-category={type}
                        aria-pressed="false"
                        hidden
                      >
                        {option.label}
                      </button>
                    ))
                  )}
                </div>
              </div>

              <label class="rb-label" for="rb-services-other">
                {category.otherLabel} <span class="rb-opt">(optional)</span>
              </label>
              <textarea class="rb-input rb-textarea" id="rb-services-other" rows="3" placeholder={category.otherPlaceholder}></textarea>
            </div>
          )}

          <p class="rb-error" data-rb-error hidden></p>
        </section>
      )}

      {services && (
        <section class="rb-step" data-rb-kind="services" hidden>
          <h2 class="rb-title">{services.title}</h2>
          <p class="rb-lede">{services.lede}</p>

          <div class="rb-fieldset">
            <span class="rb-label" id="legend-services-rebuild">{services.group.legend} <span class="rb-req">*</span></span>
            <div class="rb-chips" role="group" aria-labelledby="legend-services-rebuild" data-rb-chips={services.group.id}>
              {services.group.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>

          <label class="rb-label" for="rb-services-other">
            {services.otherLabel} <span class="rb-opt">(optional)</span>
          </label>
          <textarea class="rb-input rb-textarea" id="rb-services-other" rows="3" placeholder={services.otherPlaceholder}></textarea>

          <p class="rb-error" data-rb-error hidden></p>
        </section>
      )}

      <section class="rb-step" data-rb-kind="usp" hidden>
        <h2 class="rb-title">{copy.usp.title}</h2>
        <p class="rb-lede">{copy.usp.lede}</p>

        {uspChips && (
          <div class="rb-fieldset">
            <span class="rb-label" id="legend-usp">{uspChips.legend}</span>
            <div class="rb-chips" role="group" aria-labelledby="legend-usp" data-rb-chips={uspChips.id}>
              {uspChips.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>
        )}

        <label class="rb-label" for="rb-usp">
          {copy.usp.label} {copy.usp.labelNote && <span class="rb-opt">({copy.usp.labelNote})</span>}
        </label>
        <textarea class="rb-input rb-textarea" id="rb-usp" rows="4" placeholder={copy.usp.placeholder}></textarea>
        <p class="rb-error" data-rb-error hidden></p>
      </section>

      {shape && (
        <section class="rb-step" data-rb-kind="siteType" hidden>
          <h2 class="rb-title">{shape.title}</h2>
          <p class="rb-lede">{shape.lede}</p>

          <div class="rb-fieldset">
            <span class="rb-label" id="legend-siteType">{shape.siteGroup.legend}</span>
            <div class="rb-chips" role="group" aria-labelledby="legend-siteType" data-rb-chips={shape.siteGroup.id}>
              {shape.siteGroup.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>

          <div class="rb-fieldset">
            <span class="rb-label" id="legend-shape-design">{shape.designGroup.legend}</span>
            <div class="rb-chips" role="group" aria-labelledby="legend-shape-design" data-rb-chips={shape.designGroup.id}>
              {shape.designGroup.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>

          <label class="rb-label" for="rb-shape-other">
            {shape.label} <span class="rb-opt">(optional)</span>
          </label>
          <textarea class="rb-input rb-textarea" id="rb-shape-other" rows="2" placeholder={shape.placeholder}></textarea>
          <p class="rb-error" data-rb-error hidden></p>
        </section>
      )}

      {capabilities && (
        <section class="rb-step" data-rb-kind="capabilities" hidden>
          <h2 class="rb-title">{capabilities.title}</h2>
          <p class="rb-lede">{capabilities.lede}</p>

          <div class="rb-tier rb-tier--in">
            <div class="rb-tier-legend rb-tier-legend--in">{capabilities.inScope.legend}</div>
            <p class="rb-tier-body">{capabilities.inScope.body}</p>
            <div class="rb-chips" role="group" aria-label={capabilities.inScope.legend} data-rb-chips={capabilities.inScope.id}>
              {capabilities.inScope.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>

          <div class="rb-tier rb-tier--out">
            <div class="rb-tier-legend rb-tier-legend--out">{capabilities.outScope.legend}</div>
            <p class="rb-tier-body">{capabilities.outScope.body}</p>
            <div class="rb-chips" role="group" aria-label={capabilities.outScope.legend} data-rb-chips={capabilities.outScope.id}>
              {capabilities.outScope.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>

          <div id="rb-integrations-reveal" hidden>
            <div class="rb-fieldset">
              <span class="rb-label" id="legend-integrations">{capabilities.integrationLegend}</span>
              <div class="rb-chips" role="group" aria-labelledby="legend-integrations" data-rb-chips={capabilities.integrationGroup.id}>
                {capabilities.integrationGroup.options.map((option) => (
                  <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                    {option.label}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <label class="rb-label" for="rb-feature-note">
            {capabilities.noteLabel} <span class="rb-opt">(optional)</span>
          </label>
          <textarea class="rb-input rb-textarea" id="rb-feature-note" rows="2" placeholder={capabilities.notePlaceholder}></textarea>

          <p class="rb-error" data-rb-error hidden></p>
        </section>
      )}

      {design && (
        <section class="rb-step" data-rb-kind="design" hidden>
          <h2 class="rb-title">{design.title}</h2>
          <p class="rb-lede">{design.lede}</p>

          <div class="rb-fieldset">
            <span class="rb-label" id="legend-design">{design.group.legend}</span>
            <div class="rb-chips" role="group" aria-labelledby="legend-design" data-rb-chips={design.group.id}>
              {design.group.options.map((option) => (
                <button type="button" class="rb-chip" data-rb-value={option.value} aria-pressed="false">
                  {option.label}
                </button>
              ))}
            </div>
          </div>

          <label class="rb-label" for="rb-design-wishes">
            {design.label} <span class="rb-opt">(optional)</span>
          </label>
          <textarea class="rb-input rb-textarea" id="rb-design-wishes" rows="3" placeholder={design.placeholder}></textarea>
          <p class="rb-error" data-rb-error hidden></p>
        </section>
      )}

      <section class="rb-step" data-rb-kind="assets" hidden>
        <h2 class="rb-title">{copy.assets.title}</h2>
        <p class="rb-lede">{copy.assets.lede}</p>
        <div class="rb-drop" id="rb-drop">
          <input type="file" id="rb-files" multiple accept=".jpg,.jpeg,.png,.webp,.gif,.svg,.pdf,.zip" hidden />
          <p class="rb-drop-title"><strong>{copy.assets.dropStrong}</strong> or <span class="rb-link">{copy.assets.dropLink}</span></p>
          <p class="rb-drop-hint">{copy.assets.dropHint}</p>
        </div>
        <ul class="rb-filelist" id="rb-filelist"></ul>
        <p class="rb-upload" id="rb-upload" hidden>Uploading…</p>
        <label class="rb-label" for="rb-asset-link">
          {copy.assets.linkLabel} <span class="rb-opt">(optional)</span>
        </label>
        <input class="rb-input" id="rb-asset-link" type="text" placeholder={copy.assets.linkPlaceholder} />
        <p class="rb-error" data-rb-error hidden></p>
      </section>

      <section class="rb-step" data-rb-kind="contact" hidden>
        <h2 class="rb-title">{copy.contact.title}</h2>
        <p class="rb-lede">{copy.contact.lede}</p>
        <p class="rb-note">{copy.contact.note}</p>
        <div class="rb-two">
          <div>
            <label class="rb-label" for="rb-first">First name <span class="rb-req">*</span></label>
            <input class="rb-input" id="rb-first" type="text" autocomplete="given-name" placeholder="e.g. Sarah" />
          </div>
          <div>
            <label class="rb-label" for="rb-email">Email <span class="rb-req">*</span></label>
            <input class="rb-input" id="rb-email" type="email" autocomplete="email" placeholder="you@yourbusiness.co.nz" />
          </div>
        </div>
        <label class="rb-consent">
          <input type="checkbox" id="rb-consent" />
          <span>{copy.contact.consent}</span>
        </label>
        <div class="rb-hp" aria-hidden="true">
          <label for="rb-hp">Company website</label>
          <input type="text" id="rb-hp" tabindex="-1" autocomplete="off" />
        </div>
        <p class="rb-error" data-rb-error hidden></p>
      </section>

      <section class="rb-step rb-build" id="rb-build" hidden>
        <BuildStageMachine />

        <div class="rb-build-copy">
          <div class="rb-build-kicker" id="rb-build-kicker">Building your website</div>
          <h2 class="rb-title rb-build-title" id="rb-build-title" aria-live="polite">Reading your brief</h2>
          <p class="rb-build-detail" id="rb-build-detail">Going back over everything you told me.</p>
          <p class="rb-build-aside" id="rb-build-aside">The fun bit starts now.</p>
        </div>

        <ul class="rb-ticker" id="rb-ticker" aria-hidden="true"></ul>

        <div class="rb-build-foot">
          <p class="rb-build-tagline">This may take a while.</p>
          <p class="rb-build-sub">A couple of hours is normal. You do not need to stay on this page — I will email you the moment it is done.</p>
          <div class="rb-build-bar" id="rb-build-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="rb-progress-track">
              <div class="rb-progress-fill rb-build-fill" id="rb-build-fill" style="width:0%"></div>
            </div>
            <span class="rb-build-time" id="rb-build-time">Just started</span>
          </div>
          <p class="rb-build-email" id="rb-build-email">I will email you the moment it is ready.</p>
          <p class="rb-build-fine">Free means free — no invoice, no card, ever.</p>
          <div class="rb-build-actions">
            <button type="button" class="rb-build-toggle" id="rb-build-toggle">Show me more</button>
            <button type="button" class="rb-build-leave" id="rb-build-leave">Leave this page</button>
            <button type="button" class="rb-build-new" id="rb-build-new">Start a different brief</button>
          </div>
        </div>
      </section>
    </div>

    <div class="rb-nav" id="rb-nav">
      <button type="button" class="rb-back" id="rb-back" hidden>Back</button>
      <button type="button" class="btn-cta rb-next" id="rb-next" data-submit-label={copy.submitLabel}>
        {copy.submitLabel}
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>
      </button>
    </div>
  </div>
</div>

<style is:global>
  /* The wizard is a popup, not a page: the shell is capped at whatever height
     the viewport leaves over so the overlay itself never has to scroll. */
  .rb-shell {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    /* Content height when it fits; shrinks (and scrolls internally) when the
       viewport is too short, which is what keeps the overlay scroll-free. */
    flex: 0 1 auto;
    min-height: 0;
    max-height: 100%;
    display: flex;
  }

  .rb-card {
    width: 100%;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
    border-radius: 22px;
    padding: clamp(20px, 3vh, 30px) clamp(20px, 3vw, 32px) clamp(18px, 2.4vh, 26px);
    display: flex;
    flex-direction: column;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55), 0 0 60px rgba(139, 120, 230, 0.1);
  }

  /* `display` in a class beats the UA stylesheet's [hidden] rule, so the head
     and nav stayed on screen behind the success panel — leaving a disabled
     "Sending…" button and a Back button on a step that is already finished. */
  .rb-head[hidden],
  .rb-nav[hidden],
  .rb-step[hidden] {
    display: none;
  }

  .rb-head {
    flex: none;
    margin-bottom: clamp(12px, 2vh, 20px);
  }

  .rb-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--secondary);
    margin-bottom: 12px;
  }

  .rb-progress {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .rb-progress-track {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .rb-progress-fill {
    height: 100%;
    width: 16.6667%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--gradient-start), var(--gradient-end));
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rb-progress-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* The one scrollable region in the whole funnel. The head and the nav are
     flex:none siblings, so the progress bar and the buttons stay put and only
     a step that genuinely cannot fit (a phone in landscape, six uploaded files)
     scrolls. The vh-based floor stops the card resizing between a short step
     and a tall one, and is small enough never to push the card off-screen. */
  .rb-body {
    flex: 1 1 auto;
    min-height: 30vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }

  .rb-body::-webkit-scrollbar {
    width: 6px;
  }

  .rb-body::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
  }

  .rb-title {
    font-size: clamp(22px, 3.4vw, 28px);
    font-weight: 700;
    color: #fff;
    margin: 4px 0 10px;
  }

  .rb-lede {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 22px;
  }

  .rb-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 18px 0 6px;
  }

  .rb-req {
    color: #f87171;
  }

  .rb-opt {
    color: var(--text-dimmed);
    font-weight: 400;
  }

  /* Chip group heading plus its chips. The heading sits straight under the
     lede, so it does not want the full label top margin again. */
  .rb-fieldset {
    display: block;
  }

  .rb-fieldset .rb-label:first-child {
    margin-top: 4px;
  }

  .rb-hint {
    margin: -2px 0 9px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-dimmed);
  }

  .rb-input {
    width: 100%;
    padding: 13px 15px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    font-family: inherit;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .rb-input:focus {
    border-color: rgba(94, 234, 212, 0.55);
    box-shadow: 0 0 0 3px rgba(94, 234, 212, 0.12);
  }

  .rb-textarea {
    resize: vertical;
    min-height: 74px;
    line-height: 1.6;
  }

  .rb-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .rb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 6px;
  }

  .rb-chip {
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 9px 16px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  /* Chips exist for every business type and are filtered by the one picked, so
     `[hidden]` has to win over the button's own display. */
  .rb-chip[hidden] {
    display: none;
  }

  .rb-chip:hover {
    border-color: rgba(139, 120, 230, 0.6);
    color: #fff;
  }

  .rb-chip[aria-pressed='true'] {
    background: linear-gradient(135deg, rgba(139, 120, 230, 0.3), rgba(94, 234, 212, 0.22));
    border-color: rgba(94, 234, 212, 0.65);
    color: #fff;
  }

  /* The two-tier capability block. Each tier states its boundary before it
     offers chips, so nobody ticks "cart" believing they are getting one. */
  .rb-tier {
    margin-bottom: 16px;
    padding: 13px 15px 11px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .rb-tier-legend {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    margin-bottom: 7px;
  }

  .rb-tier-legend--in {
    color: #a7f3d0;
  }

  .rb-tier-legend--out {
    color: #c4b5fd;
  }

  .rb-tier-body {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .rb-tier .rb-chips {
    margin-bottom: 0;
