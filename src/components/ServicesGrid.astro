---
import ServiceCard from './ServiceCard.astro';

const services = [
  {
    icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>',
    iconColor: 'purple' as const,
    title: 'Custom Web Design',
    description: 'Bespoke, conversion-focused websites built from scratch. No templates, no shortcuts. Every design is tailored to your Christchurch brand and your customers.',
    href: '/services/web-design',
  },
  {
    icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>',
    iconColor: 'mint' as const,
    title: 'Local SEO',
    description: 'Get found by customers in Christchurch and Canterbury. We optimize your Google Business Profile, local citations, and on-page SEO so you rank at the top.',
    href: '/services/seo',
  },
  {
    icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
    iconColor: 'purple' as const,
    title: 'Performance Optimization',
    description: 'Sub-second load times guaranteed. We use cutting-edge hosting, image optimization, and code minification so your site never keeps customers waiting.',
    href: '/services/web-development',
  },
  {
    icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>',
    iconColor: 'mint' as const,
    title: 'Mobile-First Development',
    description: 'Over 60% of your customers browse on their phone. Every site we build is designed mobile-first, ensuring a flawless experience on any screen size.',
    href: '/services/web-development',
  },
  {
    icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>',
    iconColor: 'purple' as const,
    title: 'Brand Identity & Strategy',
    description: 'Your brand is more than a logo. We develop complete visual identities, messaging frameworks, and positioning strategies that set you apart.',
    href: '/services/branding',
  },
  {
    icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>',
    iconColor: 'mint' as const,
    title: 'Digital Marketing & Automation',
    description: 'Email campaigns, chatbots, marketing automations, and data-driven strategies that systematically grow your customer base and revenue.',
    href: '/services/custom-applications',
  },
];
---

<section id="services" class="section dm-section dot-pattern reveal">
  <div class="dm-bg" id="dm-services"></div>
  <div class="container" style="position:relative;z-index:1">
    <div class="dm-header">
      <div class="section-label">What We Offer</div>
      <div class="section-title">Everything your business<br />needs <span class="gradient-text">to dominate online.</span></div>
      <p class="section-subtitle">We don't just build websites. We engineer complete digital systems that generate leads, build trust, and grow your revenue on autopilot across Christchurch and New Zealand.</p>
    </div>
    <div class="services-grid">
      {services.map(service => (
        <ServiceCard
          icon={service.icon}
          iconColor={service.iconColor}
          title={service.title}
          description={service.description}
          href={service.href}
        />
      ))}
    </div>
    <div style="text-align:center;margin-top:48px">
      <a href="/services/web-design" class="btn-cta" style="display:inline-flex;align-items:center;gap:8px;padding:14px 32px;font-size:15px">
        View All Services
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
      </a>
    </div>
  </div>
</section>
