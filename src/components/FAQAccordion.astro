---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FAQItem[];
  id?: string;
}

const { items, id = 'faq' } = Astro.props;

const plusIcon = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>';
---

<section id={id} class="section dot-pattern reveal">
  <div class="container">
    <div style="text-align:center;margin-bottom:16px">
      <div class="section-label" style="display:inline-flex">FAQ</div>
    </div>
    <div class="section-title" style="text-align:center">
      Got <span class="gradient-text">questions?</span>
    </div>
    <p class="section-subtitle" style="text-align:center;margin:0 auto">
      Here are the answers to the things Christchurch business owners ask us most about web design, SEO, and digital marketing.
    </p>
    <div class="faq-list">
      {items.map(item => (
        <div class="faq-item">
          <button class="faq-q">
            {item.question}
            <span set:html={plusIcon} />
          </button>
          <div class="faq-a">
            <p>{item.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
import { initFaqToggle } from './scripts/faq-toggle';
document.addEventListener('DOMContentLoaded', initFaqToggle);
</script>
