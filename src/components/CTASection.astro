<section id="contact" class="section cta-section dm-section dot-pattern reveal">
  <div class="dm-bg" id="dm-cta"></div>
  <div class="container" style="position:relative;z-index:1">
    <div class="cta-box glass">
      <h2>Start with a <span class="gradient-text">free concept website.</span></h2>
      <p>
        No quote, no proposal, no obligation. Tell me your business and I will build you a working concept on a
        private link, so you can judge the work instead of the pitch. If you want the files afterwards, they
        are yours.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="/website/" class="btn-cta" style="font-size:17px;padding:16px 40px">
          Get Your Free Concept
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>
        </a>
        <a href="/how-it-works/" class="btn-ghost" style="font-size:15px;padding:16px 32px;text-decoration:none">
          See how it works
        </a>
      </div>
      <p style="margin:22px 0 0;font-size:13px;color:var(--text-muted)">
        Private link · not published · not indexed · source files on request
      </p>
    </div>
  </div>
</section>
