---
import ProcessStep from './ProcessStep.astro';

const steps = [
  {
    number: 1,
    color: 'purple' as const,
    title: 'You tell me the business',
    description:
      'Name, and a website or social page if you have one. There is no long brief and no discovery call before you see something.',
  },
  {
    number: 2,
    color: 'mint' as const,
    title: 'I build a real concept',
    description:
      'From public information only. No invented testimonials, no made-up contact details, no filler — and I check it on mobile before you see it.',
  },
  {
    number: 3,
    color: 'purple' as const,
    title: 'You tell me what is wrong',
    description:
      'It is a working site, not a mockup. Say what is inaccurate, missing, or badly worded and I revise it based on what you actually said.',
  },
  {
    number: 4,
    color: 'mint' as const,
    title: 'Files, or we keep going',
    description:
      'Take the source files and stop there, or talk about putting it live properly. Either answer is fine and neither is a trap.',
  },
];
---

<section id="process" class="section reveal" style="background:#0A0A0E;border-top:1px solid rgba(255,255,255,0.04);border-bottom:1px solid rgba(255,255,255,0.04)">
  <div class="container">
    <div style="text-align:center;margin-bottom:16px">
      <div class="section-label" style="display:inline-flex">The Free Concept</div>
    </div>
    <div class="section-title" style="text-align:center">
      Four steps, and you see<br /><span class="gradient-text">something real at the end.</span>
    </div>
    <p class="section-subtitle" style="text-align:center;margin:0 auto">
      The whole process is designed so you are judging actual work rather than a promise about work.
    </p>
    <div class="process-grid">
      {steps.map(step => (
        <ProcessStep
          number={step.number}
          color={step.color}
          title={step.title}
          description={step.description}
        />
      ))}
    </div>
  </div>
</section>
