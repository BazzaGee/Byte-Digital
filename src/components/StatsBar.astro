---
const stats = [
  { value: '200%+', label: 'Potential lead growth' },
  { value: '<1s', label: 'Target load time' },
  { value: '#1', label: 'Local search potential' },
  { value: '10+', label: 'Industries we serve' },
];
---

<section class="stats-bar reveal">
  <div class="container">
    <div class="stats-grid">
      {stats.map(stat => (
        <div class="stat-item">
          <span class="gradient-text stat-value">{stat.value}</span>
          <p>{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
