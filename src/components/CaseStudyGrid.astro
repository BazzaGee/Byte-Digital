---
const caseStudies = [
  {
    badge: 'Live · PWA & HealthTech',
    badgeColor: 'mint',
    title: 'CookTwo — Adaptive Nutrition App',
    slug: 'case-studies/cooktwo',
    description: 'A real-time, AI-powered progressive web app we designed, engineered, and launched for couples with different dietary goals. One meal, two personalised plates, with sub-100ms live sync and a multi-provider AI chain — live in production today.',
    features: [
      'Installable Progressive Web App (PWA)',
      'Real-time sync under 100ms via WebSockets',
      'Multi-provider AI with automatic failover',
      'Edge architecture across 300+ cities',
    ],
    gradient: 'rgba(94,234,212,0.05)',
    visualBg: 'linear-gradient(135deg, #0d1a1a 0%, #0A0A0E 50%, #0f1520 100%)',
    iconSvg: '<svg width="64" height="64" fill="none" stroke="#5EEAD4" viewBox="0 0 24 24" style="opacity:0.6"><rect x="5" y="2" width="14" height="20" rx="2" stroke-width="1.2"/><line x1="12" y1="18" x2="12" y2="18" stroke-width="1.2"/></svg>',
    metrics: [
      { label: 'Sync', value: '100ms' },
      { label: 'AI', value: '3 providers' },
    ],
    reversed: false,
    live: true,
  },
  {
    badge: 'Roofing & Trades',
    badgeColor: 'purple',
    title: 'Lead Generation That Works',
    slug: 'case-studies',
    description: 'A custom "Get a Quote" flow and trust-building design can increase your monthly inbound leads by 200%+. Imagine your phone ringing with qualified enquiries instead of chasing work.',
    features: [
      'High-Contrast Modern UI',
      'Sub-second Page Load Speed',
      'Automated Lead Capture',
      '200%+ potential lead increase',
    ],
    gradient: 'rgba(139,120,230,0.05)',
    visualBg: 'linear-gradient(135deg, #1a1030 0%, #0A0A0E 50%, #0d1a1a 100%)',
    iconSvg: '<svg width="64" height="64" fill="none" stroke="#8B78E6" viewBox="0 0 24 24" style="opacity:0.6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>',
    metrics: [
      { label: 'Leads', value: '200%+' },
      { label: 'Load Time', value: '<1s' },
    ],
    reversed: false,
  },
  {
    badge: 'Healthcare & Clinics',
    badgeColor: 'mint',
    title: 'Booking Systems That Save Time',
    slug: 'case-studies',
    description: 'An integrated online booking system can save 10+ hours per week at your front desk. Position your practice as the most professional and advanced in your area.',
    features: [
      'Premium Professional Aesthetic',
      'Integrated Booking System',
      'Page-one Google rankings',
      '10+ hrs/week saved on admin',
    ],
    gradient: 'rgba(94,234,212,0.05)',
    visualBg: 'linear-gradient(135deg, #0d1a1a 0%, #0A0A0E 50%, #0f1520 100%)',
    iconSvg: '<svg width="64" height="64" fill="none" stroke="#5EEAD4" viewBox="0 0 24 24" style="opacity:0.6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>',
    metrics: [
      { label: 'Ranking', value: '#1' },
      { label: 'Hours Saved', value: '10+/wk' },
    ],
    reversed: true,
  },
  {
    badge: 'Local Services',
    badgeColor: 'purple',
    title: 'From Few Quotes to Many',
    slug: 'case-studies',
    description: 'An instant quote calculator and professional website can transform your enquiry rate. Going from 3 quotes a month to 30+ is what we help service businesses achieve.',
    features: [
      'Instant Quote Calculator',
      'Service Area Mapping',
      '900% potential increase in quotes',
      'Google Maps integration',
    ],
    gradient: 'rgba(139,120,230,0.05)',
    visualBg: 'linear-gradient(135deg, #0f1520 0%, #0A0A0E 50%, #1a1030 100%)',
    iconSvg: '<svg width="64" height="64" fill="none" stroke="#8B78E6" viewBox="0 0 24 24" style="opacity:0.6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/></svg>',
    metrics: [
      { label: 'Quotes', value: '900%+' },
      { label: 'Area', value: 'Local' },
    ],
    reversed: false,
  },
];

const dotColor = (color: string) => {
  return color === 'mint' ? '#5EEAD4' : '#8B78E6';
};
---

<section id="work" class="section reveal" style="background:#0A0A0E;border-top:1px solid rgba(255,255,255,0.04);border-bottom:1px solid rgba(255,255,255,0.04)">
  <div class="container">
    <div class="section-label">Our Work</div>
    <div class="section-title">Real projects & <span class="gradient-text">what's possible.</span></div>
    <p class="section-subtitle">From live, in-production applications to the results Christchurch businesses achieve — see what Byte Digital designs and builds.</p>
    <div class="case-grid">
      {caseStudies.map(cs => (
        <a href={`/${cs.slug}/`} class="case-item" style={`${cs.reversed ? 'direction:rtl' : ''}text-decoration:none;color:inherit`}>
          <div class="case-visual" style={`direction:ltr;background:${cs.visualBg};position:relative;overflow:hidden;min-height:320px;display:flex;flex-direction:column;align-items:center;justify-content:center`}>
            <div style="position:absolute;inset:0;opacity:0.03">
              <svg width="100%" height="100%"><defs><pattern id="cd" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="12" cy="12" r="1" fill="#fff"/></pattern></defs><rect width="100%" height="100%" fill="url("cd")"/></svg>
            </div>
            <div style="position:relative;z-index:1;text-align:center;padding:32px">
              <div set:html={cs.iconSvg} />
              <div style="margin-top:20px;display:flex;gap:24px">
                {cs.metrics.map((m: any) => (
                  <div style="text-align:center">
                    <div style={`font-size:28px;font-weight:700;font-family:'Space Grotesk',sans-serif;color:${dotColor(cs.badgeColor)}`}>{m.value}</div>
                    <div style="font-size:11px;color:#64748B;text-transform:uppercase;letter-spacing:1px;margin-top:4px">{m.label}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div style="direction:ltr">
            <div class={`case-badge ${cs.badgeColor}`}>
              {cs.live && <span class="live-dot" style={`display:inline-block;width:7px;height:7px;border-radius:50%;background:${dotColor(cs.badgeColor)};margin-right:7px;vertical-align:middle;box-shadow:0 0 8px ${dotColor(cs.badgeColor)}`}></span>}
              {cs.badge}
            </div>
            <h3>{cs.title}</h3>
            <p>{cs.description}</p>
            <ul class="case-list">
              {cs.features.map(feature => (
                <li>
                  <div class="dot" style={`background:${dotColor(cs.badgeColor)}`}></div>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </a>
      ))}
    </div>
    <div style="text-align:center;margin-top:48px">
      <a href="/case-studies/" class="btn-cta" style="display:inline-flex;align-items:center;gap:8px;padding:14px 32px;font-size:15px;text-decoration:none">
        See What's Possible
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
      </a>
    </div>
  </div>
</section>
