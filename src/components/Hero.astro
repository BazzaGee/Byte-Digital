---
---

<section class="hero dot-pattern" id="hero">
  <div class="hero-glow1"></div>
  <div class="hero-glow2"></div>
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="hero-badge">
          <div class="hero-badge-dot"></div>
          Christchurch's Premier Digital Agency
        </div>
        <h1 style="margin:24px 0 20px">
          We build websites<br />that <span class="gradient-text">dominate.</span>
        </h1>
        <p>Stop losing customers to competitors with better websites. Byte Digital brings cutting-edge web technology to local businesses across Christchurch and Canterbury. We build lightning-fast, high-converting sites that act as your 24/7 salesperson.</p>
        <div class="hero-btns">
          <a href="/#contact" class="btn-cta">
            Start Growing Today
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
          <a href="/#scroll-video" class="btn-ghost">See It In Action</a>
        </div>
        <div class="hero-checks">
          <span>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Mobile Optimized
          </span>
          <span>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            SEO Ready
          </span>
          <span>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Lightning Fast
          </span>
          <span>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            AI Optimized
          </span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="founder-card glass">
          <div class="founder-image-wrapper">
            <img src="/images/founder.jpg" alt="Barry Grottis, Founder & Lead Developer of Byte Digital" class="founder-image" />
            <div class="founder-image-glow"></div>
          </div>
          <div class="founder-content">
            <h3 class="founder-name">Barry Grottis</h3>
            <p class="founder-title">Founder & Lead Developer</p>
            <p class="founder-bio">
              I've been building websites since 2011—back when mobile-friendly was optional and 'AI' sounded like science fiction. A lot has changed since then, and I've stayed ahead of every curve. Today, I help Christchurch businesses dominate online through cutting-edge web design, AI automation, and the latest in SEO and Generative Engine Optimization (GEO). When I'm not digitizing businesses for the 21st century, you'll find me with my family, staying active, or exploring new foods. Let's bring your business into 2026.
            </p>
            <div class="founder-badges">
              <span class="founder-badge">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                Web Design
              </span>
              <span class="founder-badge">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                AI Automation
              </span>
              <span class="founder-badge">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                SEO & GEO
              </span>
            </div>
            <a href="/#contact" class="founder-cta">
              Let's Build Together
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
