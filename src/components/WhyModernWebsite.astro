---
const cards = [
  {
    icon: 'purple',
    glow: 'purple-glow',
    title: 'Conversion-First Design',
    description: 'Every button, image, and text block is scientifically placed to make visitors call you or fill out your quote form. We design for action, not just aesthetics.',
    iconSvg: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>',
  },
  {
    icon: 'mint',
    glow: 'mint-glow',
    title: 'Lightning Fast Speed',
    description: 'If your site takes more than 3 seconds to load, 53% of people leave. We use advanced technology and optimization so your site loads in under 1 second on any device.',
    iconSvg: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
  },
  {
    icon: 'white',
    glow: 'purple-glow',
    title: 'Built for Local SEO',
    description: "Our underlying code is perfectly structured so Google knows exactly where you are and what you do. We optimize for Christchurch and Canterbury searches so you outrank your competition.",
    iconSvg: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>',
  },
];
---

<section id="why-modern" class="svc-row dot-pattern reveal">
  <div class="container">
    <div style="text-align:center;margin-bottom:48px">
      <div class="section-title">Why you need a <span class="gradient-text">Modern Website</span></div>
      <p class="section-subtitle" style="margin:0 auto">Most local business websites look like they were built in 2005. We use cutting-edge design to make you the obvious premium choice in Christchurch and Canterbury.</p>
    </div>
    <div class="svc-row-grid">
      {cards.map(card => (
        <div class={`svc-row-card glass ${card.glow}`}>
          <div class={`svc-row-icon ${card.icon}`} set:html={card.iconSvg} />
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
