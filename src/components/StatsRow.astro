---
interface Stat {
  target: number;
  suffix: string;
  decimals?: number;
  label: string;
}

const stats: Stat[] = [
  { target: 200, suffix: '%+', label: 'Potential Lead Growth' },
  { target: 1, suffix: 's', decimals: 1, label: 'Target Load Time' },
  { target: 100, suffix: '%', label: 'SEO Best Practices' },
  { target: 10, suffix: '+', label: 'Industries Served' },
];
---

<section class="stats-row reveal">
  <div class="container">
    <div class="stats-row-grid">
      {stats.map(stat => (
        <div class="stat-card glass">
          <div
            class="stat-num"
            data-target={stat.target}
            data-suffix={stat.suffix}
            data-decimals={stat.decimals ?? 0}
          >
            0{stat.suffix}
          </div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
