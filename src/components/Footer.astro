---
const currentYear = new Date().getFullYear();

const serviceLinks = [
  { href: '/services/web-design/', label: 'Web Design' },
  { href: '/services/seo/', label: 'Local SEO' },
  { href: '/services/web-development/', label: 'Web Development' },
  { href: '/services/branding/', label: 'Brand Strategy' },
  { href: '/services/ecommerce/', label: 'eCommerce' },
  { href: '/services/local-seo/', label: 'Local SEO Pro' },
  { href: '/services/wordpress-development/', label: 'WordPress Dev' },
  { href: '/services/logo-design/', label: 'Logo Design' },
  { href: '/services/custom-applications/', label: 'Custom Apps' },
  { href: '/services/website-maintenance/', label: 'Maintenance' },
];

const companyLinks = [
  { href: '/about/', label: 'About Us' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/blog/', label: 'Blog' },
  { href: '/guides/web-design-christchurch-2026/', label: 'Free Guides' },
  { href: '/contact/', label: 'Contact' },
];

const areasLinks = [
  { href: '/locations/', label: 'All Service Areas' },
  { href: '/locations/riccarton/', label: 'Riccarton' },
  { href: '/locations/papanui/', label: 'Papanui' },
  { href: '/locations/halswell/', label: 'Halswell' },
  { href: '/locations/linwood/', label: 'Linwood' },
  { href: '/locations/merivale/', label: 'Merivale' },
  { href: '/locations/sumner/', label: 'Sumner' },
];

const toolsLinks = [
  { href: '/tools/website-cost-calculator/', label: 'ROI Calculator' },
  { href: '/tools/free-website-audit/', label: 'Free Website Audit' },
  { href: '/tools/seo-roi-calculator/', label: 'SEO ROI Calculator' },
  { href: '/contact/', label: 'Free Consultation' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <div class="nav-logo" style="font-size:22px;margin-bottom:12px">
          <span style="color:#8B78E6">BYTE</span><span style="color:#5EEAD4">DIGITAL</span>
        </div>
        <p>Premium web design &amp; digital marketing for local businesses who want to dominate their market. Christchurch, Canterbury, New Zealand.</p>
        <p style="margin-top:12px">
          <a href="mailto:barry@bytedigital.co.nz" style="color:var(--text-muted);text-decoration:none">barry@bytedigital.co.nz</a>
        </p>
      </div>
      <div>
        <h4>Services</h4>
        <ul style="column-count:2;column-gap:8px;list-style:none;padding:0;margin:0">
          {serviceLinks.map(link => (
            <li style="break-inside:avoid;margin-bottom:4px"><a href={link.href} style="font-size:13px">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          {companyLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Areas We Serve</h4>
        <ul>
          {areasLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Free Tools</h4>
        <ul>
          {toolsLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {currentYear} Byte Digital. All rights reserved.</p>
      <div style="display:flex;gap:24px">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-service/">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<div class="footer-brand">
  <div class="mini-logo-grid">
    <div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-active" style="--active-color:#8B78E6;animation-delay:0.1s"></div><div class="mini-dot-active" style="--active-color:#8B78E6;animation-delay:0.2s"></div><div class="mini-dot-blank"></div><div class="mini-dot-blank"></div><div class="mini-dot-active" style="--active-color:#5EEAD4;animation-delay:1.1s"></div><div class="mini-dot-active" style="--active-color:#5EEAD4;animation-delay:1.2s"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div>
    <div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-active" style="--active-color:#8B78E6;animation-delay:0.3s"></div><div class="mini-dot-blank"></div><div class="mini-dot-active" style="--active-color:#8B78E6;animation-delay:0.4s"></div><div class="mini-dot-blank"></div><div class="mini-dot-active" style="--active-color:#5EEAD4;animation-delay:1.3s"></div><div class="mini-dot-blank"></div><div class="mini-dot-active" style="--active-color:#5EEAD4;animation-delay:1.4s"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div>
    <div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-active" style="--active-color:#8B78E6;animation-delay:0.5s"></div><div class="mini-dot-active" style="--active-color:#8B78E6;animation-delay:0.6s"></div><div class="mini-dot-blank"></div><div class="mini-dot-blank"></div><div class="mini-dot-active" style="--active-color:#5EEAD4;animation-delay:1.5s"></div><div class="mini-dot-blank"></div><div class="mini-dot-active" style="--active-color:#5EEAD4;animation-delay:1.6s"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div><div class="mini-dot-faint"></div>
