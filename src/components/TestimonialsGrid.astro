---
import TestimonialCard from './TestimonialCard.astro';

const testimonials = [
  {
    quote: "Imagine your phone ringing more within the first week. A professional website that positions you as the premium choice in your industry -- that's what we deliver for Christchurch businesses.",
    authorName: 'What You Can Expect',
    authorBusiness: 'Professional Web Presence',
    authorInitial: 'W',
    avatarColor: 'purple' as const,
  },
  {
    quote: "Your customers choosing you over competitors because your website builds instant trust and credibility. A booking or enquiry system that saves hours of admin time every week.",
    authorName: 'What You Can Expect',
    authorBusiness: 'Conversion-Focused Design',
    authorInitial: 'W',
    avatarColor: 'mint' as const,
  },
  {
    quote: "Going from a handful of quote requests to a steady stream of qualified leads. A website that works as hard for your business as you do -- that's our promise.",
    authorName: 'What You Can Expect',
    authorBusiness: 'Lead Generation Results',
    authorInitial: 'W',
    avatarColor: 'purple' as const,
  },
];
---

<section class="section dm-section dot-pattern reveal">
  <div class="dm-bg" id="dm-testimonials"></div>
  <div class="container" style="position:relative;z-index:1">
    <div class="dm-header" style="text-align:center">
      <div class="section-label" style="display:inline-flex">What You Can Expect</div>
      <div class="section-title">Results your business<br />can <span class="gradient-text">achieve with us.</span></div>
    </div>
    <div class="testimonials-grid">
      {testimonials.map(t => (
        <TestimonialCard
          quote={t.quote}
          authorName={t.authorName}
          authorBusiness={t.authorBusiness}
          authorInitial={t.authorInitial}
          avatarColor={t.avatarColor}
        />
      ))}
    </div>
  </div>
</section>
