---
import { BUILD_STAGES, STAGE_ICONS } from './scripts/build-timeline';

// One SVG per stage, all rendered up front and cross-faded by data-active.
// Nothing is added or removed from the DOM as stages advance, so the graphic
// never reflows — which is what lets the whole step stay scroll-free on a
// phone.
const CIRCUMFERENCE = 2 * Math.PI * 52;
---

<div class="rb-viz" id="rb-viz" aria-hidden="true">
  {BUILD_STAGES.map((stage, index) => (
    <div class="rb-viz-stage" data-build-stage={index}>
      <svg viewBox="0 0 120 120" class="rb-viz-svg">
        <circle class="rb-viz-track" cx="60" cy="60" r="52" />
        <circle class="rb-viz-arc" cx="60" cy="60" r="52" data-build-arc />
        <circle class="rb-viz-halo" cx="60" cy="60" r="38" />
        <g class="rb-viz-orbit">
          <circle cx="60" cy="8" r="2.4" />
          <circle cx="105" cy="86" r="2.4" />
          <circle cx="15" cy="86" r="2.4" />
        </g>
        <g
          class="rb-viz-glyph"
          transform="translate(60 60) scale(1.9) translate(-12 -12)"
          set:html={STAGE_ICONS[stage.icon]}
        />
      </svg>
    </div>
  ))}
</div>

<style>
  .rb-viz {
    position: relative;
    width: min(42vw, 190px, 30vh);
    max-width: 100%;
    aspect-ratio: 1;
    margin: 0 auto;
    color: var(--secondary);
  }

  .rb-viz-stage {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
    pointer-events: none;
  }

  .rb-viz-stage[data-active] {
    opacity: 1;
    transform: scale(1);
  }

  .rb-viz-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rb-viz-track {
    stroke: rgba(255, 255, 255, 0.08);
    stroke-width: 2.5;
  }

  .rb-viz-arc {
    stroke: var(--secondary);
    stroke-width: 2.5;
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(-90deg);
    transition: stroke-dasharray 0.9s linear;
  }

  .rb-viz-halo {
    fill: rgba(94, 234, 212, 0.06);
    stroke: none;
    transform-box: fill-box;
    transform-origin: center;
    animation: rb-halo 4.5s ease-in-out infinite;
  }

  .rb-viz-orbit {
    fill: currentColor;
    stroke: none;
    transform-box: view-box;
    transform-origin: 50% 50%;
    animation: rb-orbit 14s linear infinite;
    opacity: 0.75;
  }

  .rb-viz-glyph {
    stroke-width: 1.6;
  }

  @keyframes rb-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes rb-halo {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.08);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rb-viz-stage {
      transition: none;
      transform: none;
    }

    .rb-viz-orbit,
    .rb-viz-halo {
      animation: none;
    }
  }

  /* Compact state: the stage machine shrinks to a small inline badge.
     Scoped here so the wizard only has to toggle the class. */
  :global(.rb-build--compact) .rb-viz {
    width: 42px;
    min-width: 42px;
    margin: 0;
  }

  :global(.rb-build--compact) .rb-viz-orbit {
    display: none;
  }

  /* Landscape phones and short windows: the graphic yields to the copy. */
  @media (max-height: 620px) {
    .rb-viz {
      width: min(30vw, 120px, 22vh);
    }
  }
</style>
