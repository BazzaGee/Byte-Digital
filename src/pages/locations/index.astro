---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import CTASection from '../../components/CTASection.astro';
import PageHero from '../../components/PageHero.astro';
import { SUBURBS } from '../../data/locations';
import { LADDER } from '../../data/ladder';

const freeStep = LADDER.find((s) => s.step === 0)!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Christchurch service areas — Byte Digital',
  description:
    'Free concept websites for Christchurch and Canterbury businesses, with local knowledge of each suburb. Remote work available across New Zealand.',
  url: 'https://bytedigital.co.nz/locations/',
  mainEntity: {
    '@type': 'ItemList',
    name: 'Christchurch service areas',
    numberOfItems: SUBURBS.length,
    itemListElement: SUBURBS.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Free concept website for ${s.name} businesses`,
      url: `https://bytedigital.co.nz/locations/${s.slug}/`,
    })),
  },
};
---

<BaseLayout
  title="Christchurch Web Design & Free Concept Websites | Byte Digital"
  description="I am based in Christchurch and work with businesses across New Zealand. Local knowledge of 20 Christchurch suburbs, and the same free concept offer for everyone."
  jsonLd={jsonLd}
>
  <PageHero
    label="Where I work"
    title="Based in Christchurch,<br />working <span class='gradient-text'>NZ-wide.</span>"
    subtitle="I am one person in Christchurch, and the local pages here are written from what is actually in each suburb rather than a template with the name swapped. That is also why the free concept offer is identical whether you are in Riccarton or Ruakura."
  />

  <section class="section" style="padding-top:48px;background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div style="max-width:720px;margin:0 auto 40px;text-align:center">
        <div class="section-label" style="justify-content:center">Christchurch</div>
        <h2 style="font-size:clamp(26px,3.6vw,34px);font-weight:700;margin:10px 0 16px">
          Local knowledge, <span class="gradient-text">area by area</span>
        </h2>
        <p style="font-size:16px;line-height:1.75;color:var(--text-secondary)">
          Each page below covers a real, specific market — the landmarks, the business mix, and how people there
          actually search. Pick yours, or skip straight to the free offer.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px">
        {SUBURBS.map((s) => (
          <a href={`/locations/${s.slug}/`} class="glass" style="display:block;padding:24px 22px;border-radius:16px;text-decoration:none;transition:transform 0.2s,border-color 0.2s">
            <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:8px">
              <h3 style="font-size:17px;font-weight:600;margin:0;color:#fff">{s.name}</h3>
            </div>
            <p style="margin:0 0 14px;font-size:14px;line-height:1.6;color:var(--text-muted)">{s.summary}</p>
            <span style="display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:#5EEAD4">
              Free concept for {s.name}
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Divider />

  <section class="section reveal section-glow" style="background:var(--bg-dark);border-top:1px solid var(--border-subtle)">
    <div class="glow-orb mint bottom-right"></div>
    <div class="container" style="position:relative;z-index:1">
      <div style="max-width:820px;margin:0 auto">
        <div style="text-align:center;margin-bottom:40px">
          <div class="section-label" style="display:inline-flex">The rest of New Zealand</div>
          <h2 style="font-size:clamp(26px,3.6vw,34px);font-weight:700;margin:10px 0 16px">
            Being based here is <span class="gradient-text">not a restriction</span>
          </h2>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px">
          <div class="glass" style="padding:26px 24px;border-radius:16px">
            <h3 style="font-size:17px;font-weight:600;margin:0 0 12px;color:#fff">The work is entirely remote</h3>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--text-muted)">
              Everything happens online: the free concept, the revisions, the handover, the ongoing work. There
              is no reason a business in Auckland, Wellington, or Dunedin would get a worse result than one in
              Christchurch.
            </p>
          </div>
          <div class="glass" style="padding:26px 24px;border-radius:16px">
            <h3 style="font-size:17px;font-weight:600;margin:0 0 12px;color:#fff">The free offer is the same everywhere</h3>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--text-muted)">
              There is no "Christchurch clients only" gate on the concept site. If you are a NZ business, ask
              and you get one. The pages above exist because I can write something genuinely specific about
              these suburbs, not because I refuse to work elsewhere.
            </p>
          </div>
          <div class="glass" style="padding:26px 24px;border-radius:16px">
            <h3 style="font-size:17px;font-weight:600;margin:0 0 12px;color:#fff">Where I will push back</h3>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--text-muted)">
              If I am not the right fit — if you need something I cannot deliver properly, or a market that
              needs a specialist — I will say so and point you somewhere better. Turning work down is cheaper
              than disappointing you later.
            </p>
          </div>
        </div>

        <div class="glass" style="margin-top:24px;padding:26px;border-radius:16px;border-color:rgba(94,234,212,0.25);background:rgba(94,234,212,0.04)">
          <p style="margin:0;font-size:15px;line-height:1.75;color:var(--text-secondary)">
            <strong style="color:#5EEAD4">On local search rankings.</strong> I will not promise you first page
            in a suburb, or a specific number of leads, because nobody honest can. What I do is make sure your
            site is technically sound, your business details are consistent everywhere, and your content is
            accurate — which are the parts you actually control. If you want guarantees, there are plenty of
            agencies happy to make them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <section class="section">
    <div class="container">
      <div style="max-width:780px;margin:0 auto">
        <div style="text-align:center;margin-bottom:36px">
          <div class="section-label" style="display:inline-flex">Questions</div>
          <h2 style="font-size:clamp(24px,3.4vw,32px);font-weight:700;margin:10px 0 0">Working with me</h2>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px">
          {[
            {
              q: 'Do I have to be in Christchurch to get the free concept?',
              a: 'No. The whole offer works identically for any New Zealand business. I ask for your business name and a website or social page, then build from what is publicly available.',
            },
            {
              q: 'Why did you write pages for specific suburbs if you work NZ-wide?',
              a: 'Because I actually live here and know these places, so the content can be genuinely specific — Westfield Riccarton, the University, Edgeware Village, the Hornhub. Generic location pages get ignored by search engines because they add nothing. These add something, so they are worth keeping.',
            },
            {
              q: 'Will you build me a page for my town as well?',
              a: 'If I can write something honest and specific about it, yes, and I will. If the honest answer is that I do not know the local market well enough to write anything useful, I will tell you that instead of generating filler.',
            },
            {
              q: 'Do you charge for the local pages?',
              a: 'No. Reading them is free and there is nothing to buy. The free concept is the only thing I am asking you to consider, and even that costs you nothing.',
            },
            {
              q: 'Can I meet in person?',
              a: 'If you are in Christchurch, yes, happy to. Everything else is handled remotely and I would not want you to drive in for something that an email or call handles better.',
            },
          ].map((item) => (
            <div class="glass" style="padding:24px 26px;border-radius:16px">
              <h3 style="font-size:16px;font-weight:600;margin:0 0 10px;color:#fff">{item.q}</h3>
              <p style="margin:0;font-size:14px;line-height:1.75;color:var(--text-muted)">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>
