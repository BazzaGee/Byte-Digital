---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import PageHero from '../../components/PageHero.astro';
import SectionAccent from '../../components/SectionAccent.astro';
import { getCollection } from 'astro:content';
import { LADDER } from '../../data/ladder';

const studies = (await getCollection('case-studies')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const steps = LADDER.filter((s) => s.step > 0);
const freeStep = LADDER.find((s) => s.step === 0)!;
---

<BaseLayout
  title="Work & Proof | Byte Digital"
  description="Real systems built by Byte Digital: CookTwo, the website pipeline behind the free concepts, and the AI assistant running on this site. No invented testimonials or fabricated results."
>
  <PageHero
    label="Work &amp; Proof"
    title="Things that are <span class='gradient-text'>real.</span>"
    subtitle="I have not done paid client work yet, so there is no wall of testimonials here. What there is are systems I built that are genuinely running, and you can go and check any of them."
  />

  <section class="section" style="padding-top:48px;background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:32px;justify-content:center;flex-wrap:wrap">
        <div class="section-label" style="margin:0">Live product</div>
        <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#34d399;background:rgba(52,211,153,0.08);border:1px solid rgba(52,211,153,0.25)">
          <span style="width:7px;height:7px;border-radius:50%;background:#34d399;box-shadow:0 0 8px #34d399"></span> Live &amp; In Production
        </span>
      </div>

      <div class="glass cooktwo-hero" style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-radius:24px;overflow:hidden;border:1px solid var(--border-subtle)">
        <div style="padding:48px;display:flex;flex-direction:column;justify-content:center">
          <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap">
            <span style="display:inline-block;padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--secondary);background:rgba(94,234,212,0.08);border:1px solid rgba(94,234,212,0.2)">PWA · HealthTech</span>
            <span style="display:inline-block;padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#c4b5fd;background:rgba(139,120,230,0.08);border:1px solid rgba(139,120,230,0.2)">Real-Time · AI</span>
          </div>
          <h2 style="font-size:32px;font-weight:700;margin:0 0 14px;font-family:'Space Grotesk',sans-serif;line-height:1.15">CookTwo — adaptive nutrition app for couples</h2>
          <p style="color:var(--text-muted);line-height:1.7;margin:0 0 24px;font-size:16px">A real-time, AI-powered progressive web app that lets two partners with different goals cook one meal together, plated two ways. Designed, engineered, and launched end-to-end by Byte Digital — and live today.</p>
          <p style="color:var(--text-dimmed);line-height:1.7;margin:0 0 24px;font-size:14px">
            To be precise about what those numbers are: they describe how the system was built, not how well the
            business is doing. It is a working product I can point at, not a case study proving commercial results.
          </p>
          <div style="display:flex;gap:28px;margin-bottom:28px;flex-wrap:wrap">
            <div><div style="font-size:26px;font-weight:700;color:#5EEAD4;font-family:'Space Grotesk',sans-serif">100ms</div><div style="font-size:11px;color:var(--text-dimmed);text-transform:uppercase;letter-spacing:1px">Real-time sync</div></div>
            <div><div style="font-size:26px;font-weight:700;color:#5EEAD4;font-family:'Space Grotesk',sans-serif">3</div><div style="font-size:11px;color:var(--text-dimmed);text-transform:uppercase;letter-spacing:1px">AI providers</div></div>
            <div><div style="font-size:26px;font-weight:700;color:#5EEAD4;font-family:'Space Grotesk',sans-serif">300+</div><div style="font-size:11px;color:var(--text-dimmed);text-transform:uppercase;letter-spacing:1px">Edge locations</div></div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:12px">
            <a href="/case-studies/cooktwo/" class="btn-cta" style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;font-size:15px;text-decoration:none">View the breakdown</a>
            <a href="https://cooktwo.com" target="_blank" rel="noopener" class="btn-ghost" style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;font-size:15px;text-decoration:none">
              Visit cooktwo.com
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
            </a>
          </div>
        </div>
        <div style="background:linear-gradient(135deg,#0d0d12,#13131c);display:flex;align-items:center;justify-content:center;padding:40px;gap:16px">
          <img src="/images/work/cooktwo/02-pantry.webp" alt="CookTwo pantry AI screen" loading="lazy" style="width:43%;border-radius:14px;border:1px solid rgba(255,255,255,0.08);box-shadow:0 20px 50px rgba(0,0,0,0.5)" />
          <img src="/images/work/cooktwo/03-adaptive-meal.webp" alt="CookTwo adaptive meal screen" loading="lazy" style="width:43%;border-radius:14px;border:1px solid rgba(255,255,255,0.08);box-shadow:0 20px 50px rgba(0,0,0,0.5);transform:translateY(28px)" />
        </div>
      </div>
    </div>
  </section>

  <SectionAccent wide />

  <section class="section reveal" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div style="max-width:760px;margin:0 auto 44px;text-align:center">
        <div class="section-label" style="justify-content:center">Also running now</div>
        <h2 class="section-title" style="margin:0 auto 16px">The systems behind <span class="gradient-text">this site</span></h2>
        <p class="section-subtitle" style="margin:0 auto">These are less visible than a product launch, but they are the reason the free concept offer is possible at all.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;max-width:960px;margin:0 auto">
        <div class="glass" style="padding:28px 26px;border-radius:18px">
          <span style="display:inline-block;padding:4px 11px;border-radius:999px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#4ade80;background:rgba(34,197,94,0.14);border:1px solid rgba(34,197,94,0.3)">Running now</span>
          <h3 style="font-size:18px;font-weight:600;margin:14px 0 10px;color:#fff">The website pipeline</h3>
          <p style="margin:0;font-size:14px;line-height:1.7;color:var(--text-muted)">
            The automated system that generates every free concept site. It uses verified public information
            only, refuses to invent contact details or testimonials, tracks image licensing, and checks each
            build on mobile before a human sees it. It has produced dozens of builds — including some I then had
            to fix, which is why I would not call it fully autonomous.
          </p>
        </div>

        <div class="glass" style="padding:28px 26px;border-radius:18px">
          <span style="display:inline-block;padding:4px 11px;border-radius:999px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#4ade80;background:rgba(34,197,94,0.14);border:1px solid rgba(34,197,94,0.3)">Running now</span>
          <h3 style="font-size:18px;font-weight:600;margin:14px 0 10px;color:#fff">The assistant on this site</h3>
          <p style="margin:0;font-size:14px;line-height:1.7;color:var(--text-muted)">
            The customer-service assistant in the corner of this page. It knows Byte Digital's services, captures
            the details of anyone who wants to talk, and hands over to me instead of inventing an answer. It is
            the working demonstration behind step three, which is why I am looking for a pilot business to build
            the production version for.
          </p>
        </div>
      </div>
    </div>
  </section>

  <SectionAccent wide />

  <section class="section reveal" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div style="max-width:820px;margin:0 auto">
        <div style="max-width:680px;margin:0 auto 32px;text-align:center">
          <div class="section-label" style="justify-content:center">What I build</div>
          <h2 class="section-title" style="margin:0 auto 16px">The <span class="gradient-text">full path</span></h2>
          <p class="section-subtitle" style="margin:0 auto">CookTwo and the pipeline are the proof of what I can build. These are the things I build it for.</p>
        </div>

        <div style="display:flex;flex-direction:column;gap:8px">
          <a href={freeStep.href} class="glass" style="padding:16px 20px;border-radius:12px;display:flex;align-items:center;gap:16px;text-decoration:none;border-color:rgba(94,234,212,0.4);background:linear-gradient(90deg,rgba(94,234,212,0.08),transparent)">
            <span style="font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;color:#5EEAD4;width:22px;flex-shrink:0">0</span>
            <span style="font-size:15px;font-weight:500;flex:1;color:#fff">{freeStep.name}</span>
            <span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:rgba(34,197,94,0.14);color:#4ade80">Free</span>
          </a>
          {steps.map((s) => (
            <a href={s.href} class="glass" style="padding:16px 20px;border-radius:12px;display:flex;align-items:center;gap:16px;text-decoration:none">
              <span style="font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;color:var(--text-muted);width:22px;flex-shrink:0">{s.step}</span>
              <span style="font-size:15px;font-weight:500;flex:1;color:var(--text-secondary)">{s.name}</span>
              <span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap;
                background:{s.status === 'live' ? 'rgba(34,197,94,0.14);color:#4ade80' : s.status === 'in-build' ? 'rgba(234,179,8,0.14);color:#facc15' : 'rgba(107,114,128,0.14);color:#9ca3af'}">
                {s.status === 'live' ? 'Live' : s.status === 'in-build' ? 'In build' : 'Later'}
              </span>
            </a>
          ))}
        </div>

        {studies.filter((s) => s.id !== 'cooktwo').length > 0 && (
          <div class="case-grid" style="margin-top:48px">
            {studies.filter((s) => s.id !== 'cooktwo').map((study) => (
              <a href={`/case-studies/${study.id}/`} class="case-item" style="text-decoration:none">
                <div>
                  <div class="case-badge purple">{study.data.industry}</div>
                  <h3>{study.data.title}</h3>
                  <p>{study.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>

<style>
  @media (max-width: 860px) {
    .cooktwo-hero { grid-template-columns: 1fr !important; }
  }
</style>
