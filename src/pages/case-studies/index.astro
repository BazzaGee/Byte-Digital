---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('case-studies')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Case Studies - Real Results for Christchurch Businesses"
  description="See how Byte Digital has transformed websites and digital marketing for businesses across Christchurch and Canterbury. Real results, real growth."
>
  <section style="padding-top:120px;padding-bottom:60px">
    <div class="container">
      <div class="section-label">Case Studies</div>
      <h1 class="section-title">Real Results for<br /><span class="gradient-text">Christchurch Businesses.</span></h1>
      <p class="section-subtitle" style="margin-top:12px">See how we've helped local businesses across Christchurch and Canterbury transform their online presence and generate more leads.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="case-grid">
        {studies.map(study => (
          <a href={`/case-studies/${study.id}`} class="case-item" style="text-decoration:none">
            <div class="case-visual glass" style="background:linear-gradient(135deg,rgba(139,120,230,0.05),transparent);align-items:center;justify-content:center">
              <span style="color:var(--text-dimmed);font-size:14px">{study.data.client}</span>
            </div>
            <div>
              <div class="case-badge purple">{study.data.industry}</div>
              <h3>{study.data.title}</h3>
              <p>{study.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div style="text-align:center;margin-bottom:48px">
        <div class="section-label">Our Services</div>
        <h2 class="section-title" style="margin:0 auto">Explore What We <span class="gradient-text">Offer.</span></h2>
        <p class="section-subtitle" style="margin:0 auto">Every service is designed to help your Christchurch business grow.</p>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;max-width:700px;margin:0 auto">
        <a href="/services/web-design" class="btn-ghost" style="padding:10px 24px;font-size:13px;text-decoration:none">Web Design</a>
        <a href="/services/seo" class="btn-ghost" style="padding:10px 24px;font-size:13px;text-decoration:none">SEO</a>
        <a href="/services/local-seo" class="btn-ghost" style="padding:10px 24px;font-size:13px;text-decoration:none">Local SEO</a>
        <a href="/services/ecommerce" class="btn-ghost" style="padding:10px 24px;font-size:13px;text-decoration:none">eCommerce</a>
        <a href="/services/web-development" class="btn-ghost" style="padding:10px 24px;font-size:13px;text-decoration:none">Web Development</a>
        <a href="/services/wordpress-development" class="btn-ghost" style="padding:10px 24px;font-size:13px;text-decoration:none">WordPress</a>
        <a href="/services/branding" class="btn-ghost" style="padding:10px 24px;font-size:13px;text-decoration:none">Branding</a>
        <a href="/services/website-maintenance" class="btn-ghost" style="padding:10px 24px;font-size:13px;text-decoration:none">Maintenance</a>
      </div>
    </div>
  </section>
</BaseLayout>
