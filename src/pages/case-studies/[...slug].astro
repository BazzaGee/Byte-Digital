---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Divider from '../../components/Divider.astro';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map(study => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { title, client, industry, description, pubDate, tags } = study.data;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Organization", "name": "Byte Digital" },
  "publisher": { "@type": "Organization", "name": "Byte Digital", "url": "https://bytedigital.co.nz" },
  "datePublished": pubDate.toISOString(),
};
---

<BaseLayout title={`${title} | Case Study`} description={description} jsonLd={jsonLd}>
  <section style="padding-top:120px;padding-bottom:40px">
    <div class="container">
      <nav style="margin-bottom:24px;font-size:13px;color:var(--text-muted)">
        <a href="/" style="color:var(--text-muted)">Home</a>
        <span style="margin:0 8px">/</span>
        <a href="/case-studies" style="color:var(--text-muted)">Case Studies</a>
        <span style="margin:0 8px">/</span>
        <span style="color:var(--secondary)">{title}</span>
      </nav>
      <span style="display:inline-block;padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--secondary);background:rgba(94,234,212,0.08);border:1px solid rgba(94,234,212,0.2);margin-bottom:16px">{industry}</span>
      <h1 style="font-size:clamp(32px,5vw,48px);font-weight:700;color:#fff;line-height:1.15;margin-bottom:8px">{title}</h1>
      <p style="font-size:18px;color:var(--text-muted);line-height:1.7;max-width:700px">Client: <strong style="color:#fff">{client}</strong></p>
    </div>
  </section>
  <Divider />
  <article class="section" style="padding-top:40px">
    <div class="container">
      <div class="dm-header">
        <slot />
      </div>
    </div>
  </article>
  <Divider />
  <CTASection />
</BaseLayout>
