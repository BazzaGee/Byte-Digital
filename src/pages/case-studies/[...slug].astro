---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Divider from '../../components/Divider.astro';
import PageHero from '../../components/PageHero.astro';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map(study => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { title, client, industry, description, pubDate, tags } = study.data;
const { Content } = await render(study);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Organization", "name": "Byte Digital" },
  "publisher": { "@type": "Organization", "name": "Byte Digital", "url": "https://bytedigital.co.nz" },
  "datePublished": pubDate.toISOString(),
};
---

<BaseLayout title={`${title} | Case Study`} description={description} jsonLd={jsonLd}>
  <PageHero
    title={title}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Case Studies', href: '/case-studies' },
      { label: title },
    ]}
  >
    <span style="display:inline-block;padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--secondary);background:rgba(94,234,212,0.08);border:1px solid rgba(94,234,212,0.2);margin-bottom:8px;position:relative;z-index:1">{industry}</span>
    <p style="font-size:18px;color:var(--text-muted);line-height:1.7;max-width:700px;position:relative;z-index:1">Client: <strong style="color:#fff">{client}</strong></p>
  </PageHero>
  <Divider />
  <article class="section" style="padding-top:40px">
    <div class="container">
      <div class="dm-header">
        <Content />
      </div>
    </div>
  </article>
  <Divider />
  <CTASection />
</BaseLayout>
