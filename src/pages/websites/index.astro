---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import PageHero from '../../components/PageHero.astro';
import SectionAccent from '../../components/SectionAccent.astro';
import { getCollection } from 'astro:content';

const sites = (await getCollection('websites', ({ data }) => !data.draft))
  .sort((a, b) => b.data.dateAdded.valueOf() - a.data.dateAdded.valueOf());
---

<BaseLayout
  title="Websites We've Built | Byte Digital"
  description="Live business websites generated by Byte Digital as a free concept. Each page is dedicated to one concept site, with a full homepage screenshot and project details."
>
  <PageHero
    label="Concept Sites"
    title="Free concepts our <span class='gradient-text'>pipeline produced.</span>"
    subtitle="These are demonstration sites generated from publicly available business information. They are not client work — the businesses named did not commission them, and have not approved them. They exist to show what the free offer actually produces."
  />

  <div class="container" style="padding-top:32px">
    <div class="glass" style="padding:24px 26px;border-radius:16px;border-color:rgba(234,179,8,0.3);background:rgba(234,179,8,0.05)">
      <p style="margin:0;font-size:15px;line-height:1.75;color:var(--text-secondary)">
        <strong style="color:#facc15">Please read this before opening any of these.</strong> Every site below was
        generated automatically from information that is already public about a real business, as a
        <strong>free concept</strong> — the same process used for the free offer. The business named has
        <strong>not</strong> commissioned this work, has <strong>not</strong> approved it, and is
        <strong>not</strong> affiliated with Byte Digital. Details may be incomplete or wrong, and the sites are
        not maintained. If you are the business named and would like this removed, email
        <a href="mailto:barry@bytedigital.co.nz" style="color:var(--secondary)">barry@bytedigital.co.nz</a> and it
        will come down immediately.
      </p>
    </div>
  </div>

  <div class="container" style="padding-top:28px">
    <div class="glass" style="padding:28px 30px;border-radius:16px;display:flex;flex-wrap:wrap;align-items:center;gap:20px;justify-content:space-between">
      <div style="max-width:560px">
        <h2 style="font-size:24px;font-weight:700;margin:0 0 8px;color:#fff;font-family:'Space Grotesk',sans-serif">Want one of these for your business?</h2>
        <p style="margin:0;font-size:15px;line-height:1.7;color:var(--text-muted)">Answer six quick questions and I will build your website free — no calls, no jargon, no obligation.</p>
      </div>
      <a href="/rebuild/?src=site" class="btn-cta" style="display:inline-flex;align-items:center;gap:8px;padding:15px 34px;font-size:15px;text-decoration:none;white-space:nowrap">
        Build my website free
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>
      </a>
    </div>
  </div>

  <section class="section" style="padding-top:48px;background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      {sites.length === 0 ? (
        <div style="text-align:center;padding:64px 24px;border-radius:20px;border:1px dashed rgba(255,255,255,0.12);background:var(--surface)">
          <h2 style="font-size:24px;font-weight:700;margin:0 0 10px;font-family:'Space Grotesk',sans-serif">New sites landing soon.</h2>
          <p style="color:var(--text-muted);margin:0;line-height:1.7">Approved free concept sites will appear here once they've been synced.</p>
        </div>
      ) : (
        <div class="website-grid">
          {sites.map(site => (
            <a href={`/websites/${site.id}/`} class="glass website-card" style="text-decoration:none;display:flex;flex-direction:column;overflow:hidden;border-radius:20px;border:1px solid var(--border-subtle);color:inherit">
              <div style="aspect-ratio:16/10;overflow:hidden;background:#0d0d12;border-bottom:1px solid rgba(255,255,255,0.06)">
                {site.data.screenshot ? (
                  <img src={site.data.screenshot} alt={`${site.data.title} homepage screenshot`} loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:top;display:block" />
                ) : (
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text-dimmed);font-size:13px">Screenshot coming soon</div>
                )}
              </div>
              <div style="padding:22px 24px 26px;display:flex;flex-direction:column;gap:8px;flex:1">
                {site.data.category && <div class="case-badge mint" style="margin-bottom:0;align-self:flex-start">{site.data.category}</div>}
                <h3 style="font-size:22px;font-weight:700;margin:0;color:#fff;font-family:'Space Grotesk',sans-serif;line-height:1.25">{site.data.title}</h3>
                <p style="font-size:14px;color:var(--text-muted);line-height:1.65;margin:0">{site.data.blurb || site.data.description}</p>
                <span style="margin-top:auto;padding-top:12px;font-size:13px;font-weight:600;color:var(--secondary);display:inline-flex;align-items:center;gap:6px">
                  View website page
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <SectionAccent wide />

  <CTASection />
</BaseLayout>

<style>
  .website-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 28px;
  }
  .website-card {
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .website-card:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 120, 230, 0.4);
  }
</style>
