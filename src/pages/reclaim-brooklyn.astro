---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const businessName = 'Brooklyn Services';

const faqItems = [
  {
    question: 'Why am I seeing this page?',
    answer: "You're seeing this page because a complete website has been custom-built for Brooklyn Services — a full digital asset with 23 live pages, professional design, SEO optimisation, and tailored content targeting Christchurch plumbing and drainage searches. It's ready to start working for your business. Get in touch with Byte Digital to activate it.",
  },
  {
    question: 'What exactly comes with the website?',
    answer: "A complete digital asset: 4 service pages (Plumbing, Drainage, Leak Detection, Utility Locating), 6 location pages covering Christchurch and Canterbury towns, 5 keyword-targeted blog posts, a projects showcase, full SEO infrastructure (schema markup, sitemap, meta tags), professional photography, mobile-first responsive design, and a blazing fast Astro build on Cloudflare CDN. Everything a Christchurch plumbing business needs to be found online.",
  },
  {
    question: 'How is this different from building a new website?',
    answer: "Every other agency will start from zero — quoting you per page for design, content, and SEO setup. This website already exists. 23 pages are already live, already optimised, already targeting the exact search terms your potential customers are typing into Google every day. You're not paying to build something. You're starting from ahead.",
  },
  {
    question: 'What does the ongoing partnership cover?',
    answer: "SEO monitoring and optimisation, monthly reporting showing exactly what's ranking and what traffic is coming in, conversion rate improvement, data-driven content updates (we watch what search terms bring people in, then build more of what works), new blog posts, maintenance, security, and hosting. Everything is included — nothing billed separately. Get in touch to discuss the details.",
  },
  {
    question: 'How do we get started?',
    answer: "Simply fill out the contact form below, send us an email at barry@bytedigital.co.nz, or visit bytedigital.co.nz/contact. We'll get your website fully active on your domain and start the conversation about how to grow it from there.",
  },
  {
    question: 'Can I make changes to the website?',
    answer: "Absolutely. If there's anything you'd like adjusted — colours, content, additional pages, new features, or anything specific to how you want to present Brooklyn Services — we can discuss those during your consultation. This is your asset, built for your business.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "The Digital Edge — Brooklyn Services | Byte Digital",
  "description": "A complete digital asset already built and optimised for Brooklyn Services. 23 live pages, 4 service pages, 6 location pages, 5 blog posts — ready to bring Christchurch plumbing and drainage work to you.",
  "url": "https://bytedigital.co.nz/reclaim-brooklyn",
  "mainEntity": {
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer,
      },
    })),
  },
};
---

<BaseLayout
  title={`The Digital Edge — ${businessName} | Byte Digital`}
  description={`A complete digital asset already built and optimised for ${businessName}. 23 live pages targeting Christchurch plumbing and drainage searches. Contact Byte Digital to activate it.`}
  canonicalURL="https://bytedigital.co.nz/reclaim-brooklyn"
  jsonLd={jsonLd}
>
  <PageHero
    label="Your Website Is Ready"
    title={`Claim Your Website<br /><span class='gradient-text'>${businessName}</span>`}
    subtitle={`A complete, SEO-optimised website has been custom-built for ${businessName} — fully designed, with professional content, ready to attract customers. All it needs is for you to claim it.`}
  />

  <section class="section section-glow" style="padding-top:0">
    <div class="glow-orb purple top-left"></div>
    <div class="glow-orb mint bottom-right"></div>
    <div class="container" style="position:relative;z-index:1">

      <div class="glass" style="padding:40px;border-radius:28px;margin-bottom:48px">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px">
          <div style="width:48px;height:48px;border-radius:50%;background:rgba(251,191,36,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg width="24" height="24" fill="none" stroke="#fbbf24" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <h3 style="font-size:20px;font-weight:700;color:#fff;margin:0">Website Status: Ready to Launch</h3>
            <p style="color:var(--text-muted);font-size:14px;margin:0">Your website is built, optimised, and waiting to go live for your business</p>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px">
          <div style="padding:16px;border-radius:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06)">
            <div style="font-size:12px;font-weight:700;color:var(--text-dimmed);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Business</div>
            <div style="font-size:15px;color:#fff;font-weight:600">{businessName}</div>
          </div>
          <div style="padding:16px;border-radius:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06)">
            <div style="font-size:12px;font-weight:700;color:var(--text-dimmed);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Package</div>
            <div style="font-size:15px;color:#fff;font-weight:600">Full Website</div>
          </div>
          <div style="padding:16px;border-radius:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06)">
            <div style="font-size:12px;font-weight:700;color:var(--text-dimmed);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Status</div>
            <div style="font-size:15px;color:#fbbf24;font-weight:600">Awaiting Claim</div>
          </div>
        </div>
      </div>

      <div class="glass" style="padding:16px;border-radius:28px;margin-bottom:48px;overflow:hidden">
        <div style="height:36px;background:rgba(255,255,255,0.06);border-radius:12px 12px 0 0;display:flex;align-items:center;padding:0 14px;gap:7px;margin:-16px -16px 12px;border-bottom:1px solid rgba(255,255,255,0.08)">
          <div style="width:10px;height:10px;border-radius:50%;background:#ef4444"></div>
          <div style="width:10px;height:10px;border-radius:50%;background:#fbbf24"></div>
          <div style="width:10px;height:10px;border-radius:50%;background:#22c55e"></div>
          <div style="margin-left:12px;height:20px;background:rgba(255,255,255,0.06);border-radius:6px;flex:1;max-width:300px;display:flex;align-items:center;padding:0 10px">
            <span style="font-size:11px;color:var(--text-dimmed);font-family:'Space Grotesk',sans-serif">master.brooklyn-services.pages.dev</span>
          </div>
        </div>
        <img src="/images/brooklyn-services-hero.png" alt="Brooklyn Services website hero section screenshot" style="width:100%;border-radius:12px;display:block" loading="lazy" />
      </div>

      <div style="text-align:center;margin-bottom:16px">
        <h2 style="font-size:clamp(24px,4vw,36px);font-weight:700;color:#fff;margin-bottom:12px">Claim Your Website</h2>
        <p style="color:var(--text-muted);font-size:16px;max-width:600px;margin:0 auto">Get in touch and we'll handle everything. Your website is built, fully optimised, and ready to start working for your business.</p>
      </div>

    </div>
  </section>

  <!-- Stats Bar -->
  <div class="stats-bar reveal">
    <div class="container">
      <div class="stats-grid" style="grid-template-columns:repeat(4,1fr)">
        <div class="stat-item">
          <h3 class="gradient-text">23</h3>
          <p>Live Pages</p>
        </div>
        <div class="stat-item">
          <h3 class="gradient-text">6</h3>
          <p>Location Pages</p>
        </div>
        <div class="stat-item">
          <h3 class="gradient-text">5</h3>
          <p>Blog Posts</p>
        </div>
        <div class="stat-item">
          <h3 class="gradient-text">0</h3>
          <p>WordPress Bloat</p>
        </div>
      </div>
    </div>
  </div>

  <!-- The Inventory -->
  <section class="section reveal" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04);border-bottom:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div style="text-align:center;margin-bottom:56px">
        <div class="section-label">The Inventory</div>
        <h2 class="section-title" style="margin:0 auto 12px">What's Already In <span class="gradient-text">Place</span></h2>
        <p class="section-subtitle" style="margin:0 auto">This site has 23 pages live right now. Not templates. Not wireframes. Real pages, with real content, targeting real search terms that real people type into Google every day in Christchurch and Canterbury.</p>
      </div>

      <div class="feature-grid" style="grid-template-columns:1fr">
        <!-- Service Pages -->
        <div class="glass" style="padding:36px;border-radius:24px;display:flex;gap:32px;align-items:flex-start;flex-wrap:wrap">
          <div style="min-width:80px;text-align:center">
            <div style="font-size:48px;font-weight:700" class="gradient-text">4</div>
            <div class="section-label" style="margin:8px 0 0">Service Pages</div>
          </div>
          <div style="flex:1;min-width:280px">
            <h3 style="font-size:20px;font-weight:700;color:#fff;margin-bottom:8px">Plumbing &middot; Drainage &middot; Leak Detection &middot; Utility Locating</h3>
            <p style="color:var(--text-muted);font-size:14px;line-height:1.7">Each one targets a specific type of work. When someone searches "plumber Christchurch" or "blocked drain clearing Christchurch" or "leak detection Canterbury", these are the pages that show up. Full descriptions, structured data, keyword-optimised — ready to rank.</p>
          </div>
        </div>

        <!-- Location Pages -->
        <div class="glass" style="padding:36px;border-radius:24px;display:flex;gap:32px;align-items:flex-start;flex-wrap:wrap">
          <div style="min-width:80px;text-align:center">
            <div style="font-size:48px;font-weight:700" class="gradient-text">6</div>
            <div class="section-label" style="margin:8px 0 0">Location Pages</div>
          </div>
          <div style="flex:1;min-width:280px">
            <h3 style="font-size:20px;font-weight:700;color:#fff;margin-bottom:8px">Christchurch &middot; Rolleston &middot; Lincoln &middot; Rangiora &middot; Kaiapoi &middot; Ashburton</h3>
            <p style="color:var(--text-muted);font-size:14px;line-height:1.7">Six dedicated pages targeting the areas Brooklyn Services actually works in. When someone in Rangiora searches "drainlayer North Canterbury", or someone in Rolleston looks for "plumber near me" — there's a page built specifically for that. Most competitors have one generic contact page. You have six targeted ones.</p>
          </div>
        </div>

        <!-- Blog Posts -->
        <div class="glass" style="padding:36px;border-radius:24px;display:flex;gap:32px;align-items:flex-start;flex-wrap:wrap">
          <div style="min-width:80px;text-align:center">
            <div style="font-size:48px;font-weight:700" class="gradient-text">5</div>
            <div class="section-label" style="margin:8px 0 0">Blog Posts</div>
          </div>
          <div style="flex:1;min-width:280px">
            <h3 style="font-size:20px;font-weight:700;color:#fff;margin-bottom:8px">Long-form &middot; Keyword-targeted &middot; Question-answering</h3>
            <p style="color:var(--text-muted);font-size:14px;line-height:1.7">Five different ways for people to find you. Hidden water leak warning signs, hot water system comparisons, annual plumbing maintenance checklists, preventing blocked drains, and a Rinnai vs Rheem breakdown — every question a potential client might type into Google has a blog post answering it. Each one is a hook in the water.</p>
          </div>
        </div>

        <!-- Core Pages -->
        <div class="glass" style="padding:36px;border-radius:24px;display:flex;gap:32px;align-items:flex-start;flex-wrap:wrap">
          <div style="min-width:80px;text-align:center">
            <div style="font-size:48px;font-weight:700" class="gradient-text">8</div>
            <div class="section-label" style="margin:8px 0 0">Core Pages</div>
          </div>
          <div style="flex:1;min-width:280px">
            <h3 style="font-size:20px;font-weight:700;color:#fff;margin-bottom:8px">Home &middot; About &middot; Contact &middot; Services Hub &middot; Areas Hub &middot; Blog Hub &middot; Projects &middot; Thank You</h3>
            <p style="color:var(--text-muted);font-size:14px;line-height:1.7">The foundation. Homepage designed to convert, about page that tells the Brooklyn Services story, contact page that makes reaching out easy, a projects showcase featuring real work for Summerset Villages and Ryman Healthcare, plus hub pages that organise everything so both people and Google can find exactly what they need.</p>
          </div>
        </div>
      </div>

      <div class="glass" style="padding:36px;border-radius:24px;margin-top:32px;text-align:center">
        <h3 style="font-size:22px;font-weight:700;color:#fff;margin-bottom:12px">23 Hooks In The Water</h3>
        <p style="color:var(--text-muted);font-size:15px;line-height:1.7;max-width:700px;margin:0 auto">Think of it like this. Every page is a line cast into Google. Right now you've got 23 lines in the water, each one baited with specific keywords and content designed to catch a specific type of search. That's not a small presence — that's a net spread across Christchurch and Canterbury.</p>
      </div>
    </div>
  </section>

  <!-- What a Client Means -->
  <section class="section section-glow reveal">
    <div class="glow-orb purple top-left"></div>
    <div class="glow-orb mint bottom-right"></div>
    <div class="container" style="position:relative;z-index:1">
      <div style="text-align:center;margin-bottom:48px">
        <div class="section-label">The Numbers</div>
        <h2 class="section-title" style="margin:0 auto 12px">What 1 or 2 Clients <span class="gradient-text">Means</span></h2>
      </div>
      <div style="max-width:700px;margin:0 auto">
        <p style="color:var(--text-secondary);font-size:16px;line-height:1.8;margin-bottom:20px">You know what one client is worth to your business. What that number looks like in dollars. What it means for your month. Only you know that figure — and that's exactly the point.</p>
        <p style="color:var(--text-secondary);font-size:16px;line-height:1.8;margin-bottom:20px">This website is built with 5 blog posts, 6 location pages, 4 service pages, full SEO markup, and a technical foundation designed to rank in Christchurch. That's 23 pages working around the clock to bring clients to you.</p>
        <p style="color:var(--text-secondary);font-size:16px;line-height:1.8;margin-bottom:20px">Clients are going to be coming in every month based on how this site is structured and built. Think about what a client is worth to you — then look at what this website is set up to deliver.</p>
        <div class="glass" style="padding:28px;border-radius:20px;margin-top:32px;text-align:center">
          <p style="color:var(--text-muted);font-size:14px;line-height:1.7">You don't need a flood of visitors. You don't need thousands of page views. You need the right people finding you when they're looking for a plumber or drainlayer in Christchurch. This website is built to make that happen — consistently, every month.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="section-accent" style="background:var(--bg-darker)">
    <div class="section-accent-track"></div>
  </div>

  <!-- The Agency Comparison -->
  <section class="section reveal" style="background:var(--bg-dark)">
    <div class="container">
      <div style="text-align:center;margin-bottom:48px">
        <div class="section-label">The Agency Comparison</div>
        <h2 class="section-title" style="margin:0 auto 12px">What Other Agencies Will <span class="gradient-text">Quote You</span></h2>
        <p style="color:var(--text-muted);font-size:16px;max-width:600px;margin:0 auto">Other agencies will pitch you a website built from scratch. They'll quote you per page — design fees, content writing, SEO setup. By the time you've paid for a basic site with no blog, no location pages, no optimisation... you're already thousands of dollars in. And then comes the retainer.</p>
      </div>

      <div style="max-width:700px;margin:0 auto">
        <div class="glass" style="padding:32px;border-radius:24px;margin-bottom:32px">
          <h3 style="font-size:18px;font-weight:700;color:#fff;margin-bottom:20px">What Gets Billed Separately</h3>
          <div style="display:flex;flex-direction:column;gap:16px">
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-radius:12px;background:rgba(255,255,255,0.03)">
              <span style="color:var(--text-secondary);font-size:14px;font-weight:500">Website design & build (5-8 pages)</span>
              <span style="color:var(--text-dimmed);font-size:13px;font-weight:600">Thousands upfront</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-radius:12px;background:rgba(255,255,255,0.03)">
              <span style="color:var(--text-secondary);font-size:14px;font-weight:500">Content writing per page</span>
              <span style="color:var(--text-dimmed);font-size:13px;font-weight:600">Hundreds per page</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-radius:12px;background:rgba(255,255,255,0.03)">
              <span style="color:var(--text-secondary);font-size:14px;font-weight:500">SEO setup & configuration</span>
              <span style="color:var(--text-dimmed);font-size:13px;font-weight:600">Large setup fee</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-radius:12px;background:rgba(255,255,255,0.03)">
              <span style="color:var(--text-secondary);font-size:14px;font-weight:500">Monthly SEO retainer</span>
              <span style="color:var(--text-dimmed);font-size:13px;font-weight:600">Ongoing monthly cost</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-radius:12px;background:rgba(255,255,255,0.03)">
              <span style="color:var(--text-secondary);font-size:14px;font-weight:500">Monthly maintenance & hosting</span>
              <span style="color:var(--text-dimmed);font-size:13px;font-weight:600">Monthly fee</span>
            </div>
          </div>
        </div>

        <div class="glass callout-box callout-highlight" style="text-align:center;padding:28px;border-radius:20px">
          <p style="color:var(--text-secondary);font-size:15px;line-height:1.7;margin:0">That's <strong style="color:#fff">starting from zero</strong>. That's catching up. That's a step backwards.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Reality -->
  <section class="section section-glow reveal">
    <div class="glow-orb purple top-right"></div>
    <div class="glow-orb mint bottom-left"></div>
    <div class="container" style="position:relative;z-index:1">
      <div style="text-align:center;margin-bottom:48px">
        <div class="section-label">The Reality</div>
        <h2 class="section-title" style="margin:0 auto 12px">This Site Is <span class="gradient-text">Already Built</span></h2>
        <p style="color:var(--text-muted);font-size:16px;max-width:600px;margin:0 auto">Every page. Every blog post. Every location. Already live. Already optimised. Already working. 23 pages targeting Christchurch and Canterbury plumbing and drainage searches — right now.</p>
      </div>

      <div class="feature-grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
        <div class="glass" style="padding:28px;border-radius:20px">
          <div class="feature-grid-icon purple" style="margin-bottom:16px">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 style="font-size:17px;font-weight:700;color:#fff;margin-bottom:8px">4 Service Pages</h3>
          <p style="font-size:14px;color:var(--text-muted);line-height:1.65;margin:0">Plumbing, Drainage, Leak Detection, Utility Locating — each with full SEO markup, schema data, and keyword targeting.</p>
        </div>

        <div class="glass" style="padding:28px;border-radius:20px">
          <div class="feature-grid-icon mint" style="margin-bottom:16px">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 style="font-size:17px;font-weight:700;color:#fff;margin-bottom:8px">6 Location Pages</h3>
          <p style="font-size:14px;color:var(--text-muted);line-height:1.65;margin:0">Christchurch, Rolleston, Lincoln, Rangiora, Kaiapoi, Ashburton — each targeting local search intent.</p>
        </div>

        <div class="glass" style="padding:28px;border-radius:20px">
          <div class="feature-grid-icon white" style="margin-bottom:16px">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 style="font-size:17px;font-weight:700;color:#fff;margin-bottom:8px">5 Blog Posts</h3>
          <p style="font-size:14px;color:var(--text-muted);line-height:1.65;margin:0">Long-form, keyword-optimised content — water leak signs, hot water systems, maintenance, blocked drains, Rinnai vs Rheem.</p>
        </div>

        <div class="glass" style="padding:28px;border-radius:20px">
          <div class="feature-grid-icon purple" style="margin-bottom:16px">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </div>
          <h3 style="font-size:17px;font-weight:700;color:#fff;margin-bottom:8px">Full Schema Markup</h3>
          <p style="font-size:14px;color:var(--text-muted);line-height:1.65;margin:0">LocalBusiness, Service, Article, FAQPage, BreadcrumbList — structured data that tells Google exactly what you do and where.</p>
        </div>

        <div class="glass" style="padding:28px;border-radius:20px">
          <div class="feature-grid-icon mint" style="margin-bottom:16px">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 style="font-size:17px;font-weight:700;color:#fff;margin-bottom:8px">Professional Media</h3>
          <p style="font-size:14px;color:var(--text-muted);line-height:1.65;margin:0">Real work photos across plumbing, drainage, leak detection and utility locating — plus client logos from Summerset, Ryman, CCL and more.</p>
        </div>

        <div class="glass" style="padding:28px;border-radius:20px">
          <div class="feature-grid-icon white" style="margin-bottom:16px">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
