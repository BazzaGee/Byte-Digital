<GuidePage title="Christchurch SEO Domination Handbook | Local Search Guide | Byte Digital" description="Master local SEO for Christchurch businesses. Complete guide to Google Business Profile, local citations, on-page SEO, content strategy, and dominating Christchurch search results." jsonLd={jsonLd}>

  <section class="section dot-pattern">
    <div class="container">
      <div class="dm-header">
        <h2 style="font-size:clamp(24px,3vw,36px);font-weight:700;color:#fff;line-height:1.2;margin-bottom:16px">Table of Contents</h2>
        <ol style="padding-left:20px;color:var(--text-secondary);font-size:15px;line-height:2">
          <li><a href="#what-is-local-seo" style="color:var(--secondary)">What is Local SEO and Why Christchurch Businesses Need It</a></li>
