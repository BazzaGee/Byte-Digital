---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import ReactivationWizard from '../components/ReactivationWizard.astro';
import { COPY } from '../data/reactivation-copy';

// The reactivation funnel. Same overlay shell as /website/ — the rb-* global
// classes are shared, so both funnels carry one visual language without
// either page importing the other's component.
const page = COPY.page;
---

<FunnelLayout title={page.title} description={page.description} noindex={true}>
  <div class="rb-overlay">
    <a class="rb-exit" href="/" data-rb-exit aria-label={page.exitLabel}>
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" />
      </svg>
      <span>{page.exitLabel}</span>
    </a>

    <div class="rb-stage">
      <div class="rb-intro">
        <p class="rb-free">{page.badge}</p>
        <h1 set:html={`${page.headingLead}<span class="gradient-text">${page.headingAccent}</span>.`} />
        <p set:html={page.lede} />
      </div>

      <ReactivationWizard />

      <p class="rb-footnote" set:html={page.footnote} />
    </div>
  </div>
</FunnelLayout>

<style is:global>
  .rb-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.4vh, 16px);
    padding: clamp(12px, 2.5vh, 28px) clamp(12px, 3vw, 28px);
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .rb-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.8vh, 20px);
    width: 100%;
    flex: 0 1 auto;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
  }

  .rb-intro {
    text-align: center;
    max-width: 640px;
  }

  .rb-free {
    display: inline-block;
    margin: 0 0 10px;
    padding: 5px 12px;
    border-radius: 999px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--secondary);
    background: rgba(94, 234, 212, 0.08);
    border: 1px solid rgba(94, 234, 212, 0.2);
  }

  .rb-intro h1 {
    margin: 0;
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .rb-intro p {
    margin: 6px 0 0;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .rb-footnote {
    margin: 0;
    font-size: 12px;
    color: var(--text-dimmed);
    text-align: center;
  }

  .rb-exit {
    position: absolute;
    top: clamp(10px, 1.8vh, 18px);
    left: clamp(10px, 2vw, 20px);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    min-height: 38px;
    border-radius: 999px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .rb-exit:hover {
    color: #fff;
    border-color: rgba(94, 234, 212, 0.5);
    background: rgba(94, 234, 212, 0.08);
  }

  @media (max-height: 720px) {
    .rb-intro p:not(.rb-free),
    .rb-footnote {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .rb-exit {
      width: 38px;
      padding: 9px;
      justify-content: center;
    }

    .rb-exit span {
      display: none;
    }

    .rb-intro {
      display: none;
    }
  }
</style>
