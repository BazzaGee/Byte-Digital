---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FreeWebsiteExplainer from '../components/FreeWebsiteExplainer.astro';
import WhyModernWebsite from '../components/WhyModernWebsite.astro';
import Divider from '../components/Divider.astro';
import LadderGrid from '../components/LadderGrid.astro';
import ProcessGrid from '../components/ProcessGrid.astro';
import LiveSystems from '../components/LiveSystems.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTASection from '../components/CTASection.astro';
import BlogCard from '../components/BlogCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { REAL_PROOF } from '../data/ladder';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    category: p.data.category,
    pubDate: p.data.pubDate,
  }));

const faqItems = [
  {
    question: 'What does "free concept website" actually mean?',
    answer:
      'I build a working version of your site using information that is already public about your business, and put it on a private link that only you can see. You tell me what to change, I revise it. If you want the files, they are emailed to you. If you never want to hear from me again, that is a legitimate outcome and I will not chase you.',
  },
  {
    question: 'Why would a business give away the first thing?',
    answer:
      'Because the first thing is nearly free for me to produce — I built the pipeline that generates these sites, so one costs me some compute and a short review. Spending that to find out whether we are a fit beats a sales call, and it means you are judging real work rather than a promise about work.',
  },
  {
    question: 'How long does it take?',
    answer:
      'The build is automatic and usually quick. You review a first version, send back what you want changed, and I revise it. Most people are reviewing something within a day or two of asking. If you are in a hurry, say so and I will prioritise it.',
  },
  {
    question: 'Will my concept site end up on Google?',
    answer:
      'No. It is generated on a platform subdomain and shared through a private, unlisted link that is excluded from search engines and from my sitemap. Nothing is published, nothing is attached to your business name publicly.',
  },
  {
    question: 'Do I have to buy anything afterwards?',
    answer:
      'No, and the free concept exists so that neither of us is committing before you have seen something. If later you want the site live and maintained, want the visibility work, or want something custom built, those are separate conversations with separate quotes. You are never locked in — the domain would be registered in your name and you can take it to another provider whenever you like.',
  },
  {
    question: 'Can you get me to the top of Google?',
    answer:
      'No, and I would be careful of anyone who says otherwise. What I can do is remove the technical obstacles, make sure your business information is accurate and consistent, write content worth citing, and measure where your traffic actually comes from. Those are the parts you control. Rankings themselves are not something any honest person can guarantee, and I will not pretend otherwise to win the work.',
  },
  {
    question: 'Do you work with businesses outside Christchurch?',
    answer:
      'Yes. I am Christchurch-based, which is why the local pages here are genuinely specific instead of generic filler. But the work is entirely remote and I work with businesses across New Zealand.',
  },
  {
    question: 'Who actually does the work?',
    answer:
      'I do — Barry Grottis, and there is no team behind the website. You talk to the person who designs, builds, and maintains your site. I have been building websites since 2011, and I built the automated pipeline that produces the free concepts.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="Free Concept Website NZ | Byte Digital"
  description="Get a free, private concept website for your New Zealand business. Built from your real public information, reviewed on a private link, source files yours to keep. Then hosting, search and AI visibility, and custom software if you want it."
  jsonLd={jsonLd}
>
  <Hero />
  <FreeWebsiteExplainer />
  <WhyModernWebsite />
  <Divider />
  <LadderGrid />
  <ProcessGrid />
  <Divider />
  <LiveSystems />
  <CTASection />

  <section class="section reveal" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <SectionHeader
        label="From The Blog"
        title="Latest <span class='gradient-text'>Insights</span>"
        subtitle="Notes on websites, search, AI visibility, and automation for New Zealand businesses."
      />
      {latestPosts.length > 0 ? (
        <div class="blog-card-grid">
          {latestPosts.map((post) => (
            <BlogCard
              title={post.title}
              description={post.description}
              category={post.category}
              slug={post.slug}
              pubDate={post.pubDate}
            />
          ))}
        </div>
      ) : (
        <p style="text-align:center;color:var(--text-muted)">Posts coming soon.</p>
      )}
      <div style="text-align:center;margin-top:40px">
        <a href="/blog/" class="btn-ghost" style="display:inline-flex;align-items:center;gap:8px;padding:12px 28px;font-size:14px;text-decoration:none">
          View All Posts
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <SectionHeader
        label="Free Tools"
        title="Check your site <span class='gradient-text'>before you spend anything</span>"
        subtitle="Real data, no strings. If something needs fixing, you should know what it is before anyone quotes you."
      />
      <div class="tools-grid">
        <a href="/tools/free-website-audit/" class="tool-card glass">
          <div class="tool-card-icon mint">
            <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h3>Free Website Audit</h3>
          <p>Real Google PageSpeed data on performance, SEO, and accessibility — plus what to actually fix first.</p>
          <span class="tool-card-link">
            Run the audit
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>
          </span>
        </a>
        <a href="/tools/website-cost-calculator/" class="tool-card glass">
          <div class="tool-card-icon purple">
            <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Website Cost Calculator</h3>
          <p>A realistic range for what a website should cost in NZ, and what you should be wary of.</p>
          <span class="tool-card-link">
            See the range
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>
          </span>
        </a>
        <a href="/free-website/" class="tool-card glass">
          <div class="tool-card-icon mint">
            <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
          </div>
          <h3>Free Concept Website</h3>
          <p>Skip the quotes. Get a working concept of your site, privately, with the source files if you want them.</p>
          <span class="tool-card-link">
            Start free
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section id="locations" class="section reveal" style="background:#0A0A0E;border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div class="section-label">Local knowledge</div>
      <div class="section-title">Based in Christchurch, <span class="gradient-text">working NZ-wide.</span></div>
      <p class="section-subtitle" style="margin-bottom:40px">
        I am Christchurch-based, so these pages are written from actual local knowledge rather than a template.
        That is also why the free concept works the same way whether you are in Riccarton or Ruakura.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:32px">
        {[
          { name: 'Riccarton', slug: 'riccarton' },
          { name: 'Papanui', slug: 'papanui' },
          { name: 'Halswell', slug: 'halswell' },
          { name: 'Merivale', slug: 'merivale' },
          { name: 'Sumner', slug: 'sumner' },
          { name: 'Linwood', slug: 'linwood' },
          { name: 'Fendalton', slug: 'fendalton' },
          { name: 'New Brighton', slug: 'new-brighton' },
          { name: 'Cashmere', slug: 'cashmere' },
          { name: 'St Albans', slug: 'st-albans' },
          { name: 'Sydenham', slug: 'sydenham' },
          { name: 'Wigram', slug: 'wigram' },
        ].map((s) => (
          <a href={`/locations/${s.slug}/`} style="padding:10px 20px;border-radius:10px;background:var(--surface);border:1px solid var(--border-subtle);color:var(--text-secondary);text-decoration:none;font-size:14px;font-weight:500;transition:border-color 0.2s">
            {s.name}
          </a>
        ))}
      </div>
      <div style="text-align:center">
        <a href="/locations/" class="btn-cta" style="display:inline-flex;align-items:center;gap:8px;padding:12px 28px;font-size:14px;text-decoration:none">
          All service areas
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m-5 5l5-5H6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <FAQAccordion items={faqItems} />
</BaseLayout>
