---
// Admin Login — Password gate for dashboard
// bytedigital.co.nz/admin-login
---

<html lang="en-NZ">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Admin Login — Byte Digital</title>
<meta name="robots" content="noindex, nofollow" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style is:global>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html, body { height:100%; }
body {
  background: #030304;
  color: #E2E8F0;
  font-family: 'Space Grotesk', sans-serif;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}
.login-card {
  width: 100%;
  max-width: 380px;
  padding: 40px 32px;
  background: rgba(19, 19, 26, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}
.logo {
  text-align: center;
  margin-bottom: 32px;
}
.logo .bd {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 2px;
  background: linear-gradient(135deg, #8B78E6, #5EEAD4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.logo .mint {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #5EEAD4;
}
.logo-sub {
  font-size: 11px;
  color: #64748B;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 8px;
}
.field {
  margin-bottom: 16px;
}
.field label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: #94A3B8;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}
.field input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #E2E8F0;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s;
}
.field input:focus {
  border-color: #8B78E6;
}
.btn-login {
  width: 100%;
  padding: 12px;
  border-radius: 10px;
  border: none;
  cursor: pointer;
  background: linear-gradient(135deg, #8B78E6, #5EEAD4);
  color: #fff;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 14px;
  transition: transform 0.2s, box-shadow 0.2s;
  margin-top: 8px;
}
.btn-login:hover {
  transform: scale(1.02);
  box-shadow: 0 0 20px rgba(139, 120, 230, 0.3);
}
.btn-login:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}
.error {
  margin-top: 12px;
  padding: 10px 14px;
  border-radius: 8px;
  background: rgba(255, 95, 87, 0.1);
  border: 1px solid rgba(255, 95, 87, 0.2);
  color: #ff5f57;
  font-size: 12px;
  display: none;
}
.error.show {
  display: block;
}
</style>
</head>
<body>

<div class="login-card">
  <div class="logo">
    <span class="bd">BYTE</span><span class="mint">DIGITAL</span>
    <div class="logo-sub">Admin Access</div>
  </div>
  <form id="loginForm">
    <div class="field">
      <label>Password</label>
      <input type="password" id="password" placeholder="Enter admin password" autofocus />
    </div>
    <button type="submit" class="btn-login" id="btnLogin">Sign In</button>
    <div class="error" id="errorMsg">Invalid password. Please try again.</div>
  </form>
</div>

<script>
document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('btnLogin');
  const err = document.getElementById('errorMsg');
  const password = document.getElementById('password').value;

  btn.disabled = true;
  btn.textContent = 'Signing in...';
  err.classList.remove('show');

  try {
    const resp = await fetch('/api/admin-login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password }),
    });

    if (resp.ok) {
      window.location.href = '/chatbot-dashboard';
    } else {
      err.classList.add('show');
      btn.disabled = false;
      btn.textContent = 'Sign In';
    }
  } catch {
    err.textContent = 'Connection error. Please try again.';
    err.classList.add('show');
    btn.disabled = false;
    btn.textContent = 'Sign In';
  }
});
</script>

</body>
</html>
