---
import ServicePage from '../../layouts/ServicePage.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import RelatedCaseStudies from '../../components/RelatedCaseStudies.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import IconList from '../../components/IconList.astro';
import CalloutBox from '../../components/CalloutBox.astro';
import { getCollection } from 'astro:content';
import { getRelatedPosts, getRelatedGuides, getRelatedCaseStudies } from '../../utils/content-relations';

const faqItems = [
  {
    question: 'Which eCommerce platform is best for my Christchurch business?',
    answer: 'The best platform depends on your product range, sales volume, technical requirements, and budget. Shopify is ideal for businesses that want a managed, all-in-one solution with NZ payment integration. WooCommerce is powerful for businesses already using WordPress who need full customisation control. For high-performance, custom-built stores, we recommend headless commerce with platforms like Snipcart or Medusa.js integrated into a modern front-end. We assess your specific needs and recommend the platform that delivers the best long-term value.'
  },
  {
    question: 'How do I know what level of eCommerce investment is right for my Christchurch business?',
    answer: "Every eCommerce project is different, so we scope each one based on your specific products, sales targets, and growth plans. Whether you need a streamlined store with a curated product range or a complex, custom-built platform with advanced functionality, we provide detailed proposals that outline exactly what's included. The value of a well-built eCommerce site is measured in the sales it generates and the customers it retains. Contact us via our contact form or email barry@bytedigital.co.nz to discuss your eCommerce goals and receive a tailored proposal."
  },
  {
    question: 'Can you integrate NZ payment gateways into my online store?',
    answer: 'Yes. We integrate all major payment gateways used by New Zealand businesses, including Stripe, Windcave, Payment Express (PX Post), POLi, and PayPal. We also set up popular buy-now-pay-later options like Afterpay and Zip that are widely used by NZ consumers. All integrations are configured for NZD currency and comply with NZ payment processing regulations.'
  },
  {
    question: 'Will my eCommerce store rank on Google?',
    answer: 'Yes, every eCommerce store we build is optimised for search engines from the ground up. This includes SEO-friendly product URLs, optimised meta tags for every product and category, structured data markup for rich product snippets, fast load times, mobile-optimised product pages, and XML sitemaps that ensure Google indexes all your products. We can also provide ongoing SEO services to help your store rank competitively for product-related searches in New Zealand.'
  },
  {
    question: 'Can you integrate my online store with Xero or other NZ accounting software?',
    answer: 'Absolutely. We regularly integrate eCommerce stores with Xero for automated invoicing, inventory synchronisation, and financial reporting. We also integrate with other NZ business tools including Vend for point-of-sale, Shippit for shipping management, and various CRM systems. These integrations eliminate manual data entry and streamline your operations.'
  },
  {
    question: 'How do you handle shipping for NZ eCommerce stores?',
    answer: 'We configure shipping rules based on NZ Post, CourierPost, and Freightways rate tables, including weight-based, price-based, and location-based calculations. We set up free shipping thresholds, rural delivery surcharges, and express shipping options. For businesses with specific logistics needs, we can integrate with third-party shipping APIs that provide real-time rate calculations and tracking.'
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "eCommerce Website Christchurch",
  "description": "eCommerce website development services for Christchurch businesses. Shopify, WooCommerce, headless commerce, NZ payment integration, and shipping configuration by Byte Digital.",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Byte Digital",
    "url": "https://bytedigital.co.nz",
    "address": { "@type": "PostalAddress", "addressLocality": "Christchurch", "addressRegion": "Canterbury", "addressCountry": "NZ" }
  },
  "areaServed": { "@type": "City", "name": "Christchurch" },
  "sameAs": []
};

const allBlogPosts = (await getCollection('blog')).map(p => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  pubDate: p.data.pubDate,
})).sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const allCaseStudies = (await getCollection('case-studies')).map(p => ({
  slug: p.id,
  title: p.data.title,
  client: p.data.client,
  industry: p.data.industry,
  description: p.data.description,
  tags: p.data.tags,
}));

const relatedPosts = getRelatedPosts('ecommerce', allBlogPosts, 3);
const relatedGuides = getRelatedGuides('ecommerce', 2);
const relatedCaseStudies = getRelatedCaseStudies('ecommerce', allCaseStudies, 2);
---

<ServicePage
  title="eCommerce Website Christchurch | Shopify, Windcave & Stripe | Byte Digital"
  description="High-converting eCommerce websites for Christchurch businesses. Shopify, WooCommerce and headless stores with Windcave, Stripe, Afterpay and NZ shipping configured from day one."
  serviceTitle="eCommerce Website Christchurch"
  serviceSubtitle="Online stores that sell. Fast, secure, and optimised for New Zealand shoppers."
  jsonLd={jsonLd}
>
  <section class="section section-glow dm-edge-top">
    <div class="glow-orb purple top-left"></div>
    <div class="glow-orb mint bottom-right"></div>
    <div class="container">
      <div class="service-content" style="position:relative;z-index:1">

        <h2 class="heading-accent">eCommerce Development Built for New Zealand Shoppers</h2>
        <p>New Zealand's eCommerce market has grown dramatically, with online retail now accounting for a significant and increasing share of total retail spending. Christchurch consumers are buying more online than ever before, and businesses that fail to offer a seamless, trustworthy online shopping experience are leaving revenue on the table. Whether you are launching your first online store or upgrading an existing one, your eCommerce website needs to convert visitors into customers efficiently.</p>
        <p>At Byte Digital, we build eCommerce websites for Christchurch businesses that are fast, secure, easy to manage, and optimised for conversions. We understand the unique requirements of selling online in New Zealand, from payment gateways and shipping logistics to consumer expectations and regulatory compliance.</p>

        <h2 class="heading-accent">eCommerce Platforms We Work With</h2>
        <p>We do not believe in one-size-fits-all eCommerce solutions. The right platform for your Christchurch business depends on your product catalogue, sales volume, growth plans, and operational requirements.</p>

        <h3>Shopify</h3>
        <p>Shopify is the most popular eCommerce platform in New Zealand, and for good reason. It is a fully managed platform that handles hosting, security, and PCI compliance, leaving you free to focus on selling. We build custom Shopify themes and configure stores with NZ-specific payment gateways, shipping rules, and tax settings. Shopify is ideal for businesses that want a reliable, scalable store without managing technical infrastructure.</p>

        <h3>WooCommerce</h3>
        <p>WooCommerce runs on WordPress and offers unmatched customisation flexibility. It is open-source, which means there are no platform fees beyond hosting and payment processing. We build custom WooCommerce stores with tailored functionality, advanced product types, subscription capabilities, and seamless integration with your existing <a href="/services/wordpress-development/">WordPress website</a>. WooCommerce is ideal for businesses that need complete control over their store's functionality and data.</p>

        <h3>Headless Commerce</h3>
        <p>For businesses that demand maximum performance, we build headless commerce solutions that separate the front-end presentation layer from the back-end commerce engine. This architecture delivers sub-second page loads, superior SEO performance, and the flexibility to present your products across any channel: web, mobile, social media, or in-store kiosks. We integrate headless commerce with modern front-ends built on Astro or Next.js for the best possible user experience.</p>

        <h2 class="heading-accent">NZ-Specific eCommerce Configuration</h2>
        <p>Selling online in New Zealand requires specific configurations that generic eCommerce setups often overlook. Every store we build is configured for the NZ market from day one.</p>

        <h3>NZ Payment Gateway Integration: Stripe, Windcave & More</h3>
        <p>We integrate payment solutions that New Zealand consumers trust and use regularly:</p>
        <ul>
          <li><strong>Stripe:</strong> Widely adopted by NZ businesses, supports all major credit and debit cards, Apple Pay, and Google Pay</li>
          <li><strong>Windcave:</strong> One of NZ's most established payment gateways, supporting credit cards, internet banking, and POLi</li>
          <li><strong>Payment Express (PX Post):</strong> A direct bank integration popular with established NZ retailers</li>
          <li><strong>Afterpay and Zip:</strong> Buy-now-pay-later options that are increasingly expected by NZ online shoppers</li>
          <li><strong>Account2Account:</strong> Internet banking payments that reduce transaction fees for high-value purchases</li>
        </ul>
        <p>For businesses already using Windcave (formerly Payment Express), we handle the full setup: PX Post and PX Pay integration, 3D Secure configuration, hosted payment page branding to match your store, webhook handling for order status updates, and reconciliation with your accounting system. If you are deciding between Windcave and Stripe for a new NZ store, we will walk you through real fee structures and settlement times so you can choose based on your average order value and cashflow needs — not marketing material.</p>
        <p>All payment integrations are configured for NZD currency, include appropriate GST handling, and comply with NZ payment processing standards.</p>

        <h3>NZ Shipping and Fulfilment</h3>
        <p>Shipping configuration can make or break the eCommerce experience for New Zealand customers. We set up comprehensive shipping rules that account for:</p>
        <ul>
          <li>NZ Post and CourierPost rate tables with weight-based and size-based calculations</li>
          <li>Rural delivery surcharges that apply to addresses outside main centres</li>
          <li>Free shipping thresholds that incentivise higher order values</li>
          <li>Express and overnight shipping options for urgent orders</li>
          <li>Click and collect for Christchurch customers who want to pick up in store</li>
          <li>International shipping for businesses that ship beyond New Zealand</li>
        </ul>

      </div>
    </div>
  </section>

  <section class="section reveal" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div class="service-content">

        <h2 class="heading-accent">Conversion-Optimised eCommerce Design</h2>
        <p>Driving traffic to your online store is only half the battle. Converting those visitors into paying customers requires thoughtful, data-informed design. Every eCommerce site we build incorporates conversion optimisation best practices:</p>
        <h3>Conversion Optimisation</h3>
        <ul>
          <li><strong>Product page optimisation:</strong> High-quality imagery, detailed descriptions, clear pricing with GST included, prominent add-to-cart buttons, trust badges, and social proof</li>
          <li><strong>Streamlined checkout:</strong> Minimal form fields, guest checkout options, progress indicators, and multiple payment methods to reduce cart abandonment</li>
          <li><strong>Smart search and filtering:</strong> Intuitive product search with auto-suggestions, category filtering, and sorting options that help shoppers find products quickly</li>
          <li><strong>Cart recovery:</strong> Automated email sequences that re-engage shoppers who added items but did not complete their purchase</li>
          <li><strong>Mobile shopping experience:</strong> Touch-friendly product browsing, thumb-reachable CTAs, and mobile-optimised checkout flows</li>
          <li><strong>Trust signals:</strong> NZ-based business indicators, secure checkout badges, clear returns policies, and real customer reviews</li>
        </ul>

        <h2 class="heading-accent">Product Management and Inventory</h2>
        <p>Managing products, inventory, and orders should be straightforward, not a full-time job. We build eCommerce stores with intuitive admin interfaces that make product management efficient. We integrate with inventory management systems, set up automated stock alerts, configure bulk import and export capabilities for large catalogues, and ensure your store syncs seamlessly with any physical retail systems you operate.</p>
        <p>For Christchurch retailers with physical stores, we can integrate your online and in-store inventory so stock levels are always accurate across all channels. We also integrate with Xero for automated financial reconciliation, eliminating manual data entry and reducing accounting overhead.</p>

        <h2 class="heading-accent">eCommerce SEO and Marketing</h2>
        <p>An eCommerce store that cannot be found on Google is a shop with no signage. Every store we build includes foundational <a href="/services/seo/">SEO optimisation</a>: clean product URLs, optimised meta titles and descriptions, schema markup for products and reviews, XML sitemaps, and fast page loads. We also set up Google Analytics 4 and Google Tag Manager with custom eCommerce tracking so you understand exactly how visitors interact with your store and where drop-offs occur.</p>
        <p>For ongoing eCommerce growth, we offer SEO retainers that target product-specific keywords, create content that drives organic traffic, build authoritative backlinks, and optimise your product pages based on search data and conversion analytics.</p>

        <h2 class="heading-accent">eCommerce Security and Compliance</h2>
        <p>Online shoppers need to trust that their personal and payment information is secure. Every eCommerce store we build includes SSL encryption, PCI-compliant payment processing, secure authentication for admin access, regular security updates, input validation and sanitisation, and protection against common web vulnerabilities. We also configure data privacy settings in compliance with New Zealand's Privacy Act 2020.</p>

        <h2 class="heading-accent">Why Christchurch Businesses Choose Byte Digital for eCommerce</h2>
        <IconList title="Why Byte Digital for eCommerce" items={[
          { highlight: 'NZ market expertise:', text: ' We configure stores specifically for New Zealand consumers, payments, and shipping' },
          { highlight: 'Conversion focus:', text: ' We design to maximise sales, not just to look attractive' },
          { highlight: 'Platform flexibility:', text: ' We recommend and build on the best platform for your specific business needs' },
          { highlight: 'Integration capability:', text: ' We connect your store with the NZ business tools you already use' },
          { highlight: 'Ongoing support:', text: ' Our <a href="/services/website-maintenance/">website care plans</a> keep your store secure, updated, and performing optimally' },
          { highlight: 'Scalable architecture:', text: ' Your store grows with your business without requiring a rebuild' },
        ]} />

        <CalloutBox type="highlight" title="Free Consultation">
          <p>Whether you are selling handcrafted goods from a workshop in Woolston or running a large retail operation in the Christchurch CBD, we build eCommerce stores that sell. Get in touch to discuss your online store project.</p>
        </CalloutBox>

      </div>
    </div>
  </section>

  <Fragment slot="related-case-studies">
    <RelatedCaseStudies studies={relatedCaseStudies} />
  </Fragment>

  <Fragment slot="related-posts">
    <RelatedPosts posts={relatedPosts} />
  </Fragment>

  <Fragment slot="related-guides">
    <RelatedGuides guides={relatedGuides} />
  </Fragment>

  <Fragment slot="related-services">
    <RelatedServices serviceSlug="ecommerce" />
  </Fragment>

  <Fragment slot="faq">
    <FAQAccordion items={faqItems} />
  </Fragment>
</ServicePage>
