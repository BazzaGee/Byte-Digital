---
import ServicePage from '../../layouts/ServicePage.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import RelatedCaseStudies from '../../components/RelatedCaseStudies.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import IconList from '../../components/IconList.astro';
import CalloutBox from '../../components/CalloutBox.astro';
import ContentStats from '../../components/ContentStats.astro';
import { getCollection } from 'astro:content';
import { getRelatedPosts, getRelatedGuides, getRelatedCaseStudies } from '../../utils/content-relations';

const faqItems = [
  {
    question: 'What types of custom web applications do you build?',
    answer: 'We build a wide range of custom web applications for Christchurch businesses, including booking and scheduling systems, customer relationship management (CRM) platforms, client portals and dashboards, inventory management systems, quoting and proposal tools, workflow automation platforms, chatbot and AI integrations, membership and subscription platforms, and data reporting tools. If you have a business process that could be improved with a bespoke digital solution, we can design and build it.'
  },
  {
    question: 'How long does custom web application development take?',
    answer: 'Custom web application timelines vary significantly based on complexity. A straightforward booking system or client portal typically takes eight to twelve weeks. More complex applications with multiple user roles, complex business logic, and third-party integrations may take four to eight months. We break projects into phases with clear milestones so you see progress early and can provide feedback throughout the development process.'
  },
  {
    question: 'How do I know what level of investment a custom web application requires?',
    answer: "Every custom application is unique, so we scope each project based on the specific business problem it solves and the value it delivers. A focused single-purpose tool requires a different level of investment than a complex, multi-feature platform. What we can tell you is that the businesses we work with typically see their custom applications pay for themselves within months through operational efficiencies, reduced manual work, and improved customer experience. We provide detailed, phased proposals that break down the scope by feature and milestone. Contact us to discuss your project and receive a tailored proposal."
  },
  {
    question: 'Can you integrate AI or chatbot functionality into my application?',
    answer: 'Yes. We integrate AI-powered features including customer service chatbots, content generation tools, data analysis and reporting, intelligent search, and recommendation engines. We work with APIs from OpenAI, Google, and other AI providers to add intelligent automation that enhances your web application without replacing the human touch your Christchurch customers value.'
  },
  {
    question: 'Will I own the source code for my custom application?',
    answer: 'Yes. Unlike some agencies that retain ownership of custom code, we transfer full intellectual property rights to you upon project completion. You receive the complete source code, documentation, and deployment instructions. This means you are never locked into our services and can engage any developer to maintain or extend your application in the future.'
  },
  {
    question: 'Do you build mobile apps as well as web applications?',
    answer: 'Our primary focus is web applications that work across all devices through a browser. A responsive web application can eliminate the need for separate iOS and Android apps, reducing development cost and complexity. However, if your project genuinely requires native mobile app development, we can discuss this and recommend appropriate solutions or partners.'
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Custom Web Applications Christchurch",
  "description": "Custom web application development for Christchurch businesses. Booking systems, CRM integrations, chatbot development, workflow automation, and bespoke software by Byte Digital.",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Byte Digital",
    "url": "https://bytedigital.co.nz",
    "address": { "@type": "PostalAddress", "addressLocality": "Christchurch", "addressRegion": "Canterbury", "addressCountry": "NZ" }
  },
  "areaServed": { "@type": "City", "name": "Christchurch" },
  "sameAs": []
};

const allBlogPosts = (await getCollection('blog')).map(p => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  pubDate: p.data.pubDate,
})).sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const allCaseStudies = (await getCollection('case-studies')).map(p => ({
  slug: p.id,
  title: p.data.title,
  client: p.data.client,
  industry: p.data.industry,
  description: p.data.description,
  tags: p.data.tags,
}));

const relatedPosts = getRelatedPosts('custom-applications', allBlogPosts, 3);
const relatedGuides = getRelatedGuides('custom-applications', 2);
const relatedCaseStudies = getRelatedCaseStudies('custom-applications', allCaseStudies, 2);
---

<ServicePage
  title="Custom Web Applications Christchurch | Bespoke Software NZ | Byte Digital"
  description="Byte Digital builds custom web applications for Christchurch businesses. Booking systems, CRM integrations, workflow automation, chatbots, and bespoke software solutions."
  serviceTitle="Custom Web Applications Christchurch"
  serviceSubtitle="Bespoke software solutions that automate processes and solve real business problems."
  jsonLd={jsonLd}
>
  <section class="section section-glow dm-edge-top">
    <div class="glow-orb purple top-left"></div>
    <div class="glow-orb mint bottom-right"></div>
    <div class="container">
      <div class="service-content" style="position:relative;z-index:1">

        <h2 class="heading-accent">Bespoke Web Applications for Christchurch Businesses</h2>
        <p>Off-the-shelf software is designed for the average business. If your Christchurch business is anything like the ones we work with, you are not average. You have unique processes, specific customer needs, and operational challenges that generic software cannot solve effectively.</p>
        <p>Custom web application development gives you a digital tool designed precisely for your business, your team, and your customers. At Byte Digital, we build custom web applications that solve real business problems — whether you need a booking system that eliminates phone tag, a CRM that actually fits your sales process, or a workflow automation platform that saves your team hours every week.</p>

        <h3>What we build</h3>
        <ul>
          <li><strong>Booking and scheduling systems</strong> — online booking with calendar integration, automated reminders, and payment processing</li>
          <li><strong>CRM integrations and customer portals</strong> — connecting HubSpot, Salesforce, or custom platforms with your website</li>
          <li><strong>Workflow automation platforms</strong> — form processing, document generation, approval chains, and inventory tracking</li>
          <li><strong>Chatbot and AI integration</strong> — customer service bots, lead qualification, and intelligent search using OpenAI and Google</li>
          <li><strong>Data dashboards and reporting tools</strong> — aggregated data from multiple sources in a single, intuitive interface</li>
        </ul>

      </div>

      <div class="service-content-wide" style="position:relative;z-index:1">
        <FeatureGrid columns={2} items={[
          {
            icon: `<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
            title: 'Booking Systems',
            description: 'Calendar integration, automated reminders, payment processing, and admin dashboards.',
            color: 'purple'
          },
          {
            icon: `<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
            title: 'CRM & Portals',
            description: 'Custom CRM platforms with client portals for account history, orders, and communication.',
            color: 'mint'
          },
          {
            icon: `<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
            title: 'Workflow Automation',
            description: 'Form processing, approval chains, invoicing, scheduling, and inventory management.',
            color: 'white'
          },
          {
            icon: `<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
            title: 'AI & Chatbots',
            description: 'Customer service bots, lead qualification, and intelligent search powered by OpenAI and Google.',
            color: 'purple'
          },
        ]} />
      </div>

      <div class="service-content" style="position:relative;z-index:1">

        <h2 class="heading-accent">Our Development Process</h2>
        <p>Building a custom web application is a significant investment, and we treat it with the rigour it deserves. Our process minimises risk, maximises clarity, and delivers a solution that genuinely solves your business problem.</p>

        <h3>1. Discovery and Requirements</h3>
        <p>We start by understanding your business processes, pain points, and objectives in detail. We map out current workflows, identify inefficiencies, and define exactly what the application needs to do. The output is a detailed requirements document and project roadmap that we both agree on before development begins.</p>

        <h3>2. UX Design and Prototyping</h3>
        <p>Before writing a single line of code, we create wireframes and interactive prototypes that show exactly how the application will work. This allows you to test the flow and refine the design before development — significantly cheaper and faster than making changes after code is written.</p>

        <h3>3. Agile Development</h3>
        <p>We develop in iterative two-week sprints with regular check-ins and demos. You see progress continuously, can provide feedback early, and can adjust priorities as the project evolves. Our stack includes React, Next.js, Node.js, and TypeScript, with PostgreSQL and MongoDB selected based on your data requirements.</p>

        <h3>4. Testing and Deployment</h3>
        <p>Every feature goes through thorough testing — functional, user acceptance, performance, security, and cross-device compatibility. We deploy with zero-downtime strategies and set up monitoring and alerting systems that proactively identify potential problems.</p>

      </div>
    </div>
  </section>

  <section class="section reveal dm-edge-bottom" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div class="service-content">

        <h2 class="heading-accent">Technology and ROI</h2>
        <p>We select technologies based on your project requirements and long-term goals. Our core stack includes <strong>React and Next.js</strong> for interactive front-ends, <strong>Node.js and TypeScript</strong> for back-end APIs, <strong>PostgreSQL and MongoDB</strong> for data storage, and <strong>AWS, Vercel, or Netlify</strong> for cloud hosting. We also integrate with NZ-specific services — payment gateways, shipping APIs, accounting software, and business platforms your Christchurch operation relies on.</p>

        <p>Custom software is an investment that delivers measurable returns. Christchurch businesses that invest in bespoke applications typically see reduced administrative costs, improved customer satisfaction, increased revenue through streamlined conversions, better data visibility, and competitive advantage through capabilities that off-the-shelf software cannot provide.</p>

        <ContentStats stats={[
          { value: '100%', label: 'Source code ownership' },
          { value: '8–12 weeks', label: 'Booking system timeline' },
          { value: '100%', label: 'Source code ownership' }
        ]} />

        <CalloutBox type="highlight" title="Free Discovery Consultation">
          <p style="margin:0">Not sure if a custom web application is right for your Christchurch business? Book a free discovery consultation. We will review your current processes, identify automation opportunities, and provide a no-obligation recommendation.</p>
        </CalloutBox>

        <h2 class="heading-accent">Why Choose Byte Digital</h2>
        <ul>
          <li><strong>Business-first approach:</strong> We solve business problems, not just write code</li>
          <li><strong>Full IP ownership:</strong> You own the source code, no vendor lock-in</li>
          <li><strong>Modern technology:</strong> Current, maintainable stack that any developer can work with</li>
          <li><strong>Agile process:</strong> Iterative development with continuous visibility and feedback</li>
          <li><strong>NZ integrations:</strong> Experience with NZ payment, shipping, and accounting platforms</li>
          <li><strong>Ongoing support:</strong> Maintenance and enhancement services after launch</li>
        </ul>

        <p>If your Christchurch business has a process, problem, or opportunity that off-the-shelf software cannot address, let us explore a custom solution together.</p>

      </div>
    </div>
  </section>

  <Fragment slot="related-case-studies">
    <RelatedCaseStudies studies={relatedCaseStudies} />
  </Fragment>

  <Fragment slot="related-posts">
    <RelatedPosts posts={relatedPosts} />
  </Fragment>

  <Fragment slot="related-guides">
    <RelatedGuides guides={relatedGuides} />
  </Fragment>

  <Fragment slot="related-services">
    <RelatedServices serviceSlug="custom-applications" />
  </Fragment>

  <Fragment slot="faq">
    <FAQAccordion items={faqItems} />
  </Fragment>
</ServicePage>
