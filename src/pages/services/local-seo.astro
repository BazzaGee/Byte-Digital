---
import ServicePage from '../../layouts/ServicePage.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import RelatedCaseStudies from '../../components/RelatedCaseStudies.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import IconList from '../../components/IconList.astro';
import CalloutBox from '../../components/CalloutBox.astro';
import { getCollection } from 'astro:content';
import { getRelatedPosts, getRelatedGuides, getRelatedCaseStudies } from '../../utils/content-relations';

const faqItems = [
  {
    question: 'What is local SEO and how is it different from regular SEO?',
    answer: 'Local SEO focuses on optimising your online presence to attract customers from geographically specific searches. While regular SEO targets broad keyword rankings, local SEO targets queries like "dentist near me" or "electrician Christchurch" and aims to get your business into the Google Local Pack, Google Maps results, and local organic listings. For Christchurch businesses that serve a specific geographic area, local SEO is typically more valuable than broad organic SEO.'
  },
  {
    question: 'How do I get my Christchurch business to show up on Google Maps?',
    answer: 'Showing up on Google Maps requires optimising your Google Business Profile with complete and accurate information, selecting relevant business categories, adding high-quality photos, posting regular updates, gathering and responding to reviews, ensuring your NAP (name, address, phone) information is consistent across the web, and building local citations on authoritative Christchurch and NZ directories. Our local SEO service handles all of this systematically.'
  },
  {
    question: 'How important are Google reviews for local SEO in Christchurch?',
    answer: 'Extremely important. Google reviews are one of the strongest ranking factors for local search results. Businesses with higher ratings and more reviews consistently outrank competitors in the local pack. For Christchurch consumers, reviews serve as social proof that directly influences purchase decisions. Our service includes a review generation strategy that makes it easy for your satisfied customers to leave positive feedback.'
  },
  {
    question: 'Can local SEO help my business rank in specific Christchurch suburbs?',
    answer: 'Yes. Suburb-specific local SEO is one of the most effective strategies for Christchurch businesses. We create location pages and content that target searches for "plumber Halswell," "cafe Riccarton," or "builder Rolleston." This approach helps you capture highly qualified local traffic from customers who prefer to work with businesses close to their home or workplace.'
  },
  {
    question: 'How long before my Christchurch business shows up in local search results?',
    answer: 'Google Business Profile optimisation can produce noticeable improvements within two to four weeks, particularly if your profile was previously unoptimised. Suburb-level organic rankings typically take three to six months of consistent effort. Local pack domination for competitive Christchurch keywords usually requires six to twelve months of sustained local SEO work. We set realistic timelines and report on progress monthly.'
  },
  {
    question: 'Do I need a physical location in Christchurch for local SEO to work?',
    answer: 'Having a physical address in Christchurch provides the strongest local SEO advantage because it allows you to verify a Google Business Profile with a physical location. However, service-area businesses that operate across Christchurch without a storefront can still rank well in local results by defining their service area in their Google Business Profile and building location-specific landing pages for the suburbs they serve.'
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Local SEO Christchurch",
  "description": "Local SEO services for Christchurch businesses. Google Business Profile optimisation, Google Maps ranking, local citations, and suburb targeting by Byte Digital.",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Byte Digital",
    "url": "https://bytedigital.co.nz",
    "address": { "@type": "PostalAddress", "addressLocality": "Christchurch", "addressRegion": "Canterbury", "addressCountry": "NZ" }
  },
  "areaServed": { "@type": "City", "name": "Christchurch" },
  "sameAs": []
};

const allBlogPosts = (await getCollection('blog')).map(p => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  pubDate: p.data.pubDate,
})).sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const allCaseStudies = (await getCollection('case-studies')).map(p => ({
  slug: p.id,
  title: p.data.title,
  client: p.data.client,
  industry: p.data.industry,
  description: p.data.description,
  tags: p.data.tags,
}));

const relatedPosts = getRelatedPosts('local-seo', allBlogPosts, 3);
const relatedGuides = getRelatedGuides('local-seo', 2);
const relatedCaseStudies = getRelatedCaseStudies('local-seo', allCaseStudies, 2);
---

<ServicePage
  title="Local SEO Christchurch | Google Maps Optimization NZ | Byte Digital"
  description="Byte Digital delivers local SEO services for Christchurch businesses. Google Business Profile optimisation, Google Maps ranking, local citations, review management, and suburb targeting."
  serviceTitle="Local SEO Christchurch"
  serviceSubtitle="Dominate local search results and Google Maps to attract more customers from your area."
  jsonLd={jsonLd}
>
  <section class="section section-glow dm-edge-top">
    <div class="glow-orb purple top-left"></div>
    <div class="glow-orb mint bottom-right"></div>
    <div class="container">
      <div class="service-content" style="position:relative;z-index:1">

        <h2 class="heading-accent">Local SEO That Puts Your Christchurch Business on the Map</h2>
        <p>When someone in Christchurch searches for a service you offer, you want your business to appear prominently in the results. Not on page three. Not buried beneath competitors from Auckland or overseas. Right there in the Google Local Pack, on Google Maps, and at the top of the organic results. That is what local SEO achieves, and it is one of the highest-return digital marketing investments a local business can make.</p>
        <p>At Byte Digital, we specialise in helping Christchurch and Canterbury businesses dominate local search. We understand the nuances of Google's local algorithm, the importance of Christchurch-specific signals, and the strategies that move the needle for businesses serving a geographic market.</p>

        <h2 class="heading-accent">What is Local SEO and Why Does It Matter for Christchurch?</h2>
        <p>Local SEO is the practice of optimising your online presence to attract business from local searches. These are searches that include geographic qualifiers like "Christchurch," "Canterbury," or specific suburb names, as well as "near me" queries that Google interprets based on the searcher's location.</p>
        <p>Consider how people in Christchurch actually search. They do not type "best plumber." They type "plumber Christchurch" or "emergency plumber Halswell" or "plumber near me." These localised queries represent intent that is far more likely to convert into a paying customer than generic searches. The person searching for "plumber Christchurch" has an immediate need and is ready to hire.</p>
        <p>Google's local search results feature the Local Pack, a prominent display of three businesses with a map, ratings, and contact information. Appearing in the Local Pack captures a massive share of local search clicks, often exceeding the organic results below. For many Christchurch service businesses, Local Pack visibility delivers more phone calls and enquiries than any other marketing channel.</p>

        <h2 class="heading-accent">Google Business Profile Optimisation</h2>
        <p>Your Google Business Profile, formerly known as Google My Business, is the cornerstone of local SEO. It is the information panel that appears when someone searches for your business or your services in Christchurch. A fully optimised profile can be the difference between appearing in the Local Pack and being invisible.</p>
        <p>Our Google Business Profile optimisation service covers every element that influences local rankings:</p>
        <h3>Google Business Profile Optimisation</h3>
        <ul>
          <li>Business name verification and accuracy: Ensuring your business name, address, and phone number are correct and consistent</li>
          <li>Primary and secondary categories: Selecting the most relevant categories that align with what your Christchurch customers actually search for</li>
          <li>Business description: Writing a keyword-rich, compelling description that highlights your services, location, and unique value</li>
          <li>Services and products: Adding detailed service descriptions with relevant keywords for each offering</li>
          <li>Photos and videos: Uploading high-quality visual content that showcases your work, your team, and your Christchurch location</li>
          <li>Business hours and attributes: Accurate opening hours, holiday schedules, and relevant business attributes like wheelchair accessibility or free parking</li>
          <li>Google Posts: Regular updates about promotions, events, news, and content that keep your profile active and engaging</li>
          <li>Q&A section: Proactively adding and answering common questions to improve profile completeness</li>
        </ul>

        <h2 class="heading-accent">Google Maps Ranking Strategy</h2>
        <p>Google Maps results are closely tied to your Google Business Profile, but ranking in Maps requires additional signals. We optimise for Maps ranking through:</p>
        <h3>Google Maps Ranking Strategy</h3>
        <ul>
          <li>Geographic relevance signals: Ensuring your business is associated with the correct Christchurch coordinates and service areas</li>
          <li>Local citation building: Listing your business consistently across authoritative Christchurch and NZ directories, industry platforms, and mapping services</li>
          <li>Review velocity and quality: Encouraging a steady stream of genuine, positive reviews from your Christchurch customers</li>
          <li>Local link building: Earning backlinks from Christchurch-based websites, local news outlets, and Canterbury organisations</li>
          <li>Website localisation: Ensuring your website clearly signals your Christchurch location through address, phone, embedded maps, and local content</li>
        </ul>

      </div>
    </div>
  </section>

  <section class="section reveal" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div class="service-content">

        <h2 class="heading-accent">Christchurch Suburb Targeting</h2>
        <p>Christchurch is a geographically spread city with distinct suburbs, each with its own community identity and search behaviour. A builder in Rolleston serves different customers than a builder in Sumner. A café in Riccarton competes with different establishments than one in Lyttelton. Suburb-level local SEO allows you to target these micro-markets with precision.</p>
        <p>We create suburb-specific landing pages and content that target searches like "electrician Halswell," "dental clinic Linwood," or "personal trainer Fendalton." Each page is optimised for local keywords, includes suburb-relevant content, and provides a clear path for visitors to contact you. For service-area businesses, we map your coverage area and create pages for every Christchurch suburb you serve.</p>
        <p>This approach is particularly effective for trades, home services, healthcare providers, and professional services where customers strongly prefer local providers. A homeowner in Papanui is far more likely to click on a result that mentions Papanui specifically than a generic Christchurch listing.</p>

        <h2 class="heading-accent">Review Management and Reputation</h2>
        <p>Online reviews are the lifeblood of local SEO and local consumer trust. Ninety percent of consumers read online reviews before visiting a business, and the average consumer reads ten reviews before feeling able to trust a business. For Christchurch businesses, reviews on your Google Business Profile directly influence both your ranking position and your conversion rate.</p>
        <p>Our review management service includes:</p>
        <h3>Review Management Services</h3>
        <ul>
          <li>Review generation systems: Implementing email and SMS follow-up sequences that prompt satisfied customers to leave reviews</li>
          <li>Review response strategy: Professionally responding to all reviews, positive and negative, to demonstrate active engagement</li>
          <li>Reputation monitoring: Tracking reviews across Google, Facebook, and industry-specific platforms</li>
          <li>Negative review management: Providing guidance on addressing criticism constructively and turning negative experiences into positive outcomes</li>
        </ul>

        <h2 class="heading-accent">Local Citations and NAP Consistency</h2>
        <p>A local citation is any online mention of your business name, address, and phone number. Consistent NAP information across the web is a critical local ranking signal. Inconsistent citations, such as a different phone number on your website versus your Google Business Profile, confuse Google and can negatively impact your rankings.</p>
        <p>We audit your existing citations across the web, correct inconsistencies, and build new citations on authoritative New Zealand and Christchurch-specific directories. This includes platforms like Yellow NZ, Localist, industry-specific directories, chamber of commerce listings, and local business associations. Every citation we build reinforces your Christchurch location signal and improves your local search visibility.</p>

        <h2 class="heading-accent">Local SEO for Service-Area Businesses</h2>
        <p>Not every Christchurch business has a storefront. Plumbers, electricians, mobile beauty therapists, cleaners, and many other service providers operate across multiple suburbs without a physical customer-facing location. Local SEO for service-area businesses requires a tailored approach.</p>
        <p>We optimise your Google Business Profile to clearly define your service area, create dedicated location pages for each suburb you serve, and build local content that establishes relevance for Christchurch-wide searches. This ensures you appear in local results across your entire service territory, not just at a single physical address.</p>

        <h2 class="heading-accent">Why Choose Byte Digital for Local SEO in Christchurch</h2>
        <IconList title="What Sets Us Apart" items={[
          { highlight: 'Deep local knowledge:', text: 'Deep local knowledge: We understand Christchurch\'s geography, suburbs, and search behaviour patterns' },
          { highlight: 'Proven local results:', text: 'Proven local results: We have helped Christchurch businesses achieve top-three local pack rankings in competitive industries' },
          { highlight: 'Comprehensive approach:', text: 'Comprehensive approach: We address every local ranking factor from Google Business Profile to citations to reviews' },
          { highlight: 'Reputation management:', text: 'Reputation management: We help you build and maintain the online reviews that drive both rankings and conversions' },
          { highlight: 'Transparent reporting:', text: 'Transparent reporting: Monthly reports tracking local rankings, profile views, calls, and direction requests' },
        ]} />

        <CalloutBox type="highlight" title="Free Local SEO Consultation">
          <p>Wondering why your competitors show up on Google Maps and you don't? Get a free local SEO audit from our Christchurch team. We will review your Google Business Profile, local citations, and search visibility to pinpoint exactly what is holding you back.</p>
        </CalloutBox>

        <p>If your Christchurch business is not showing up when local customers search for your services, you are losing enquiries every single day. Contact us for a free local SEO audit and discover exactly what it takes to dominate local search in your industry.</p>

      </div>
    </div>
  </section>

  <Fragment slot="related-case-studies">
    <RelatedCaseStudies studies={relatedCaseStudies} />
  </Fragment>

  <Fragment slot="related-posts">
    <RelatedPosts posts={relatedPosts} />
  </Fragment>

  <Fragment slot="related-guides">
    <RelatedGuides guides={relatedGuides} />
  </Fragment>

  <Fragment slot="related-services">
    <RelatedServices serviceSlug="local-seo" />
  </Fragment>

  <Fragment slot="faq">
    <FAQAccordion items={faqItems} />
  </Fragment>
</ServicePage>
