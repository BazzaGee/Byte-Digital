---
import ServicePage from '../../layouts/ServicePage.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import RelatedCaseStudies from '../../components/RelatedCaseStudies.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import IconList from '../../components/IconList.astro';
import CalloutBox from '../../components/CalloutBox.astro';
import { getCollection } from 'astro:content';
import { getRelatedPosts, getRelatedGuides, getRelatedCaseStudies } from '../../utils/content-relations';

const faqItems = [
  {
    question: 'What web development technologies does Byte Digital use?',
    answer: 'We work with a modern tech stack including Astro, Next.js, React, Node.js, and TypeScript for front-end and full-stack development. For content management, we integrate headless CMS platforms like Sanity, Strapi, and Contentful. We also build on WordPress when it is the right fit for the project. Our technology choices are always driven by your specific business requirements and long-term goals, not by personal preference.'
  },
  {
    question: 'How long does web development take for a Christchurch business?',
    answer: 'Timelines vary based on complexity. A standard business website with custom features typically takes six to ten weeks. A custom web application or integrated e-commerce platform may take three to six months. We provide detailed project roadmaps with clear milestones so you always know where your project stands and what is coming next.'
  },
  {
    question: 'Can you build custom web applications for my Christchurch business?',
    answer: 'Yes. Custom web application development is one of our core strengths. We have built booking systems, client portals, inventory management tools, CRM integrations, and workflow automation platforms for businesses across Christchurch and Canterbury. If you have a process that could be improved with a bespoke digital solution, we can design, develop, and deploy it.'
  },
  {
    question: 'Do you work with headless CMS platforms?',
    answer: 'Headless CMS architecture is our preferred approach for content-driven websites. We have extensive experience with Sanity, Strapi, Contentful, and Ghost. A headless CMS gives you full control over your content while delivering blazing-fast front-end performance through static generation and edge caching. This architecture is particularly effective for Christchurch businesses that publish frequently or need multi-channel content delivery.'
  },
  {
    question: 'Can you integrate third-party APIs into my website?',
    answer: 'Absolutely. We regularly integrate payment gateways like Stripe and Windcave, CRM systems like HubSpot and Salesforce, email marketing platforms like Mailchimp and ActiveCampaign, accounting software like Xero, booking systems, mapping services, social media platforms, and custom internal APIs. If it has an API, we can connect it to your website or application.'
  },
  {
    question: 'What happens after my website or application launches?',
    answer: 'We provide post-launch support that covers bug fixes, security patches, performance monitoring, and minor adjustments during an initial warranty period. Beyond that, we offer ongoing website care plans that include continuous monitoring, content updates, feature enhancements, and priority technical support. Your web application is a living product, and we treat it as such.'
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Web Development Christchurch",
  "description": "Modern web development services for Christchurch businesses. Full-stack development with Astro, Next.js, React, headless CMS, and custom API integrations by Byte Digital.",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Byte Digital",
    "url": "https://bytedigital.co.nz",
    "address": { "@type": "PostalAddress", "addressLocality": "Christchurch", "addressRegion": "Canterbury", "addressCountry": "NZ" }
  },
  "areaServed": { "@type": "City", "name": "Christchurch" },
  "sameAs": []
};

const allBlogPosts = (await getCollection('blog')).map(p => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  pubDate: p.data.pubDate,
})).sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const allCaseStudies = (await getCollection('case-studies')).map(p => ({
  slug: p.id,
  title: p.data.title,
  client: p.data.client,
  industry: p.data.industry,
  description: p.data.description,
  tags: p.data.tags,
}));

const relatedPosts = getRelatedPosts('web-development', allBlogPosts, 3);
const relatedGuides = getRelatedGuides('web-development', 2);
const relatedCaseStudies = getRelatedCaseStudies('web-development', allCaseStudies, 2);
---

<ServicePage
  title="Web Development Christchurch | Modern Web Development NZ | Byte Digital"
  description="Byte Digital provides modern web development services for Christchurch businesses. Full-stack solutions with Astro, Next.js, React, headless CMS, and API integrations."
  serviceTitle="Web Development Christchurch"
  serviceSubtitle="Robust, scalable web solutions built with modern frameworks and engineered for performance."
  jsonLd={jsonLd}
>
  <section class="section section-glow dm-edge-top">
    <div class="glow-orb purple top-left"></div>
    <div class="glow-orb mint bottom-right"></div>
    <div class="container">
      <div class="service-content" style="position:relative;z-index:1">

        <h2 class="heading-accent">Modern Web Development for Christchurch Businesses</h2>
        <p>Web development is where strategy meets execution. Your <a href="/services/web-design">web design</a> defines how your site looks, but your web development determines how it performs, how it scales, and how effectively it converts visitors into customers for your Christchurch business.</p>
        <p>At Byte Digital, we build websites and web applications using modern frameworks and development practices that deliver exceptional speed, reliability, and user experience. We are not interested in cobbling together WordPress plugins or relying on bloated page builders that slow your site to a crawl. We write clean, maintainable code that serves your business today and scales with it tomorrow.</p>

        <h2 class="heading-accent">Our Technology Stack</h2>
        <p>The tools we use matter. They affect your site's speed, security, maintainability, and ability to rank on Google. We choose technologies based on performance and suitability for your specific Christchurch business requirements.</p>

        <h3>Front-End Development</h3>
        <p>We primarily build front-ends with Astro and Next.js, two of the most performant frameworks available today. Astro's island architecture allows us to ship zero JavaScript by default, resulting in near-instant page loads. Next.js provides server-side rendering and API routes for dynamic, data-driven applications. For interactive interfaces, we use React components that hydrate progressively, delivering a smooth experience without bloating your page weight.</p>
        <p>This approach is particularly important for Christchurch businesses competing for local search visibility, because Google's Core Web Vitals, which measure load speed and interactivity, directly influence search rankings. Unlike agencies still using dated WordPress templates that load three to five seconds, our sites consistently achieve sub-one-second load times.</p>

        <h3>Headless CMS Integration</h3>
        <p>A headless CMS decouples your content management from your front-end presentation, giving you the best of both worlds: an intuitive content editing experience for your team and lightning-fast page delivery for your visitors. We work extensively with:</p>
        <h3>Headless CMS Platforms</h3>
        <ul>
          <li><strong>Sanity:</strong> A real-time, structured content platform ideal for businesses that need flexible content modelling and live preview</li>
          <li><strong>Strapi:</strong> An open-source headless CMS that gives you full ownership and control over your content infrastructure</li>
          <li><strong>Contentful:</strong> An enterprise-grade headless CMS for larger Christchurch organisations with complex content requirements</li>
          <li><strong>Ghost:</strong> A publishing-focused platform excellent for blogs, news sites, and content-heavy businesses</li>
        </ul>

        <h3>Back-End Development and APIs</h3>
        <p>When your project requires server-side logic, custom databases, or third-party integrations, we build robust back-end solutions using Node.js, Express, and TypeScript. We design RESTful APIs and GraphQL endpoints that power your web applications, mobile apps, and internal tools from a single, maintainable codebase.</p>
        <p>For <a href="/services/custom-applications">custom web applications</a>, we architect database schemas, implement authentication and authorisation systems, build notification services, and create admin dashboards that give your Christchurch team full visibility and control over your digital operations.</p>

        <h2 class="heading-accent">Custom API Integrations for New Zealand Businesses</h2>
        <p>Modern Christchurch businesses rely on a growing ecosystem of software tools. Your website needs to connect seamlessly with the platforms your team uses daily. We build reliable integrations with:</p>
        <h3>API Integrations</h3>
        <ul>
          <li><strong>Payment gateways:</strong> Stripe, Windcave, and Payment Express for NZ-specific payment processing</li>
          <li><strong>CRM systems:</strong> HubSpot, Salesforce, and Pipedrive to sync leads directly from your website</li>
          <li><strong>Email marketing:</strong> Mailchimp, ActiveCampaign, and Klaviyo for automated customer communication</li>
          <li><strong>Accounting:</strong> Xero integration for invoicing, inventory sync, and financial reporting</li>
          <li><strong>Booking and scheduling:</strong> Calendly, Acuity, and custom booking systems</li>
          <li><strong>Shipping and logistics:</strong> NZ Post, CourierPost, and Freightways for <a href="/services/ecommerce">eCommerce</a> fulfilment</li>
          <li><strong>Analytics and tracking:</strong> Google Analytics 4, Google Tag Manager, and custom event tracking</li>
        </ul>

      </div>
    </div>
  </section>

  <section class="section reveal" style="background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div class="service-content">

        <h2 class="heading-accent">Performance Engineering</h2>
        <p>Website performance is not optional. Google has confirmed that page speed is a ranking factor, and research consistently shows that faster websites convert at significantly higher rates. We engineer performance into every layer of your web application:</p>
        <h3>Performance Optimisation</h3>
        <ul>
          <li><strong>Static site generation</strong> and edge caching to serve pre-built pages from CDN nodes close to your Christchurch visitors</li>
          <li><strong>Image optimisation</strong> with automatic format conversion to WebP and AVIF, responsive sizing, and lazy loading</li>
          <li><strong>Code splitting</strong> to ensure visitors only download the JavaScript they actually need</li>
          <li><strong>Font optimisation</strong> to prevent layout shifts and eliminate render-blocking resources</li>
          <li><strong>Database query optimisation</strong> for dynamic applications that need to respond in under two hundred milliseconds</li>
        </ul>

        <h2 class="heading-accent">Security Best Practices</h2>
        <p>Cybersecurity threats targeting New Zealand businesses are increasing. We build security into our development process from day one, not as a patch applied after launch. Every web application we develop includes input validation, CSRF protection, secure authentication, encrypted data transmission, regular dependency audits, and adherence to OWASP security guidelines. For ongoing protection, our <a href="/services/website-maintenance">website maintenance</a> plans include continuous security monitoring and prompt patching.</p>

        <h2 class="heading-accent">Scalable Architecture for Growing Christchurch Businesses</h2>
        <p>Your website or application should grow with your business, not hold it back. We architect solutions that handle increased traffic, additional features, and expanding content requirements without requiring a complete rebuild. Whether you are a startup in the Christchurch Innovation Precinct or an established Canterbury enterprise serving customers nationwide, our development approach ensures your digital infrastructure scales cleanly and cost-effectively.</p>
        <p>We use cloud infrastructure from providers like Vercel, Netlify, and AWS, which automatically scale based on demand. This means your site handles traffic spikes, whether from a viral social media post or a seasonal rush, without degradation in performance.</p>

        <h2 class="heading-accent">Why Christchurch Businesses Choose Byte Digital</h2>
        <IconList title="Why Byte Digital for Web Development" items={[
          { highlight: 'Modern frameworks', text: ' that outperform traditional CMS platforms in speed, security, and developer experience' },
          { highlight: 'Full-stack capability', text: ' from front-end interfaces to back-end APIs and database architecture' },
          { highlight: 'Headless CMS expertise', text: ' that gives you content freedom without sacrificing performance' },
          { highlight: 'NZ-specific integrations', text: ' with payment gateways, shipping providers, and business tools used by Kiwi companies' },
          { highlight: 'Clean, documented code', text: ' that any developer can work with, protecting you from vendor lock-in' },
          { highlight: 'Local support', text: ' from a Christchurch team that understands your market and your customers' },
        ]} />

        <CalloutBox type="highlight" title="Free Consultation">
          <p>If your Christchurch business needs a website that goes beyond templates and page builders, or a web application that automates processes and drives efficiency, we would love to talk. Reach out for a free consultation about your web development project.</p>
        </CalloutBox>

      </div>
    </div>
  </section>

  <Fragment slot="related-case-studies">
    <RelatedCaseStudies studies={relatedCaseStudies} />
  </Fragment>

  <Fragment slot="related-posts">
    <RelatedPosts posts={relatedPosts} />
  </Fragment>

  <Fragment slot="related-guides">
    <RelatedGuides guides={relatedGuides} />
  </Fragment>

  <Fragment slot="related-services">
    <RelatedServices serviceSlug="web-development" />
  </Fragment>

  <Fragment slot="faq">
    <FAQAccordion items={faqItems} />
  </Fragment>
</ServicePage>
