---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import CTASection from '../../components/CTASection.astro';
import PageHero from '../../components/PageHero.astro';
import SectionAccent from '../../components/SectionAccent.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(allPosts.map(p => p.data.category))].filter(Boolean).sort();
---

<BaseLayout
  title="Blog - Web Design Tips & Christchurch Business Insights"
  description="Expert tips on web design, SEO, digital marketing, and business growth for Christchurch and New Zealand businesses. By Byte Digital."
>
  <PageHero
    label="Blog"
    title="Insights & Guides for<br /><span class='gradient-text'>Christchurch Businesses.</span>"
    subtitle="Expert web design tips, SEO strategies, and digital marketing insights to help your Christchurch business grow online."
  />

  <section class="section reveal" style="padding-top:0;background:var(--bg-dark);border-top:1px solid rgba(255,255,255,0.04)">
    <div class="container">
      <div class="filter-bar" id="filter-bar">
        <button class="filter-pill active" data-category="all">All</button>
        {categories.map(cat => (
          <button class="filter-pill" data-category={cat}>{cat}</button>
        ))}
      </div>
      <div class="blog-card-grid" id="blog-grid">
        {allPosts.map(post => (
          <div class="blog-card-item" data-category={post.data.category}>
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              slug={post.id}
              pubDate={post.data.pubDate}
              image={post.data.image}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>

<script>
const filterBar = document.getElementById('filter-bar');
const blogGrid = document.getElementById('blog-grid');

filterBar?.querySelectorAll('.filter-pill').forEach(pill => {
  pill.addEventListener('click', () => {
    filterBar.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
    pill.classList.add('active');
    const category = pill.getAttribute('data-category');
    blogGrid?.querySelectorAll('.blog-card-item').forEach(item => {
      if (category === 'all' || item.getAttribute('data-category') === category) {
        (item as HTMLElement).style.display = '';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  });
});
</script>
