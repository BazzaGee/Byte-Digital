function markDirty(key, value) { window.settingsDirty[key] = value; }

async function saveSettings() {
  if (Object.keys(window.settingsDirty).length === 0) return;
  const btn = document.getElementById('btnSave');
  btn.disabled = true;
  btn.textContent = 'Saving...';
  try {
    const resp = await fetch('/api/dashboard', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(window.settingsDirty),
    });
    if (resp.ok) {
      const data = await resp.json();
      if (dashboardData) dashboardData.settings = { ...dashboardData.settings, ...window.settingsDirty };
      window.settingsDirty = {};
      btn.textContent = 'Saved ✓';
      setTimeout(() => { btn.textContent = 'Save Changes'; btn.disabled = false; }, 2000);
    } else {
      btn.textContent = 'Error — retry';
      btn.disabled = false;
    }
  } catch {
    btn.textContent = 'Error — retry';
    btn.disabled = false;
  }
}

function toggleLogs() {
  const panel = document.getElementById('logsPanel');
  if (panel.classList.contains('collapsed')) {
    panel.classList.remove('collapsed');
    panel.classList.add('expanded');
  } else {
    panel.classList.remove('expanded');
    panel.classList.add('collapsed');
  }
}

function renderLogs() {
  if (!dashboardData) return;
  const { stats, sessions } = dashboardData;
  document.getElementById('statMessages').textContent = stats.totalMessages;
  document.getElementById('statSessions').textContent = stats.uniqueSessions;
  document.getElementById('statLatency').textContent = stats.avgLatency + 'ms';
  document.getElementById('statFallback').textContent = stats.fallbackRate + '%';

  // Render model usage chips in top bar
  let modelHtml = '';
  if (stats.modelUsage) {
    const models = Object.entries(stats.modelUsage).sort((a, b) => b[1] - a[1]);
    modelHtml = models.slice(0, 4).map(([m, c]) =>
      `<span style="font-size:10px;color:#94A3B8;border:1px solid rgba(255,255,255,0.06);padding:2px 7px;border-radius:6px;">${escapeHtml(m.split('/').pop())} ${c}</span>`
    ).join('');
  }
  document.getElementById('modelsStat').innerHTML = modelHtml;

  const sessionList = document.getElementById('sessionList');
  const sessionIds = Object.keys(sessions).sort((a, b) => {
    const aLast = sessions[a][0]?.created_at || '';
    const bLast = sessions[b][0]?.created_at || '';
    return bLast.localeCompare(aLast);
  });

  sessionList.innerHTML = sessionIds.map(sid => {
    const msgs = sessions[sid];
    const count = msgs.length;
    const lastTime = msgs[0]?.created_at;
    const shortId = sid.length > 16 ? sid.substring(0, 16) + '…' : sid;
    return `<div class="session-item ${sid === activeSessionId ? 'active' : ''}" data-sid="${escapeAttr(sid)}">
      <div class="session-id">${escapeHtml(shortId)}</div>
      <div class="session-meta">${count} turns · ${lastTime ? new Date(lastTime).toLocaleDateString('en-NZ') : ''}</div>
    </div>`;
  }).join('');

  sessionList.onclick = (e) => {
    const item = e.target.closest('.session-item');
    if (!item) return;
    selectSession(item.dataset.sid);
  };

  if (activeSessionId && sessions[activeSessionId]) {
    renderTimeline(sessions[activeSessionId]);
  }
}

function selectSession(sid) { activeSessionId = sid; renderLogs(); }

function renderTimeline(entries) {
  const el = document.getElementById('logTimeline');
  if (!entries || entries.length === 0) {
    el.innerHTML = '<div class="log-empty">No messages in this session</div>';
    return;
  }
  const chronological = [...entries].reverse();
  el.innerHTML = chronological.map((e, idx) => {
    const time = new Date(e.created_at).toLocaleTimeString('en-NZ', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    const model = e.model_used || '';
    const latency = e.latency_ms || 0;
    const fellBack = e.fell_back;
    const retrieval = e.retrieval || [];
    const isExecution = e.source === 'execution';

    let badges = '';
    if (isExecution) badges += `<span class="log-badge" style="background:rgba(94,234,212,0.1);color:#5EEAD4;">LIVE</span>`;
    else badges += `<span class="log-badge" style="background:rgba(255,255,255,0.05);color:#64748B;">LEGACY</span>`;
    if (e.user_message) badges += `<span class="log-badge user">USER</span>`;
    if (e.ai_message) badges += `<span class="log-badge ai">AI</span>`;
    if (model) badges += `<span class="log-badge model">${escapeHtml(model.split('/').pop())}</span>`;
    if (fellBack) badges += `<span class="log-badge fallback">FALLBACK</span>`;
    if (latency > 0) badges += `<span class="log-badge ${latency < 3000 ? 'fast' : 'slow'}">${latency}ms</span>`;

    let retrievalHtml = '';
    if (retrieval.length > 0) {
      retrievalHtml = `<div class="log-retrieval">${retrieval.map(r =>
        `<span class="retrieval-chip">${escapeHtml(r.title)} (${r.score})</span>`
      ).join('')}</div>`;
    }

    let text = '';
    if (e.user_message) text += `<div style="margin-bottom:6px;"><strong style="color:#8B78E6">User:</strong> ${escapeHtml(e.user_message)}</div>`;
    if (e.ai_message) text += `<div><strong style="color:#5EEAD4">AI:</strong> <span class="log-text collapsed" onclick="this.classList.toggle('collapsed')">${escapeHtml(e.ai_message)}</span></div>`;

    return `<div class="log-entry">
      <div class="log-entry-header">${badges}<span class="log-time">${time}</span></div>
      ${retrievalHtml}
      ${text}
    </div>`;
  }).join('');
}

function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function escapeAttr(str) {
  return String(str).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

async function fetchDashboard() {
  const el = document.getElementById('lastActivity');
  try {
    const resp = await fetch('/api/dashboard');
    if (resp.ok) {
      dashboardData = await resp.json();
      renderLogs();
      document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString('en-NZ', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
      if (el) el.textContent = dashboardData.stats.lastActivity
        ? 'Last: ' + new Date(dashboardData.stats.lastActivity).toLocaleString('en-NZ', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' })
        : 'No activity yet';
    } else if (resp.status === 401) {
      el.textContent = 'Session expired — redirecting...';
      setTimeout(() => { window.location.href = '/admin-login/'; }, 1500);
    } else {
      el.textContent = 'Error ' + resp.status;
    }
  } catch {
    el.textContent = 'Failed to load';
  }
}

function refreshDashboard() {
  const el = document.getElementById('lastActivity');
  el.textContent = 'Refreshing...';
  fetchDashboard();
}

document.addEventListener('DOMContentLoaded', () => {
  renderWorkflow();
  fetchDashboard();
  const container = document.getElementById('canvasContainer');
  const containerW = container.clientWidth;
  zoom = 0.75;
  panX = (containerW - 1700 * zoom) / 2;
  panY = 60;
  updateTransform();
  setInterval(fetchDashboard, 10000);
});

window.zoomIn = zoomIn;
window.zoomOut = zoomOut;
window.fitToView = fitToView;
window.openSettings = openSettings;
window.closeDrawer = closeDrawer;
window.switchDrawerTab = switchDrawerTab;
window.saveSettings = saveSettings;
window.toggleLogs = toggleLogs;
window.openNodeDrawer = openNodeDrawer;
window.markDirty = markDirty;
window.refreshDashboard = refreshDashboard;
</script>

</body>
</html>
