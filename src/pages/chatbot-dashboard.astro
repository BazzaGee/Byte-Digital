---
// Chatbot Dashboard — n8n-style workflow editor
// bytedigital.co.nz/chatbot-dashboard
---

<html lang="en-NZ">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Chatbot Dashboard — Byte Digital</title>
<meta name="robots" content="noindex, nofollow" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style is:global>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html, body { height:100%; overflow:hidden; }
body {
  background: #030304;
  color: #E2E8F0;
  font-family: 'Space Grotesk', sans-serif;
  -webkit-font-smoothing: antialiased;
}
::-webkit-scrollbar { width:6px; height:6px; }
::--webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:#1f1f2e; border-radius:3px; }
::-webkit-scrollbar-thumb:hover { background:#8B78E6; }

.dashboard { display:flex; flex-direction:column; height:100vh; }

.topbar {
  display:flex; align-items:center; gap:20px; padding:10px 16px;
  background: rgba(10,10,14,0.95); border-bottom:1px solid rgba(255,255,255,0.06);
  flex-shrink:0; z-index:20;
}
.topbar-logo {
  display:flex; align-items:center; gap:8px; font-weight:700; font-size:13px;
  letter-spacing:1px; color:#fff;
}
.topbar-logo .bd {
  background:linear-gradient(135deg,#8B78E6,#5EEAD4);
  -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  background-clip:text;
}
.topbar-title {
  font-size:11px; color:#94A3B8; font-weight:500; letter-spacing:1px;
  text-transform:uppercase; padding-left:16px; border-left:1px solid rgba(255,255,255,0.08);
}
.topbar-stats { display:flex; gap:24px; margin-left:24px; }
.topbar-stat { display:flex; flex-direction:column; align-items:center; gap:2px; }
.topbar-stat .num {
  font-size:16px; font-weight:700; line-height:1;
  background:linear-gradient(135deg,#8B78E6,#5EEAD4);
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
}
.topbar-stat .label { font-size:9px; color:#64748B; text-transform:uppercase; letter-spacing:0.5px; font-weight:600; }
.topbar-status {
  margin-left:auto; display:flex; align-items:center; gap:8px; font-size:11px; color:#94A3B8;
}
.topbar-status .dot {
  width:7px; height:7px; border-radius:50%; background:#28c840;
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:.4;} 50%{opacity:1;} }

.canvas-container {
  flex:1; position:relative; overflow:hidden;
  background:
    radial-gradient(circle at 20% 30%, rgba(139,120,230,0.04) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(94,234,212,0.03) 0%, transparent 50%);
}
.canvas-bg {
  position:absolute; inset:0;
  background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 20px 20px;
  pointer-events:none;
}
.canvas-transform {
  position: absolute; top: 0; left: 0;
  transform-origin: 0 0;
  width: 100%; height: 100%;
}

/* ─── n8n-Style Nodes ────────────────────────────────────────────── */
.node {
  position: absolute;
  cursor: grab;
  user-select: none;
  z-index: 2;
}
.node.dragging {
  cursor: grabbing;
  z-index: 100;
}
.node.selected { z-index: 10; }
.node-box {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: 14px;
  background: linear-gradient(145deg, rgba(22,22,32,0.98), rgba(16,16,22,0.98));
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1.5px solid rgba(255,255,255,0.07);
  width: 220px;
  position: relative;
  transition: border-color 0.25s, box-shadow 0.25s, transform 0.15s;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3), 0 0 0 0 rgba(139,120,230,0);
}
.node:hover .node-box {
  border-color: rgba(139,120,230,0.4);
  box-shadow: 0 4px 20px rgba(0,0,0,0.4), 0 0 0 2px rgba(139,120,230,0.15);
  transform: translateY(-1px);
}
.node.selected .node-box {
  border-color: rgba(139,120,230,0.7);
  box-shadow: 0 4px 24px rgba(0,0,0,0.5), 0 0 0 3px rgba(139,120,230,0.25);
}
.node.dragging .node-box {
  border-color: rgba(94,234,212,0.6);
  box-shadow: 0 8px 32px rgba(0,0,0,0.6), 0 0 0 3px rgba(94,234,212,0.2);
  transform: scale(1.03);
}
.node-accent {
  position: absolute;
  left: 0; top: 10px; bottom: 10px;
  width: 3px;
  border-radius: 2px;
}
.node-accent.purple { background: #8b78e6; }
.node-accent.mint { background: #5eead4; }
.node-accent.red { background: #ff5f57; }
.node-icon {
  width: 34px; height: 34px;
  border-radius: 10px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
}
.node-icon.purple {
  background: rgba(139,120,230,0.15);
  border: 1px solid rgba(139,120,230,0.3);
}
.node-icon.mint {
  background: rgba(94,234,212,0.15);
  border: 1px solid rgba(94,234,212,0.3);
}
.node-icon.red {
  background: rgba(255,95,87,0.15);
  border: 1px solid rgba(255,95,87,0.3);
}
.node-content { flex: 1; min-width: 0; }
.node-name {
  font-size: 12px; font-weight: 700; color: #fff;
  line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.node-desc {
  font-size: 9.5px; color: #94a3b8;
  margin-top: 1px; line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.node-badge {
  display: inline-block;
  padding: 2px 7px;
  border-radius: 6px;
  font-size: 8px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  flex-shrink: 0;
}
.node-badge.trigger { background: rgba(139,120,230,0.15); color: #8b78e6; border: 1px solid rgba(139,120,230,0.25); }
.node-badge.http { background: rgba(94,234,212,0.12); color: #5eead4; border: 1px solid rgba(94,234,212,0.25); }
.node-badge.code { background: rgba(94,234,212,0.12); color: #5eead4; border: 1px solid rgba(94,234,212,0.25); }
.node-badge.memory { background: rgba(139,120,230,0.15); color: #8b78e6; border: 1px solid rgba(139,120,230,0.25); }
.node-badge.agent { background: rgba(139,120,230,0.15); color: #8b78e6; border: 1px solid rgba(139,120,230,0.25); }
.node-badge.model { background: rgba(94,234,212,0.12); color: #5eead4; border: 1px solid rgba(94,234,212,0.25); }
.node-badge.fallback { background: rgba(255,95,87,0.12); color: #ff5f57; border: 1px solid rgba(255,95,87,0.25); }
.node-badge.action { background: rgba(94,234,212,0.12); color: #5eead4; border: 1px solid rgba(94,234,212,0.25); }
.node-badge.log { background: rgba(94,234,212,0.12); color: #5eead4; border: 1px solid rgba(94,234,212,0.25); }
.node-badge.output { background: rgba(94,234,212,0.12); color: #5eead4; border: 1px solid rgba(94,234,212,0.25); }

.port {
  position: absolute;
  width: 12px; height: 12px;
  border-radius: 50%;
  background: rgba(30,30,40,0.9);
  border: 2px solid rgba(255,255,255,0.25);
  transition: background 0.2s, border-color 0.2s, transform 0.15s;
  z-index: 3;
}
.port:hover {
  background: rgba(139,120,230,0.6);
  border-color: #8b78e6;
  transform: scale(1.3);
}
.port.input {
  left: -6px; top: 50%; transform: translateY(-50%);
}
.port.input:hover { transform: translateY(-50%) scale(1.3); }
.port.output {
  right: -6px; top: 50%; transform: translateY(-50%);
}
.port.output:hover { transform: translateY(-50%) scale(1.3); }

.connections-svg {
  position:absolute; top:0; left:0; pointer-events:none; z-index:1;
  overflow:visible;
}
.conn-line {
  fill:none; stroke:rgba(139,120,230,0.35); stroke-width:2;
  stroke-dasharray:6 4;
  animation: dash-flow 1.5s linear infinite;
}
.conn-line.mint { stroke:rgba(94,234,212,0.35); }
@keyframes dash-flow { to { stroke-dashoffset:-20; } }

.zoom-controls {
  position:absolute; bottom:16px; right:16px;
  display:flex; gap:6px; padding:6px 10px; border-radius:12px;
  background:rgba(19,19,26,0.9); backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,0.08); z-index:15;
}
.zoom-btn {
  width:32px; height:32px; border-radius:8px; border:1px solid rgba(255,255,255,0.08);
  background:none; color:#94A3B8; cursor:pointer; display:flex; align-items:center; justify-content:center;
  font-size:14px; transition:all 0.2s;
}
.zoom-btn:hover { background:rgba(255,255,255,0.06); color:#fff; }

/* ─── Right Drawer ───────────────────────────────────────────────── */
.drawer-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,0.4);
  z-index:9998; opacity:0; pointer-events:none;
  transition: opacity 0.3s;
}
.drawer-overlay.open { opacity:1; pointer-events:auto; }
.drawer {
  width:420px; max-width:90vw; background:rgba(10,10,14,0.99);
  border-left:1px solid rgba(255,255,255,0.06);
  display:flex; flex-direction:column;
  transform:translateX(100%); transition:transform 0.3s cubic-bezier(0.4,0,0.2,1);
  position:fixed; right:0; top:0; bottom:0; z-index:9999;
  box-shadow: -8px 0 32px rgba(0,0,0,0.5);
  max-height:100vh;
}
.drawer.open { transform:translateX(0); }
.drawer-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:14px 16px; border-bottom:1px solid rgba(255,255,255,0.06);
  flex-shrink:0;
}
.drawer-header h3 { font-size:14px; font-weight:700; color:#fff; }
.drawer-close {
  width:32px; height:32px; border-radius:8px; border:1px solid rgba(255,255,255,0.15);
  background:rgba(255,95,87,0.1); color:#ff5f57; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  font-size:18px; font-weight:bold; transition:all 0.2s;
  font-family: 'Space Grotesk', sans-serif;
  flex-shrink:0;
}
.drawer-close:hover { background:rgba(255,95,87,0.2); border-color:rgba(255,95,87,0.4); }
.drawer-tabs {
  display:flex; border-bottom:1px solid rgba(255,255,255,0.06);
  padding:0 16px; flex-shrink:0;
}
.drawer-tab {
  padding:10px 16px; font-size:12px; font-weight:600; color:#64748B;
  cursor:pointer; border-bottom:2px solid transparent; transition:all 0.2s;
  background:none; border-top:none; border-left:none; border-right:none;
  font-family:'Space Grotesk',sans-serif;
}
.drawer-tab:hover { color:#94A3B8; }
.drawer-tab.active { color:#8B78E6; border-bottom-color:#8B78E6; }
.drawer-body { flex:1; overflow-y:auto; padding:16px; min-height:0; }
.drawer-section { margin-bottom:20px; }
.drawer-section h4 {
  font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1.2px;
  color:#64748B; margin-bottom:10px;
}
.drawer-field { margin-bottom:14px; }
.drawer-field label {
  display:block; font-size:10px; font-weight:600; color:#94A3B8;
  margin-bottom:5px; text-transform:uppercase; letter-spacing:0.5px;
}
.drawer-field input, .drawer-field select, .drawer-field textarea {
  width:100%; padding:9px 12px; border-radius:8px;
  background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);
  color:#E2E8F0; font-family:'Space Grotesk',sans-serif; font-size:13px;
  outline:none; transition:border-color 0.2s;
}
.drawer-field input:focus, .drawer-field select:focus, .drawer-field textarea:focus {
  border-color:#8B78E6;
  background:rgba(255,255,255,0.06);
}
.drawer-field textarea { min-height:120px; resize:vertical; line-height:1.5; }
.drawer-field select { cursor:pointer; }
.drawer-field select option { background:#13131A; color:#E2E8F0; }
.drawer-field .hint { font-size:10px; color:#64748B; margin-top:4px; line-height:1.4; }
.drawer-field .masked-value {
  font-family: monospace; font-size:13px; color:#64748B;
  padding:9px 12px; border-radius:8px;
  background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);
  letter-spacing:2px;
}
.drawer-actions {
  padding:14px 16px; border-top:1px solid rgba(255,255,255,0.06);
  display:flex; gap:8px; flex-shrink:0;
  background:rgba(10,10,14,0.99);
}
.btn-save {
  flex:1; padding:10px; border-radius:10px; border:none; cursor:pointer;
  background:linear-gradient(135deg,#8B78E6,#5EEAD4);
  color:#fff; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px;
  transition:transform 0.2s, box-shadow 0.2s;
}
.btn-save:hover { transform:scale(1.02); box-shadow:0 0 20px rgba(139,120,230,0.3); }
.btn-save:disabled { opacity:0.5; cursor:not-allowed; transform:none; }
.btn-cancel {
  padding:10px 16px; border-radius:10px;
  border:1px solid rgba(255,255,255,0.1); background:none;
  color:#94A3B8; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:13px;
  cursor:pointer; transition:all 0.2s;
}
.btn-cancel:hover { border-color:rgba(255,255,255,0.2); color:#fff; }

/* ─── Bottom Logs Panel ──────────────────────────────────────────── */
.logs-panel {
  position:relative;
  background:rgba(5,5,7,0.98); border-top:1px solid rgba(255,255,255,0.08);
  z-index:30; transition: height 0.3s cubic-bezier(0.4,0,0.2,1);
  overflow:hidden; flex-shrink:0;
}
.logs-panel.collapsed { height:40px; }
.logs-panel.expanded { height:320px; }
.logs-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:10px 16px; cursor:pointer; user-select:none;
  height:40px;
}
.logs-header:hover { background:rgba(255,255,255,0.02); }
.logs-title { font-size:12px; font-weight:600; color:#94A3B8; }
.logs-toggle { font-size:16px; color:#64748B; transition: transform 0.3s; }
.logs-panel.expanded .logs-toggle { transform: rotate(180deg); }
.logs-body {
  display:flex; height:calc(100% - 40px); overflow:hidden;
}
.logs-sessions {
  width:240px; border-right:1px solid rgba(255,255,255,0.06);
  overflow-y:auto; flex-shrink:0;
}
.session-item {
  padding:10px 14px; cursor:pointer; border-bottom:1px solid rgba(255,255,255,0.03);
  transition:background 0.15s;
}
.session-item:hover { background:rgba(255,255,255,0.03); }
.session-item.active { background:rgba(139,120,230,0.08); border-left:2px solid #8B78E6; }
.session-id { font-size:11px; font-weight:600; color:#CBD5E1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.session-meta { font-size:10px; color:#64748B; margin-top:2px; }
.logs-timeline {
  flex:1; overflow-y:auto; padding:12px 16px;
}
.log-entry {
  padding:10px 14px; margin-bottom:8px; border-radius:10px;
  border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);
}
.log-entry-header {
  display:flex; align-items:center; gap:8px; margin-bottom:6px; flex-wrap:wrap;
}
.log-badge {
  display:inline-block; padding:2px 8px; border-radius:8px;
  font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;
}
.log-badge.user { background:rgba(139,120,230,0.15); color:#8B78E6; }
.log-badge.ai { background:rgba(94,234,212,0.12); color:#5EEAD4; }
.log-badge.model { background:rgba(139,120,230,0.08); color:#8B78E6; }
.log-badge.fallback { background:rgba(255,95,87,0.1); color:#ff5f57; }
.log-badge.fast { background:rgba(40,200,64,0.1); color:#28c840; }
.log-badge.slow { background:rgba(254,188,46,0.1); color:#febc2e; }
.log-time { font-size:10px; color:#64748B; }
.log-text { font-size:12px; color:#CBD5E1; line-height:1.5; word-break:break-word; }
.log-text.collapsed { max-height:40px; overflow:hidden; position:relative; }
.log-text.collapsed::after {
  content:''; position:absolute; bottom:0; left:0; right:0; height:20px;
  background:linear-gradient(transparent, rgba(5,5,7,0.9));
}
.log-retrieval { margin-top:6px; }
.retrieval-chip {
  display:inline-block; padding:2px 8px; border-radius:8px; margin:2px 4px 2px 0;
  font-size:10px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.06);
  color:#94A3B8;
}
.log-empty {
  text-align:center; padding:40px; color:#64748B; font-size:13px;
}

@media(max-width:768px) {
  .drawer { width:100%; max-width:none; }
  .topbar-stats { display:none; }
}
</style>
</head>
<body>

<div class="dashboard">
  <div class="topbar">
    <div class="topbar-logo">
      <span class="bd">BYTE</span><span style="color:#5EEAD4">DIGITAL</span>
    </div>
    <div class="topbar-title">Chatbot Workflow</div>
    <div class="topbar-stats">
      <div class="topbar-stat"><div class="num" id="statMessages">—</div><div class="label">Messages</div></div>
      <div class="topbar-stat"><div class="num" id="statSessions">—</div><div class="label">Sessions</div></div>
      <div class="topbar-stat"><div class="num" id="statLatency">—</div><div class="label">Avg Latency</div></div>
      <div class="topbar-stat"><div class="num" id="statFallback">—</div><div class="label">Fallback</div></div>
      <div class="topbar-stat" style="flex-direction:row;gap:6px;align-items:center;" id="modelsStat"></div>
    </div>
    <div class="topbar-status">
      <div class="dot"></div>
      <span id="lastActivity">Loading...</span>
      <span id="lastUpdated" style="font-size:10px;color:#64748B;margin-left:4px;"></span>
      <button onclick="refreshDashboard()" style="margin-left:8px;width:28px;height:28px;border-radius:6px;border:1px solid rgba(255,255,255,0.08);background:none;color:#94A3B8;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:14px;transition:all 0.2s;">↻</button>
    </div>
  </div>

  <div class="canvas-container" id="canvasContainer">
    <div class="canvas-bg" id="canvasBg"></div>
    <div class="canvas-transform" id="canvasTransform">
      <svg class="connections-svg" id="connectionsSvg" width="2000" height="600"></svg>
    </div>

    <div class="zoom-controls">
      <button class="zoom-btn" onclick="zoomOut()" title="Zoom out">−</button>
      <button class="zoom-btn" onclick="fitToView()" title="Fit to view">⊡</button>
      <button class="zoom-btn" onclick="zoomIn()" title="Zoom in">+</button>
      <button class="zoom-btn" onclick="openSettings()" title="Settings">⚙</button>
    </div>
  </div>

  <div class="logs-panel collapsed" id="logsPanel">
    <div class="logs-header" onclick="toggleLogs()">
      <div class="logs-title">Execution Logs</div>
      <div class="logs-toggle">&#x25BC;</div>
    </div>
    <div class="logs-body" id="logsBody">
      <div class="logs-sessions" id="sessionList"></div>
      <div class="logs-timeline" id="logTimeline">
        <div class="log-empty">Select a session to view its conversation</div>
      </div>
    </div>
  </div>
</div>

<div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
<div class="drawer" id="drawer">
  <div class="drawer-header">
    <h3 id="drawerTitle">Node Inspector</h3>
    <button class="drawer-close" onclick="closeDrawer()">&#x2715;</button>
  </div>
  <div class="drawer-tabs">
    <button class="drawer-tab active" data-tab="params" onclick="switchDrawerTab(this,'params')">Parameters</button>
    <button class="drawer-tab" data-tab="info" onclick="switchDrawerTab(this,'info')">Node Info</button>
  </div>
  <div class="drawer-body" id="drawerBody"></div>
  <div class="drawer-actions" id="drawerActions" style="display:none">
    <button class="btn-cancel" onclick="closeDrawer()">Cancel</button>
    <button class="btn-save" id="btnSave" onclick="saveSettings()">Save Changes</button>
  </div>
</div>

<script>
let dashboardData = null;
let selectedNodeId = null;
let activeSessionId = null;
window.settingsDirty = {};
let drawerTab = 'params';

let panX = 0, panY = 0, zoom = 1;
let isPanning = false, panStartX = 0, panStartY = 0;

let dragNode = null;
let dragStartX = 0, dragStartY = 0;
let dragNodeStartX = 0, dragNodeStartY = 0;
let isDragging = false;
const DRAG_THRESHOLD = 5;

const NODES = [
  { id:'webhook', name:'Webhook', x:40, y:80, icon:'⚡', color:'purple',
    desc:'POST /api/chat', badge:'trigger', badgeText:'Trigger',
    detail:'Receives chatInput + sessionId via POST. Entry point for the chatbot workflow.',
    editable:false },
  { id:'fetch-content', name:'Fetch Site Content', x:280, y:80, icon:'🌐', color:'mint',
    desc:'GET site-content.json', badge:'http', badgeText:'HTTP',
