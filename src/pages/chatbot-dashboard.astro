function updateTransform() {
  const transform = document.getElementById('canvasTransform');
  transform.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`;
  const bg = document.getElementById('canvasBg');
  bg.style.backgroundPosition = `${panX}px ${panY}px`;
}

function fitToView() {
  if (!NODES.length) return;
  const padding = 100;
  const nodeW = 220, nodeH = 70;
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  NODES.forEach(n => {
    minX = Math.min(minX, n.x);
    minY = Math.min(minY, n.y);
    maxX = Math.max(maxX, n.x + nodeW);
    maxY = Math.max(maxY, n.y + nodeH);
  });
  const container = document.getElementById('canvasContainer');
  const containerW = container.clientWidth;
  const containerH = container.clientHeight - 40;
  const contentW = maxX - minX + padding * 2;
  const contentH = maxY - minY + padding * 2;
  const scaleX = containerW / contentW;
  const scaleY = containerH / contentH;
  zoom = Math.min(scaleX, scaleY, 1.2);
  panX = (containerW - contentW * zoom) / 2 - minX * zoom + padding * zoom;
  panY = (containerH - contentH * zoom) / 2 - minY * zoom + padding * zoom;
  updateTransform();
}

function zoomIn() { zoom = Math.min(2.5, zoom * 1.2); updateTransform(); }
function zoomOut() { zoom = Math.max(0.3, zoom / 1.2); updateTransform(); }

const canvasContainer = document.getElementById('canvasContainer');

canvasContainer.addEventListener('mousedown', (e) => {
  if (e.target.closest('.node') || e.target.closest('.zoom-controls') || e.target.closest('.drawer')) return;
  isPanning = true;
  panStartX = e.clientX - panX;
  panStartY = e.clientY - panY;
  canvasContainer.style.cursor = 'grabbing';
});

window.addEventListener('mousemove', (e) => {
  if (dragNode) {
    const dx = (e.clientX - dragStartX) / zoom;
    const dy = (e.clientY - dragStartY) / zoom;
    if (!isDragging && Math.abs(dx) > DRAG_THRESHOLD / zoom && Math.abs(dy) > DRAG_THRESHOLD / zoom) {
      isDragging = true;
      dragNode.el.classList.add('dragging');
    }
    if (isDragging) {
      dragNode.node.x = dragNodeStartX + dx;
      dragNode.node.y = dragNodeStartY + dy;
      dragNode.el.style.left = dragNode.node.x + 'px';
      dragNode.el.style.top = dragNode.node.y + 'px';
      renderConnections();
    }
    return;
  }
  if (isPanning) {
    panX = e.clientX - panStartX;
    panY = e.clientY - panStartY;
    updateTransform();
  }
});

window.addEventListener('mouseup', () => {
  if (dragNode) {
    dragNode.el.classList.remove('dragging');
    if (!isDragging) {
      openNodeDrawer(dragNode.node.id);
    }
    dragNode = null;
    isDragging = false;
    return;
  }
  isPanning = false;
  canvasContainer.style.cursor = 'default';
});

canvasContainer.addEventListener('wheel', (e) => {
  if (e.ctrlKey || e.metaKey) {
    e.preventDefault();
    const delta = e.deltaY > 0 ? 0.9 : 1.1;
    const newZoom = Math.max(0.3, Math.min(2.5, zoom * delta));
    const rect = canvasContainer.getBoundingClientRect();
    const mouseX = e.clientX - rect.left;
    const mouseY = e.clientY - rect.top;
    panX = mouseX - (mouseX - panX) * (newZoom / zoom);
    panY = mouseY - (mouseY - panY) * (newZoom / zoom);
    zoom = newZoom;
    updateTransform();
  }
}, { passive: false });

function renderWorkflow() {
  const transform = document.getElementById('canvasTransform');
  transform.querySelectorAll('.node').forEach(el => el.remove());

  NODES.forEach(n => {
    const el = document.createElement('div');
    el.className = 'node';
    el.id = 'node-' + n.id;
    el.style.left = n.x + 'px';
    el.style.top = n.y + 'px';
    el.innerHTML = `
      <div class="node-box">
        <div class="node-accent ${n.color}"></div>
        <div class="port input"></div>
        <div class="node-icon ${n.color}">${n.icon}</div>
        <div class="node-content">
          <div class="node-name">${n.name}</div>
          <div class="node-desc">${n.desc}</div>
        </div>
        <span class="node-badge ${n.badge}">${n.badgeText}</span>
        <div class="port output"></div>
      </div>
    `;
    el.addEventListener('mousedown', (e) => {
      e.stopPropagation();
      dragNode = { node: n, el, startMouseX: e.clientX, startMouseY: e.clientY };
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragNodeStartX = n.x;
      dragNodeStartY = n.y;
      isDragging = false;
    });
    transform.appendChild(el);
  });

  renderConnections();
}

function renderConnections() {
  const svg = document.getElementById('connectionsSvg');
  svg.innerHTML = '';
  const nodeW = 220, nodeH = 70;
  CONNECTIONS.forEach(c => {
    const fromEl = document.getElementById('node-' + c.from);
    const toEl = document.getElementById('node-' + c.to);
    if (!fromEl || !toEl) return;
    const fromX = parseInt(fromEl.style.left) + nodeW;
    const fromY = parseInt(fromEl.style.top) + nodeH / 2;
    const toX = parseInt(toEl.style.left);
    const toY = parseInt(toEl.style.top) + nodeH / 2;
    const dx = (toX - fromX) / 2;
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', `M${fromX},${fromY} C${fromX + dx},${fromY} ${toX - dx},${toY} ${toX},${toY}`);
    path.setAttribute('class', 'conn-line' + (c.style === 'mint' ? ' mint' : ''));
    svg.appendChild(path);
  });
}

function openNodeDrawer(nodeId) {
  const node = NODES.find(n => n.id === nodeId);
  if (!node) return;
  selectedNodeId = nodeId;

  document.querySelectorAll('.node').forEach(el => el.classList.remove('selected'));
  const el = document.getElementById('node-' + nodeId);
  if (el) el.classList.add('selected');

  document.getElementById('drawerTitle').textContent = node.name;
  drawerTab = 'params';
  document.querySelectorAll('.drawer-tab').forEach(t => t.classList.remove('active'));
  document.querySelector('.drawer-tab[data-tab="params"]').classList.add('active');

  renderDrawerContent(node);
  document.getElementById('drawer').classList.add('open');
  document.getElementById('drawerOverlay').classList.add('open');
}

function closeDrawer() {
  document.getElementById('drawer').classList.remove('open');
  document.getElementById('drawerOverlay').classList.remove('open');
  document.querySelectorAll('.node').forEach(el => el.classList.remove('selected'));
  selectedNodeId = null;
  settingsDirty = {};
  document.getElementById('drawerActions').style.display = 'none';
}

function switchDrawerTab(btn, tab) {
  drawerTab = tab;
  document.querySelectorAll('.drawer-tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  const node = NODES.find(n => n.id === selectedNodeId);
  if (node) renderDrawerContent(node);
}

function renderDrawerContent(node) {
  const body = document.getElementById('drawerBody');

  if (drawerTab === 'info') {
    body.innerHTML = `
      <div class="drawer-section">
        <h4>Node Info</h4>
        <p style="font-size:13px;color:#CBD5E1;line-height:1.6;">${node.detail}</p>
        <div style="margin-top:12px;"><span class="node-badge ${node.badge}">${node.badgeText}</span></div>
      </div>
    `;
    document.getElementById('drawerActions').style.display = 'none';
    return;
  }

  if (node.editable && node.fields) {
    const settings = dashboardData?.settings || {};
    let html = `<div class="drawer-section"><h4>Configuration</h4>`;
    node.fields.forEach(f => {
      const val = settings[f.key] ?? '';
      if (f.type === 'textarea') {
        html += `<div class="drawer-field">
          <label>${f.label}</label>
          <textarea data-key="${f.key}" oninput="markDirty('${f.key}',this.value)">${escapeHtml(String(val))}</textarea>
          ${f.hint ? `<div class="hint">${f.hint}</div>` : ''}
        </div>`;
      } else if (f.type === 'select') {
        html += `<div class="drawer-field">
          <label>${f.label}</label>
          <select data-key="${f.key}" onchange="markDirty('${f.key}',this.value)">`;
        f.options.forEach(opt => {
          html += `<option value="${opt.value}" ${val === opt.value ? 'selected' : ''}>${opt.label}</option>`;
        });
        html += `</select>
          ${f.hint ? `<div class="hint">${f.hint}</div>` : ''}
        </div>`;
      } else if (f.type === 'number') {
        html += `<div class="drawer-field">
          <label>${f.label}</label>
          <input type="number" min="${f.min||1}" max="${f.max||999}" value="${val}" data-key="${f.key}" oninput="markDirty('${f.key}',Number(this.value))" />
          ${f.hint ? `<div class="hint">${f.hint}</div>` : ''}
        </div>`;
      } else if (f.type === 'password') {
        html += `<div class="drawer-field">
          <label>${f.label}</label>
          <input type="password" value="${escapeHtml(String(val))}" data-key="${f.key}" oninput="markDirty('${f.key}',this.value)" placeholder="Enter API key" />
          ${f.hint ? `<div class="hint">${f.hint}</div>` : ''}
        </div>`;
      } else {
        html += `<div class="drawer-field">
          <label>${f.label}</label>
          <input type="text" value="${escapeHtml(String(val))}" data-key="${f.key}" oninput="markDirty('${f.key}',this.value)" />
          ${f.hint ? `<div class="hint">${f.hint}</div>` : ''}
        </div>`;
      }
    });
    html += `</div>`;
    body.innerHTML = html;
    document.getElementById('drawerActions').style.display = 'flex';
  } else {
    body.innerHTML = `
      <div class="drawer-section">
        <h4>Node Info</h4>
        <p style="font-size:13px;color:#CBD5E1;line-height:1.6;">${node.detail}</p>
        <div style="margin-top:12px;"><span class="node-badge ${node.badge}">${node.badgeText}</span></div>
      </div>
    `;
    document.getElementById('drawerActions').style.display = 'none';
  }
}

