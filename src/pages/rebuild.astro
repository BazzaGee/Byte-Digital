---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import RebuildWizard from '../components/RebuildWizard.astro';
---

<FunnelLayout
  title="Free Website Rebuild — No Payment Needed | Byte Digital"
  description="Tell me about your business in six quick questions and I will rebuild your website free. No payment, no invoice, no card details, no obligation. Based in Christchurch, New Zealand."
>
  <div class="rb-overlay">
    <a class="rb-exit" href="/" data-rb-exit aria-label="Back to Byte Digital">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" />
      </svg>
      <span>Back to Byte Digital</span>
    </a>

    <div class="rb-stage">
      <div class="rb-intro">
        <p class="rb-free">Free rebuild — nothing to pay</p>
        <h1>Let&rsquo;s rebuild <span class="gradient-text">your website</span>.</h1>
        <p>Six quick questions — no scrolling, no jargon. Tell me what you do and what you want to see, and I&rsquo;ll do the rest.</p>
      </div>

      <RebuildWizard />

      <p class="rb-footnote">Takes about two minutes &middot; no tech skills needed</p>
    </div>
  </div>
</FunnelLayout>

<style is:global>
  .rb-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.4vh, 16px);
    padding: clamp(12px, 2.5vh, 28px) clamp(12px, 3vw, 28px);
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .rb-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.8vh, 20px);
    width: 100%;
    /* The card owns the leftover space rather than growing past the viewport,
       so the overlay never has to scroll. Content height while it fits; clamped
       (with the step body scrolling inside it) when it does not. overflow:hidden
       is the backstop, so a step can never spill outside the card. */
    flex: 0 1 auto;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
  }

  .rb-intro {
    text-align: center;
    max-width: 640px;
  }

  .rb-free {
    display: inline-block;
    margin: 0 0 10px;
    padding: 5px 12px;
    border-radius: 999px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--secondary);
    background: rgba(94, 234, 212, 0.08);
    border: 1px solid rgba(94, 234, 212, 0.2);
  }

  .rb-intro h1 {
    margin: 0;
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .rb-intro p {
    margin: 6px 0 0;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .rb-footnote {
    margin: 0;
    font-size: 12px;
    color: var(--text-dimmed);
    text-align: center;
  }

  /* Once the brief is in, the wizard is the whole show: the intro copy ("six
     quick questions") is no longer true, and the vertical space belongs to
     the build animation. */
  .rb-building .rb-intro,
  .rb-building .rb-footnote {
    display: none;
  }

  .rb-exit {
    position: absolute;
    top: clamp(10px, 1.8vh, 18px);
    left: clamp(10px, 2vw, 20px);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    min-height: 38px;
    border-radius: 999px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .rb-exit:hover {
    color: #fff;
    border-color: rgba(94, 234, 212, 0.5);
    background: rgba(94, 234, 212, 0.08);
  }

  /* Short viewports (landscape phones, small laptops in a split window): drop
     the supporting copy rather than forcing the card to scroll. The free
     promise and the card's own lede both stay. */
  @media (max-height: 720px) {
    .rb-intro p:not(.rb-free),
    .rb-footnote {
      display: none;
    }
  }

  /* Phones: the label would sit across the headline, so the exit collapses to
     the arrow alone (aria-label keeps the accessible name). The subhead goes
     too — the free promise and the card's own lede are what matter here, and
     the vertical space belongs to the step. */
  @media (max-width: 640px) {
    .rb-exit {
      width: 38px;
      padding: 9px;
      justify-content: center;
    }

    .rb-exit span {
      display: none;
    }

    .rb-intro p:not(.rb-free) {
      display: none;
    }

    .rb-free {
      margin-bottom: 8px;
      padding: 4px 10px;
      font-size: 10px;
      letter-spacing: 1.6px;
    }
  }
</style>

<script>
  const exit = document.querySelector<HTMLAnchorElement>('[data-rb-exit]');

  // Arriving from a built site (a *.pages.dev funnel popup) means "back" is the
  // site they were just reading. Arriving from this site's own nav means "back"
  // would loop them through the CTA they already clicked, so go home instead.
  if (exit) {
    exit.addEventListener('click', (event) => {
      let fromElsewhere = false;
      try {
        fromElsewhere = !!document.referrer && new URL(document.referrer).host !== window.location.host;
      } catch {
        fromElsewhere = false;
      }
      if (!fromElsewhere) return;
      event.preventDefault();
      if (window.history.length > 1) window.history.back();
      else window.location.href = '/';
    });
  }
</script>