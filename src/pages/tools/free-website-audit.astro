---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Divider from '../../components/Divider.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="Free Website Audit Tool NZ | Real Google Data | Byte Digital"
  description="Run a free website audit powered by real Google PageSpeed data. Check performance, SEO, accessibility and best practices — with actionable recommendations for your NZ business website."
>
  <PageHero
    label="Free Tool"
    title="Free Website<br /><span class='gradient-text'>Audit Tool</span>"
    subtitle="Enter your URL and get a real audit based on Google's own PageSpeed data — performance, SEO, accessibility, and the fixes that matter."
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Tools', href: '/tools/' },
      { label: 'Free Website Audit' },
    ]}
  />

  <section class="section dot-pattern" style="padding-top:0">
    <div class="container">
      <div class="dm-header" style="max-width:700px;margin:0 auto">
        <div style="display:flex;flex-direction:column;gap:28px">
          <div id="audit-input-section">
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">Enter your website URL</label>
            <div style="display:flex;gap:10px">
              <input
                type="url"
                id="audit-url"
                placeholder="https://www.example.co.nz"
                style="flex:1;padding:14px 18px;border-radius:12px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);color:#fff;font-family:'Space Grotesk',sans-serif;font-size:15px;outline:none;transition:border-color 0.3s"
                onfocus="this.style.borderColor='var(--secondary)'"
                onblur="this.style.borderColor='rgba(255,255,255,0.1)'"
              />
              <button
                type="button"
                id="audit-btn"
                class="btn-cta"
                style="font-size:14px;white-space:nowrap;padding:14px 28px"
                onclick="runAudit()"
              >
                Run Free Audit
              </button>
            </div>
            <p id="audit-error" style="display:none;font-size:13px;color:#f87171;margin-top:8px"></p>
          </div>

          <div id="audit-loading" style="display:none;text-align:center;padding:60px 0">
            <div style="width:48px;height:48px;border:3px solid rgba(255,255,255,0.08);border-top-color:var(--secondary);border-radius:50%;margin:0 auto 20px;animation:spin 0.8s linear infinite"></div>
            <p style="font-size:16px;color:var(--text-secondary);font-weight:500">Running a real Google PageSpeed audit...</p>
            <p id="audit-step" style="font-size:13px;color:var(--text-muted);margin-top:6px">Contacting Google — this takes 20-40 seconds</p>
          </div>

          <div id="audit-results" style="display:none">
            <div style="padding:28px;border-radius:24px;background:linear-gradient(135deg,rgba(139,120,230,0.08),rgba(94,234,212,0.08));border:1px solid rgba(94,234,212,0.15);text-align:center;margin-bottom:24px">
              <p style="font-size:13px;color:var(--text-muted);text-transform:uppercase;letter-spacing:2px;margin-bottom:4px">Overall Score</p>
              <p id="audit-url-display" style="font-size:14px;color:var(--text-secondary);margin-bottom:12px;word-break:break-all"></p>
              <div id="overall-score" style="font-size:clamp(56px,10vw,80px);font-weight:700;background:linear-gradient(135deg,#8B78E6,#5EEAD4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:8px">0</div>
              <p style="font-size:13px;color:var(--text-muted)">out of 100 · mobile · real Google PageSpeed data</p>
            </div>

            <div style="display:flex;flex-direction:column;gap:16px" id="audit-categories"></div>

            <div style="margin-top:24px;padding:24px;border-radius:20px;background:rgba(19,19,26,0.75);border:1px solid rgba(255,255,255,0.08)">
              <h4 style="font-size:15px;font-weight:600;color:#fff;margin-bottom:12px">Core Web Vitals &amp; Key Metrics</h4>
              <div id="audit-metrics" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px"></div>
            </div>

            <div style="margin-top:32px;padding:28px;border-radius:24px;background:rgba(19,19,26,0.75);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.08);text-align:center">
              <h3 style="font-size:20px;font-weight:700;color:#fff;margin-bottom:8px">Want these fixes actually done?</h3>
              <p style="font-size:14px;color:var(--text-muted);margin-bottom:20px">This scan shows you what Google sees. We fix what it finds — properly, on modern architecture, with before/after proof.</p>
              <a href="/contact/" class="btn-cta" style="font-size:14px">Get a Full Website Audit</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Divider />
  <CTASection />
</BaseLayout>

<style>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .audit-card {
    padding: 24px;
    border-radius: 20px;
    background: rgba(19,19,26,0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.08);
  }
  .score-ring {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
  }
  .score-ring.good {
    background: rgba(34,197,94,0.12);
    border: 2px solid rgba(34,197,94,0.4);
    color: #22c55e;
  }
  .score-ring.okay {
    background: rgba(234,179,8,0.12);
    border: 2px solid rgba(234,179,8,0.4);
    color: #eab308;
  }
  .score-ring.poor {
    background: rgba(239,68,68,0.12);
    border: 2px solid rgba(239,68,68,0.4);
    color: #ef4444;
  }
  .audit-rec {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 6px 0;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .audit-rec::before {
    content: '→';
    color: var(--secondary);
    flex-shrink: 0;
    margin-top: 1px;
  }
  .metric-box {
    padding: 14px;
    border-radius: 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    text-align: center;
  }
</style>

<script>
interface LighthouseCategory {
  score: number | null;
}

interface LighthouseAudit {
  title: string;
  displayValue?: string;
  score?: number | null;
  details?: { type?: string; overallSavingsMs?: number };
}

interface PSIResponse {
  lighthouseResult?: {
    categories?: Record<string, LighthouseCategory>;
    audits?: Record<string, LighthouseAudit>;
  };
  error?: { message: string };
}

function getGrade(score: number): 'good' | 'okay' | 'poor' {
  if (score >= 90) return 'good';
  if (score >= 50) return 'okay';
  return 'poor';
}

function getGradeLabel(grade: string): string {
  if (grade === 'good') return 'Good';
  if (grade === 'okay') return 'Needs Work';
  return 'Poor';
}

function getGradeColor(grade: string): string {
  if (grade === 'good') return '#22c55e';
  if (grade === 'okay') return '#eab308';
  return '#ef4444';
}

const CATEGORY_META: Record<string, { label: string; icon: string; notes: string[] }> = {
  performance: {
    label: 'Performance',
    icon: '⚡',
    notes: [
      'Compress and resize images (WebP/AVIF)',
      'Pre-build pages on fast hosting (headless/SSG)',
      'Cut render-blocking scripts and unused code',
    ],
  },
  seo: {
    label: 'SEO',
    icon: '🔍',
    notes: [
      'Write unique title tags and meta descriptions',
      'Add structured data and valid heading hierarchy',
      'Ensure the page is indexable and internally linked',
    ],
  },
  accessibility: {
    label: 'Accessibility',
    icon: '♿',
    notes: [
      'Add alt text to meaningful images',
      'Fix colour contrast below WCAG AA',
      'Label all form fields and buttons',
    ],
  },
  'best-practices': {
    label: 'Best Practices',
    icon: '✅',
    notes: [
      'Serve over HTTPS with modern security headers',
      'Fix browser console errors',
      'Use up-to-date libraries and images',
    ],
  },
};

const METRICS: Array<{ id: string; label: string; good: number; poor: number; unit?: string; invert?: boolean }> = [
  { id: 'first-contentful-paint', label: 'First Paint', good: 1.8, poor: 3.0, unit: 's' },
  { id: 'largest-contentful-paint', label: 'LCP', good: 2.5, poor: 4.0, unit: 's' },
  { id: 'total-blocking-time', label: 'Total Blocking', good: 200, poor: 600, unit: 'ms' },
  { id: 'cumulative-layout-shift', label: 'Layout Shift', good: 0.1, poor: 0.25 },
  { id: 'speed-index', label: 'Speed Index', good: 3.4, poor: 5.8, unit: 's' },
];

const steps = [
  'Fetching the page like Googlebot does',
  'Running Lighthouse performance audits',
  'Checking SEO and accessibility signals',
  'Crunching Core Web Vitals',
  'Compiling recommendations',
];

(window as any).runAudit = async function () {
  const input = document.getElementById('audit-url') as HTMLInputElement;
  const errorEl = document.getElementById('audit-error');
  const loadingEl = document.getElementById('audit-loading');
  const resultsEl = document.getElementById('audit-results');
  const inputSection = document.getElementById('audit-input-section');
  const stepEl = document.getElementById('audit-step');

  let url = input.value.trim();
  errorEl!.style.display = 'none';

  if (!url) {
    errorEl!.textContent = 'Please enter a URL to audit.';
    errorEl!.style.display = 'block';
    return;
  }
  if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
  try {
    const parsed = new URL(url);
    if (!parsed.hostname.includes('.')) throw new Error('bad');
  } catch {
    errorEl!.textContent = 'Please enter a valid URL (e.g. https://www.example.co.nz).';
    errorEl!.style.display = 'block';
    return;
  }

  resultsEl!.style.display = 'none';
  loadingEl!.style.display = 'block';
  inputSection!.style.opacity = '0.5';
  inputSection!.style.pointerEvents = 'none';

  const btn = document.getElementById('audit-btn') as HTMLButtonElement;
  btn.textContent = 'Auditing...';
  btn.disabled = true;

  let stepIdx = 0;
  stepEl!.textContent = steps[0];
  const stepTimer = setInterval(() => {
    stepIdx = Math.min(stepIdx + 1, steps.length - 1);
    stepEl!.textContent = steps[stepIdx];
  }, 7000);

  let data: PSIResponse;
  try {
    const api = `https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=${encodeURIComponent(url)}&strategy=mobile&category=performance&category=seo&category=accessibility&category=best-practices`;
    const res = await fetch(api);
    if (res.status === 429) {
      throw new Error("Google's free audit quota for your network is busy right now — please try again in a minute.");
    }
    data = await res.json();
    if (data.error) throw new Error(data.error.message || 'Google returned an error');
    if (!data.lighthouseResult?.categories) throw new Error('Google could not audit this page (it may be down, redirecting, or blocking bots).');
  } catch (err) {
    clearInterval(stepTimer);
    loadingEl!.style.display = 'none';
    inputSection!.style.opacity = '1';
    inputSection!.style.pointerEvents = 'auto';
    btn.textContent = 'Run Free Audit';
    btn.disabled = false;
    errorEl!.textContent = err instanceof Error ? err.message : 'Audit failed — please check the URL and try again.';
    errorEl!.style.display = 'block';
    return;
  }
  clearInterval(stepTimer);

  const categories = data.lighthouseResult!.categories!;
  const audits = data.lighthouseResult!.audits || {};

  const perfScore = Math.round((categories.performance?.score ?? 0) * 100);
  const catScores = Object.keys(CATEGORY_META)
    .filter((k) => categories[k]?.score != null)
    .map((k) => ({ key: k, score: Math.round((categories[k]!.score as number) * 100) }));
  const overall = catScores.length
    ? Math.round(catScores.reduce((a, b) => a + b.score, 0) / catScores.length)
    : perfScore;

  if (typeof (window as any).gtag === 'function') {
    (window as any).gtag('event', 'tool_used', { tool: 'free-website-audit', score: overall });
  }

  (document.getElementById('overall-score') as HTMLElement).textContent = String(overall);
  (document.getElementById('audit-url-display') as HTMLElement).textContent = url;

  const container = document.getElementById('audit-categories')!;
  container.innerHTML = '';

  catScores.forEach(({ key, score }) => {
    const meta = CATEGORY_META[key];
    const grade = getGrade(score);
    const numRecs = grade === 'good' ? 1 : grade === 'okay' ? 2 : 3;
    const recs = meta.notes.slice(0, numRecs);

    const card = document.createElement('div');
    card.className = 'audit-card';
    card.innerHTML = `
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:14px">
        <div style="font-size:24px">${meta.icon}</div>
        <div style="flex:1">
          <div style="display:flex;align-items:center;justify-content:space-between">
            <h4 style="font-size:16px;font-weight:600;color:#fff;margin:0">${meta.label}</h4>
            <div class="score-ring ${grade}">${score}</div>
          </div>
          <div style="margin-top:6px;height:4px;border-radius:2px;background:rgba(255,255,255,0.06);overflow:hidden">
            <div style="height:100%;width:${score}%;border-radius:2px;background:${getGradeColor(grade)};transition:width 0.8s ease"></div>
          </div>
          <p style="font-size:12px;color:${getGradeColor(grade)};margin-top:4px;font-weight:500">${getGradeLabel(grade)} — real Google Lighthouse score</p>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:2px">
        ${recs.map((r) => `<div class="audit-rec">${r}</div>`).join('')}
      </div>
    `;
    container.appendChild(card);
  });

  const metricsEl = document.getElementById('audit-metrics')!;
  metricsEl.innerHTML = '';
  METRICS.forEach((m) => {
    const audit = audits[m.id];
    if (!audit || audit.displayValue == null) return;
    const raw = parseFloat(String(audit.displayValue).replace(/[^\d.]/g, ''));
    const grade = m.invert
      ? raw >= m.good ? 'good' : raw >= m.poor ? 'okay' : 'poor'
      : raw <= m.good ? 'good' : raw <= m.poor ? 'okay' : 'poor';
    const box = document.createElement('div');
    box.className = 'metric-box';
    box.innerHTML = `
      <div style="font-size:18px;font-weight:700;color:${getGradeColor(grade)}">${audit.displayValue}</div>
      <div style="font-size:11px;color:var(--text-muted);margin-top:4px">${m.label}</div>
    `;
    metricsEl.appendChild(box);
  });

  loadingEl!.style.display = 'none';
  resultsEl!.style.display = 'block';
  inputSection!.style.opacity = '1';
  inputSection!.style.pointerEvents = 'auto';
  btn.textContent = 'Re-run Audit';
  btn.disabled = false;

  resultsEl!.scrollIntoView({ behavior: 'smooth', block: 'start' });
};
</script>
