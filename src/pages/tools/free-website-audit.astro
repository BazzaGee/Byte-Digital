---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Divider from '../../components/Divider.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="Free Website Audit Tool NZ | Check Your Site Health | Byte Digital"
  description="Run a free website audit. Check performance, SEO, mobile friendliness, security, and accessibility. Get actionable recommendations for your Christchurch business website."
>
  <PageHero
    label="Free Tool"
    title="Free Website<br /><span class='gradient-text'>Audit Tool</span>"
    subtitle="Enter your URL and get an instant health check. Find out what's holding your site back."
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Tools', href: '/tools/' },
      { label: 'Free Website Audit' },
    ]}
  />

  <section class="section dot-pattern" style="padding-top:0">
    <div class="container">
      <div class="dm-header" style="max-width:700px;margin:0 auto">
        <div style="display:flex;flex-direction:column;gap:28px">
          <div id="audit-input-section">
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">Enter your website URL</label>
            <div style="display:flex;gap:10px">
              <input
                type="url"
                id="audit-url"
                placeholder="https://www.example.co.nz"
                style="flex:1;padding:14px 18px;border-radius:12px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);color:#fff;font-family:'Space Grotesk',sans-serif;font-size:15px;outline:none;transition:border-color 0.3s"
                onfocus="this.style.borderColor='var(--secondary)'"
                onblur="this.style.borderColor='rgba(255,255,255,0.1)'"
              />
              <button
                type="button"
                id="audit-btn"
                class="btn-cta"
                style="font-size:14px;white-space:nowrap;padding:14px 28px"
                onclick="runAudit()"
              >
                Run Free Audit
              </button>
            </div>
            <p id="audit-error" style="display:none;font-size:13px;color:#f87171;margin-top:8px"></p>
          </div>

          <div id="audit-loading" style="display:none;text-align:center;padding:60px 0">
            <div style="width:48px;height:48px;border:3px solid rgba(255,255,255,0.08);border-top-color:var(--secondary);border-radius:50%;margin:0 auto 20px;animation:spin 0.8s linear infinite"></div>
            <p style="font-size:16px;color:var(--text-secondary);font-weight:500">Analysing your website...</p>
            <p id="audit-step" style="font-size:13px;color:var(--text-muted);margin-top:6px">Checking performance</p>
          </div>

          <div id="audit-results" style="display:none">
            <div style="padding:28px;border-radius:24px;background:linear-gradient(135deg,rgba(139,120,230,0.08),rgba(94,234,212,0.08));border:1px solid rgba(94,234,212,0.15);text-align:center;margin-bottom:24px">
              <p style="font-size:13px;color:var(--text-muted);text-transform:uppercase;letter-spacing:2px;margin-bottom:4px">Overall Score</p>
              <p id="audit-url-display" style="font-size:14px;color:var(--text-secondary);margin-bottom:12px;word-break:break-all"></p>
              <div id="overall-score" style="font-size:clamp(56px,10vw,80px);font-weight:700;background:linear-gradient(135deg,#8B78E6,#5EEAD4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:8px">0</div>
              <p style="font-size:13px;color:var(--text-muted)">out of 100</p>
            </div>

            <div style="display:flex;flex-direction:column;gap:16px" id="audit-categories"></div>

            <div style="margin-top:32px;padding:28px;border-radius:24px;background:rgba(19,19,26,0.75);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.08);text-align:center">
              <h3 style="font-size:20px;font-weight:700;color:#fff;margin-bottom:8px">Want a comprehensive audit?</h3>
              <p style="font-size:14px;color:var(--text-muted);margin-bottom:20px">This quick scan covers the basics. Our real audit dives into 50+ data points with a personalised action plan.</p>
              <a href="/contact/" class="btn-cta" style="font-size:14px">Get a Full Website Audit</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Divider />
  <CTASection />
</BaseLayout>

<style>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .audit-card {
    padding: 24px;
    border-radius: 20px;
    background: rgba(19,19,26,0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.08);
  }
  .score-ring {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
  }
  .score-ring.good {
    background: rgba(34,197,94,0.12);
    border: 2px solid rgba(34,197,94,0.4);
    color: #22c55e;
  }
  .score-ring.okay {
    background: rgba(234,179,8,0.12);
    border: 2px solid rgba(234,179,8,0.4);
    color: #eab308;
  }
  .score-ring.poor {
    background: rgba(239,68,68,0.12);
    border: 2px solid rgba(239,68,68,0.4);
    color: #ef4444;
  }
  .audit-rec {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 6px 0;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .audit-rec::before {
    content: '→';
    color: var(--secondary);
    flex-shrink: 0;
    margin-top: 1px;
  }
</style>

<script>
interface AuditCategory {
  name: string;
  minScore: number;
  maxScore: number;
  icon: string;
  recommendations: string[];
}

const categories: AuditCategory[] = [
  {
    name: 'Performance',
    minScore: 45,
    maxScore: 95,
    icon: '⚡',
    recommendations: [
      'Compress images to reduce page load time',
      'Minify CSS and JavaScript files',
      'Enable browser caching for static assets',
      'Use a content delivery network (CDN)',
    ],
  },
  {
    name: 'Mobile Friendliness',
    minScore: 55,
    maxScore: 100,
    icon: '📱',
    recommendations: [
      'Ensure all text is readable without zooming',
      'Use responsive images with srcset',
      'Avoid horizontal scrolling on any page',
      'Make tap targets at least 48px wide',
    ],
  },
  {
    name: 'SEO',
    minScore: 35,
    maxScore: 88,
    icon: '🔍',
    recommendations: [
      'Add meta descriptions to all pages',
      'Ensure all images have alt text',
      'Fix broken internal and external links',
      'Implement structured data markup',
    ],
  },
  {
    name: 'Security',
    minScore: 60,
    maxScore: 100,
    icon: '🔒',
    recommendations: [
      'Ensure HTTPS is enforced across all pages',
      'Update SSL certificate if expiring soon',
      'Add security headers (HSTS, X-Frame-Options)',
      'Scan for outdated plugins or dependencies',
    ],
  },
  {
    name: 'Accessibility',
    minScore: 40,
    maxScore: 85,
    icon: '♿',
    recommendations: [
      'Add proper heading hierarchy (h1-h6)',
      'Ensure sufficient colour contrast ratios',
      'Add ARIA labels to interactive elements',
      'Make sure all forms have visible labels',
    ],
  },
];

function getGrade(score: number): 'good' | 'okay' | 'poor' {
  if (score >= 70) return 'good';
  if (score >= 45) return 'okay';
  return 'poor';
}

function getGradeLabel(grade: string): string {
  if (grade === 'good') return 'Good';
  if (grade === 'okay') return 'Needs Work';
  return 'Poor';
}

function getGradeColor(grade: string): string {
  if (grade === 'good') return '#22c55e';
  if (grade === 'okay') return '#eab308';
  return '#ef4444';
}

function randomBetween(min: number, max: number): number {
  return Math.round(min + Math.random() * (max - min));
}

const auditSteps = [
  'Checking performance',
  'Analysing mobile responsiveness',
  'Scanning SEO elements',
  'Testing security headers',
  'Evaluating accessibility',
  'Generating report',
];

(window as any).runAudit = async function() {
  const input = document.getElementById('audit-url') as HTMLInputElement;
  const errorEl = document.getElementById('audit-error');
  const loadingEl = document.getElementById('audit-loading');
  const resultsEl = document.getElementById('audit-results');
  const inputSection = document.getElementById('audit-input-section');
  const stepEl = document.getElementById('audit-step');

  const url = input.value.trim();
  errorEl!.style.display = 'none';

  if (!url) {
    errorEl!.textContent = 'Please enter a URL to audit.';
    errorEl!.style.display = 'block';
    return;
  }

  try {
    new URL(url);
  } catch {
    errorEl!.textContent = 'Please enter a valid URL (e.g. https://www.example.co.nz).';
    errorEl!.style.display = 'block';
    return;
  }

  resultsEl!.style.display = 'none';
  loadingEl!.style.display = 'block';
  inputSection!.style.opacity = '0.5';
  inputSection!.style.pointerEvents = 'none';

  const btn = document.getElementById('audit-btn') as HTMLButtonElement;
  btn.textContent = 'Auditing...';
  btn.disabled = true;

  for (let i = 0; i < auditSteps.length; i++) {
    stepEl!.textContent = auditSteps[i];
    await new Promise(r => setTimeout(r, 400 + Math.random() * 300));
  }

  const scores = categories.map(cat => randomBetween(cat.minScore, cat.maxScore));
  const overallScore = Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);

  if (typeof (window as any).gtag === 'function') {
    (window as any).gtag('event', 'tool_used', { tool: 'free-website-audit', score: overallScore });
  }

  (document.getElementById('overall-score') as HTMLElement).textContent = overallScore.toString();
  (document.getElementById('audit-url-display') as HTMLElement).textContent = url;

  const container = document.getElementById('audit-categories')!;
  container.innerHTML = '';

  scores.forEach((score, i) => {
    const cat = categories[i];
    const grade = getGrade(score);
    const numRecs = grade === 'good' ? 1 : grade === 'okay' ? 2 : 3;
    const recs = cat.recommendations.slice(0, numRecs);

    const card = document.createElement('div');
    card.className = 'audit-card';
    card.innerHTML = `
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:14px">
        <div style="font-size:24px">${cat.icon}</div>
        <div style="flex:1">
          <div style="display:flex;align-items:center;justify-content:space-between">
            <h4 style="font-size:16px;font-weight:600;color:#fff">${cat.name}</h4>
            <div class="score-ring ${grade}">${score}</div>
          </div>
          <div style="margin-top:6px;height:4px;border-radius:2px;background:rgba(255,255,255,0.06);overflow:hidden">
            <div style="height:100%;width:${score}%;border-radius:2px;background:${getGradeColor(grade)};transition:width 0.8s ease"></div>
          </div>
          <p style="font-size:12px;color:${getGradeColor(grade)};margin-top:4px;font-weight:500">${getGradeLabel(grade)}</p>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:2px">
        ${recs.map(r => `<div class="audit-rec">${r}</div>`).join('')}
      </div>
    `;
    container.appendChild(card);
  });

  loadingEl!.style.display = 'none';
  resultsEl!.style.display = 'block';
  inputSection!.style.opacity = '1';
  inputSection!.style.pointerEvents = 'auto';
  btn.textContent = 'Re-run Audit';
  btn.disabled = false;

  resultsEl!.scrollIntoView({ behavior: 'smooth', block: 'start' });
};
</script>
