---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Divider from '../../components/Divider.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="SEO ROI Calculator NZ | Calculate SEO Return on Investment | Byte Digital"
  description="Calculate the potential ROI from SEO investment. Free ROI calculator for Christchurch businesses. See projected revenue, payback period, and annual returns."
>
  <PageHero
    label="Free Tool"
    title="SEO ROI<br /><span class='gradient-text'>Calculator</span>"
    subtitle="See the potential return on your SEO investment. Data-driven projections for your business."
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Tools', href: '/tools' },
      { label: 'SEO ROI Calculator' },
    ]}
  />

  <section class="section dot-pattern" style="padding-top:0">
    <div class="container">
      <div class="dm-header" style="max-width:700px;margin:0 auto">
        <div style="display:flex;flex-direction:column;gap:28px">
          
          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">Current monthly website traffic</label>
            <div style="position:relative">
              <input
                type="number"
                id="seo-traffic"
                value="1000"
                min="0"
                oninput="calculateROI()"
                style="width:100%;padding:14px 18px;padding-right:50px;border-radius:12px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);color:#fff;font-family:'Space Grotesk',sans-serif;font-size:15px;outline:none;transition:border-color 0.3s"
                onfocus="this.style.borderColor='var(--secondary)'"
                onblur="this.style.borderColor='rgba(255,255,255,0.1)'"
              />
              <span style="position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--text-muted)">visitors</span>
            </div>
          </div>

          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">Current conversion rate</label>
            <div style="position:relative">
              <input
                type="number"
                id="seo-conversion"
                value="2"
                min="0"
                max="100"
                step="0.1"
                oninput="calculateROI()"
                style="width:100%;padding:14px 18px;padding-right:30px;border-radius:12px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);color:#fff;font-family:'Space Grotesk',sans-serif;font-size:15px;outline:none;transition:border-color 0.3s"
                onfocus="this.style.borderColor='var(--secondary)'"
                onblur="this.style.borderColor='rgba(255,255,255,0.1)'"
              />
              <span style="position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--text-muted)">%</span>
            </div>
          </div>

          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">Average customer value</label>
            <div style="position:relative">
              <input
                type="number"
                id="seo-customer-value"
                value="200"
                min="0"
                oninput="calculateROI()"
                style="width:100%;padding:14px 18px;padding-right:30px;border-radius:12px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);color:#fff;font-family:'Space Grotesk',sans-serif;font-size:15px;outline:none;transition:border-color 0.3s"
                onfocus="this.style.borderColor='var(--secondary)'"
                onblur="this.style.borderColor='rgba(255,255,255,0.1)'"
              />
              <span style="position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--text-muted)">NZD</span>
            </div>
          </div>

          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">Monthly SEO investment</label>
            <div style="position:relative">
              <input
                type="number"
                id="seo-investment"
                value="1500"
                min="0"
                oninput="calculateROI()"
                style="width:100%;padding:14px 18px;padding-right:30px;border-radius:12px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);color:#fff;font-family:'Space Grotesk',sans-serif;font-size:15px;outline:none;transition:border-color 0.3s"
                onfocus="this.style.borderColor='var(--secondary)'"
                onblur="this.style.borderColor='rgba(255,255,255,0.1)'"
              />
              <span style="position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--text-muted)">NZD</span>
            </div>
          </div>

          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">Expected monthly traffic increase</label>
            <input type="range" id="seo-traffic-increase" min="10" max="300" value="100" style="width:100%;accent-color:var(--secondary)" oninput="updateTrafficDisplay();calculateROI()" />
            <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text-muted);margin-top:4px">
              <span>10%</span>
              <span id="traffic-increase-display" style="color:var(--secondary);font-weight:600">100%</span>
              <span>300%</span>
            </div>
          </div>

          <div id="roi-results">
            <div style="padding:28px;border-radius:24px;background:linear-gradient(135deg,rgba(139,120,230,0.08),rgba(94,234,212,0.08));border:1px solid rgba(94,234,212,0.15);margin-bottom:16px">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
                <div>
                  <p style="font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:6px">Current Monthly Revenue</p>
                  <p id="roi-current-rev" style="font-size:28px;font-weight:700;color:#fff">$4,000</p>
                </div>
                <div>
                  <p style="font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:6px">Projected Monthly Revenue</p>
                  <p id="roi-projected-rev" style="font-size:28px;font-weight:700;color:#fff">$8,000</p>
                </div>
              </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:28px">
              <div class="roi-stat-card">
                <p style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px">Monthly Increase</p>
                <p id="roi-monthly-increase" style="font-size:24px;font-weight:700;color:var(--secondary)">$4,000</p>
              </div>
              <div class="roi-stat-card">
                <p style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px">Annual ROI</p>
                <p id="roi-annual" style="font-size:24px;font-weight:700;color:var(--primary)">$48,000</p>
              </div>
              <div class="roi-stat-card">
                <p style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px">ROI %</p>
                <p id="roi-percentage" style="font-size:24px;font-weight:700;color:#22c55e">167%</p>
              </div>
            </div>

            <div style="padding:24px;border-radius:20px;background:rgba(19,19,26,0.75);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.08);margin-bottom:24px">
              <div style="display:flex;align-items:center;justify-content:space-between">
                <div>
                  <p style="font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:4px">Payback Period</p>
                  <p style="font-size:14px;color:var(--text-secondary)">Time to recoup your SEO investment</p>
                </div>
                <div style="text-align:right">
                  <p id="roi-payback" style="font-size:32px;font-weight:700;color:#fff;line-height:1">1</p>
                  <p style="font-size:13px;color:var(--text-muted)">months</p>
                </div>
              </div>
            </div>

            <div style="text-align:center;padding:28px;border-radius:24px;background:rgba(19,19,26,0.75);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.08)">
              <h3 style="font-size:20px;font-weight:700;color:#fff;margin-bottom:8px">Ready to grow with SEO?</h3>
              <p style="font-size:14px;color:var(--text-muted);margin-bottom:20px">Get a custom SEO strategy tailored to your Christchurch business.</p>
              <a href="/contact" class="btn-cta" style="font-size:14px">Get a Free SEO Proposal</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Divider />
  <CTASection />
</BaseLayout>

<style>
  .roi-stat-card {
    padding: 20px;
    border-radius: 16px;
    background: rgba(19,19,26,0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.08);
    text-align: center;
  }
</style>

<script>
(window as any).updateTrafficDisplay = function() {
  const val = (document.getElementById('seo-traffic-increase') as HTMLInputElement).value;
  (document.getElementById('traffic-increase-display') as HTMLElement).textContent = val + '%';
};

(window as any).calculateROI = function() {
  const traffic = parseFloat((document.getElementById('seo-traffic') as HTMLInputElement).value) || 0;
  const conversion = parseFloat((document.getElementById('seo-conversion') as HTMLInputElement).value) || 0;
  const customerValue = parseFloat((document.getElementById('seo-customer-value') as HTMLInputElement).value) || 0;
  const investment = parseFloat((document.getElementById('seo-investment') as HTMLInputElement).value) || 0;
  const trafficIncrease = parseFloat((document.getElementById('seo-traffic-increase') as HTMLInputElement).value) || 0;

  const currentConversions = traffic * (conversion / 100);
  const currentRevenue = currentConversions * customerValue;

  const newTraffic = traffic * (1 + trafficIncrease / 100);
  const newConversions = newTraffic * (conversion / 100);
  const projectedRevenue = newConversions * customerValue;

  const monthlyIncrease = projectedRevenue - currentRevenue;
  const annualNetReturn = (monthlyIncrease * 12) - (investment * 12);
  const roiPercentage = investment > 0 ? Math.round((annualNetReturn / (investment * 12)) * 100) : 0;
  const paybackMonths = monthlyIncrease > investment ? Math.ceil(investment / monthlyIncrease) : Math.round((investment / monthlyIncrease) * 10) / 10;

  const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-NZ');

  (document.getElementById('roi-current-rev') as HTMLElement).textContent = fmt(currentRevenue);
  (document.getElementById('roi-projected-rev') as HTMLElement).textContent = fmt(projectedRevenue);
  (document.getElementById('roi-monthly-increase') as HTMLElement).textContent = fmt(monthlyIncrease);
  (document.getElementById('roi-annual') as HTMLElement).textContent = fmt(annualNetReturn);

  const roiEl = document.getElementById('roi-percentage') as HTMLElement;
  roiEl.textContent = roiPercentage + '%';
  roiEl.style.color = roiPercentage >= 0 ? '#22c55e' : '#ef4444';

  const paybackEl = document.getElementById('roi-payback') as HTMLElement;
  if (monthlyIncrease <= 0) {
    paybackEl.textContent = 'N/A';
  } else {
    paybackEl.textContent = paybackMonths % 1 === 0 ? paybackMonths.toString() : paybackMonths.toFixed(1);
  }
};

(window as any).updateTrafficDisplay();
(window as any).calculateROI();
</script>
