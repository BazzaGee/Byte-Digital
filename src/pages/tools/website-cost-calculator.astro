---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Divider from '../../components/Divider.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="Website ROI Calculator NZ | Estimate Your Website's Revenue Potential | Byte Digital"
  description="Calculate the potential return on investment from a professional website for your Christchurch business. Estimate leads, revenue, and growth from your web presence."
>
  <PageHero
    label="Free Tool"
    title="Website ROI<br /><span class='gradient-text'>Calculator</span>"
    subtitle="Estimate the revenue potential a professional website could generate for your business."
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Tools', href: '/tools/' },
      { label: 'Website ROI Calculator' },
    ]}
  />

  <section class="section dot-pattern" style="padding-top:0">
    <div class="container">
      <div class="dm-header" style="max-width:700px;margin:0 auto">
        <div style="display:flex;flex-direction:column;gap:28px" id="calculator-form">
          
          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">What does your average customer spend per transaction?</label>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px" id="customer-value">
              <button type="button" class="calc-option" data-value="low" onclick="selectOption(this,'customer-value')">
                <strong style="color:#fff;font-size:14px;display:block;margin-bottom:2px">Under $200</strong>
                <span style="color:var(--text-muted);font-size:12px">Small services, retail</span>
              </button>
              <button type="button" class="calc-option" data-value="mid" onclick="selectOption(this,'customer-value')">
                <strong style="color:#fff;font-size:14px;display:block;margin-bottom:2px">$200 – $1,000</strong>
                <span style="color:var(--text-muted);font-size:12px">Trades, professional services</span>
              </button>
              <button type="button" class="calc-option" data-value="high" onclick="selectOption(this,'customer-value')">
                <strong style="color:#fff;font-size:14px;display:block;margin-bottom:2px">$1,000 – $5,000</strong>
                <span style="color:var(--text-muted);font-size:12px">Consulting, premium services</span>
              </button>
              <button type="button" class="calc-option" data-value="premium" onclick="selectOption(this,'customer-value')">
                <strong style="color:#fff;font-size:14px;display:block;margin-bottom:2px">$5,000+</strong>
                <span style="color:var(--text-muted);font-size:12px">High-value contracts</span>
              </button>
            </div>
          </div>

          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">How many new customers do you want per month from your website?</label>
            <input type="range" id="customer-count" min="1" max="50" value="10" style="width:100%;accent-color:var(--secondary)" oninput="updateCalculation()" />
            <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text-muted);margin-top:4px">
              <span>1</span>
              <span id="customer-count-display" style="color:var(--secondary);font-weight:600">10 customers</span>
              <span>50</span>
            </div>
          </div>

          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">Your industry</label>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px" id="industry">
              <button type="button" class="calc-option" data-value="trades" onclick="selectOption(this,'industry')">
                <strong style="color:#fff;font-size:14px;display:block;margin-bottom:2px">Trades & Services</strong>
                <span style="color:var(--text-muted);font-size:12px">Plumbing, electrical, building</span>
              </button>
              <button type="button" class="calc-option" data-value="professional" onclick="selectOption(this,'industry')">
                <strong style="color:#fff;font-size:14px;display:block;margin-bottom:2px">Professional Services</strong>
                <span style="color:var(--text-muted);font-size:12px">Legal, accounting, consulting</span>
              </button>
              <button type="button" class="calc-option" data-value="retail" onclick="selectOption(this,'industry')">
                <strong style="color:#fff;font-size:14px;display:block;margin-bottom:2px">Retail & eCommerce</strong>
                <span style="color:var(--text-muted);font-size:12px">Shops, online stores</span>
              </button>
              <button type="button" class="calc-option" data-value="hospitality" onclick="selectOption(this,'industry')">
                <strong style="color:#fff;font-size:14px;display:block;margin-bottom:2px">Hospitality</strong>
                <span style="color:var(--text-muted);font-size:12px">Cafes, restaurants, bars</span>
              </button>
            </div>
          </div>

          <div>
            <label style="display:block;font-size:14px;font-weight:600;color:#fff;margin-bottom:10px">How competitive is your local market?</label>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px" id="competition">
              <button type="button" class="calc-option" data-value="low" onclick="selectOption(this,'competition')">
                <span style="color:#fff;font-size:13px;font-weight:600">Low</span>
              </button>
              <button type="button" class="calc-option" data-value="medium" onclick="selectOption(this,'competition')">
                <span style="color:#fff;font-size:13px;font-weight:600">Moderate</span>
              </button>
              <button type="button" class="calc-option" data-value="high" onclick="selectOption(this,'competition')">
                <span style="color:#fff;font-size:13px;font-weight:600">Highly Competitive</span>
              </button>
            </div>
          </div>

          <div id="calc-results" style="display:none;padding:32px;border-radius:24px;background:linear-gradient(135deg,rgba(139,120,230,0.08),rgba(94,234,212,0.08));border:1px solid rgba(94,234,212,0.15);text-align:center">
            <p style="font-size:13px;color:var(--text-muted);text-transform:uppercase;letter-spacing:2px;margin-bottom:8px">Estimated Annual Revenue Potential</p>
            <div id="calc-value" style="font-size:clamp(48px,8vw,72px);font-weight:700;background:linear-gradient(135deg,#8B78E6,#5EEAD4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:8px">$0</div>
            <p style="font-size:13px;color:var(--text-muted);margin-bottom:4px">Based on <span id="calc-customers">0</span> new customers per year</p>
            <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px">+ potential savings from reduced admin & advertising</p>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;text-align:center">
              <div style="padding:12px;border-radius:12px;background:rgba(255,255,255,0.04)">
                <div id="calc-monthly" style="font-size:20px;font-weight:700;color:#5EEAD4">$0</div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Monthly</div>
              </div>
              <div style="padding:12px;border-radius:12px;background:rgba(255,255,255,0.04)">
                <div id="calc-leads" style="font-size:20px;font-weight:700;color:#8B78E6">0</div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Leads/mo needed</div>
              </div>
              <div style="padding:12px;border-radius:12px;background:rgba(255,255,255,0.04)">
                <div id="calc-traffic" style="font-size:20px;font-weight:700;color:#fff">0</div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Visitors/mo needed</div>
              </div>
            </div>
            <a href="/contact/" class="btn-cta" style="font-size:14px">Get a Free Proposal</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Divider />
  <CTASection />
</BaseLayout>

<style>
  .calc-option {
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    color: #fff;
    font-family: 'Space Grotesk', sans-serif;
    cursor: pointer;
    transition: all 0.3s;
    text-align: left;
  }
  .calc-option:hover { border-color: rgba(139,120,230,0.3); }
  .calc-option.selected {
    border-color: var(--secondary);
    background: rgba(94,234,212,0.08);
  }
  .feature-option:hover { border-color: rgba(139,120,230,0.3) !important; }
</style>

<script>
const customerValues: Record<string, number> = {
  low: 150,
  mid: 600,
  high: 3000,
  premium: 7500,
};

const conversionRates: Record<string, number> = {
  trades: 0.04,
  professional: 0.03,
  retail: 0.025,
  hospitality: 0.035,
};

let selectedValue = '';
let selectedIndustry = '';
let selectedCompetition = '';

(window as any).selectOption = function(btn: HTMLElement, groupName: string) {
  const parent = btn.parentElement;
  parent.querySelectorAll('.calc-option').forEach((b: Element) => b.classList.remove('selected'));
  btn.classList.add('selected');
  if (groupName === 'customer-value') selectedValue = btn.getAttribute('data-value') || '';
  if (groupName === 'industry') selectedIndustry = btn.getAttribute('data-value') || '';
  if (groupName === 'competition') selectedCompetition = btn.getAttribute('data-value') || '';
  (window as any).updateCalculation();
};

(window as any).updateCalculation = function() {
  const customerCount = parseInt((document.getElementById('customer-count') as HTMLInputElement)?.value || '1');
  const display = document.getElementById('customer-count-display');
  if (display) display.textContent = customerCount + (customerCount === 1 ? ' customer' : ' customers');

  if (!selectedValue || !selectedIndustry || !selectedCompetition) {
    document.getElementById('calc-results')!.style.display = 'none';
    return;
  }

  const avgValue = customerValues[selectedValue] || 150;
  const convRate = conversionRates[selectedIndustry] || 0.03;

  const monthlyRevenue = avgValue * customerCount;
  const annualRevenue = monthlyRevenue * 12;
  const leadsNeeded = Math.ceil(customerCount / convRate);
  const trafficNeeded = Math.ceil(leadsNeeded * 3);

  document.getElementById('calc-results')!.style.display = 'block';
  document.getElementById('calc-value')!.textContent = '$' + annualRevenue.toLocaleString('en-NZ');
  document.getElementById('calc-monthly')!.textContent = '$' + monthlyRevenue.toLocaleString('en-NZ');
  document.getElementById('calc-customers')!.textContent = (customerCount * 12).toString();
  document.getElementById('calc-leads')!.textContent = leadsNeeded.toString();
  document.getElementById('calc-traffic')!.textContent = trafficNeeded.toString();
};
</script>
