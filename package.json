{
  "name": "byte-digital",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/extract-content.js && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "deploy:staging": "wrangler pages deploy dist --branch=staging",
    "deploy:production": "wrangler pages deploy dist",
    "postdeploy:staging": "node scripts/seo/indexnow-ping.mjs || true",
    "postdeploy:production": "node scripts/seo/indexnow-ping.mjs && node scripts/seo/run-python.mjs scripts/seo/gsc-sitemap-ping.py",
    "seo:ping": "node scripts/seo/indexnow-ping.mjs && node scripts/seo/run-python.mjs scripts/seo/gsc-sitemap-ping.py",
    "seo:report": "node scripts/seo/run-python.mjs scripts/seo/seo-report.py",
    "seo:keyevents": "node scripts/seo/run-python.mjs scripts/seo/ga4-keyevents.py"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource/space-grotesk": "^5.2.10",
    "@langchain/openai": "^1.4.6",
    "@langchain/textsplitters": "^1.0.1",
    "@pinecone-database/pinecone": "^7.2.0",
    "astro": "^6.1.9"
  },
  "devDependencies": {
    "wrangler": "^4.94.0"
  }
}
